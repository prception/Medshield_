<main id="main">

  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">About MedShield</p>
      <h1 class="page-hero__title">Championing seafarers' care, securing employers' trust</h1>
      <p class="page-hero__lede">
        An independent specialist medical team sits above a verified treatment
        network - standardising clinical decisions, provider selection,
        treatment monitoring and cost control for seafarers, across India,
        Singapore and the UAE.
      </p>
      <a class="btn btn--onDeep" href="contact.html" style="margin-top: var(--s-6);">Request a proposal</a>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="inner-section" aria-labelledby="vm-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">Vision &amp; mission</p>
        <h2 class="section-title" id="vm-h">What we're building toward</h2>
      </header>
      <div class="vm-grid">
        <div class="vm-card">
          <p class="vm-card__label">Vision</p>
          <p>
            To raise the standard of maritime healthcare with seamless
            solutions that safeguard seafarers' well-being while addressing
            the operational priorities of maritime employers - empowering the
            global maritime community with specialised expertise and an
            unwavering commitment to care.
          </p>
        </div>
        <div class="vm-card">
          <p class="vm-card__label">Mission</p>
          <p>
            To set a new benchmark for maritime healthcare by integrating
            technology with human-centred care - proactive health management,
            rapid claims resolution and effective cost control, so health
            risks are minimised and operational disruption is avoided.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Two-layer model -->
  <section class="inner-section inner-section--sunken" aria-labelledby="layers-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">How we work</p>
        <h2 class="section-title" id="layers-h">An independent medical team above a verified network</h2>
        <p class="inner-section__lede">
          India's first multidisciplinary maritime healthcare company. The
          pitch is expert medical decision-making plus an independent network
          plus coordination - not simply a large network, which is a
          commodity on its own.
        </p>
      </header>
      <div class="layers">
        <div class="layer-card">
          <p class="layer-card__num">Layer 1</p>
          <h3>A verified treatment network across India</h3>
          <p>Accredited providers, pre-negotiated rates, checked before they are used - 1,800+ hospitals, clinics, labs and pharmacies.</p>
        </div>
        <div class="layer-card">
          <p class="layer-card__num">Layer 2</p>
          <h3>An independent central medical team</h3>
          <p>130+ specialists and super-specialists who decide what should actually happen: assessing treatment proposals, selecting the provider, setting the protocol and monitoring the case.</p>
        </div>
      </div>
      <p class="confirm-note">[CONFIRM] Network scale: client sources give both "1,800+ partner hospitals" and, separately, "17-45+ locations across India" depending on document - figure to be reconciled with the client before publishing a single number.</p>
    </div>
  </section>

  <!-- Founders -->
  <section class="inner-section" aria-labelledby="founders-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">Leadership</p>
        <h2 class="section-title" id="founders-h">Founders</h2>
      </header>
      <div class="founders">
        <div class="founder-card">
          <div class="founder-card__portrait">
            <img src="assets/people/desikan.jpg" alt="Dr. Desikan Setlur, Founder and CEO of MedShield." width="560" height="700" loading="lazy" decoding="async">
          </div>
          <p class="founder-card__name">Dr. Desikan Setlur</p>
          <p class="founder-card__role">Founder &amp; CEO</p>
          <p class="founder-card__body">
            A Ph.D. in Maritime Occupational Health &amp; Safety from Swansea
            University, U.K., with over two decades in maritime healthcare.
            He has led medical evacuations and port operations across India
            and Asia, and built long-standing relationships with global
            insurers, TPAs and maritime agents. Under his leadership,
            MedShield bridges healthcare needs and operational efficiency
            with tech-driven, seafarer-first solutions.
          </p>
        </div>
        <div class="founder-card">
          <div class="founder-card__portrait">
            <img src="assets/people/princi.jpg" alt="Dr. Princi Singh, Co-Founder and COO of MedShield." width="560" height="700" loading="lazy" decoding="async">
          </div>
          <p class="founder-card__name">Dr. Princi Singh</p>
          <p class="founder-card__role">Co-Founder &amp; COO</p>
          <p class="founder-card__body">
            A dental surgeon (BDS) with specialised certification in Hospital
            Management and over a decade in healthcare operations. She
            oversees MedShield's day-to-day healthcare delivery - treatment
            plan coordination, hospital partnerships and the telemedicine
            programme - working alongside Dr. Setlur on strategic direction
            and MedShield's global expansion.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Independent medical team -->
  <section class="inner-section inner-section--sunken" aria-labelledby="sme-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">The independent medical team</p>
        <h2 class="section-title" id="sme-h">130+ specialists across nine disciplines</h2>
        <p class="inner-section__lede">
          This panel is the product, not a credentials list. Before a
          treatment plan is approved, an independent team reviews it -
          assessing the proposal on clinical merit, selecting the provider,
          setting the protocol and monitoring the case to discharge. They are
          not attached to the hospital treating your seafarer, and have
          nothing to gain from the choice they make.
        </p>
      </header>
      <div class="core-team">
        <div class="core-team__item"><h4>Maritime medical specialists</h4><p>Specialised care for seafarers' physical and mental health.</p></div>
        <div class="core-team__item"><h4>Telemedicine team</h4><p>Remote consultations, globally.</p></div>
        <div class="core-team__item"><h4>Healthcare &amp; claims</h4><p>Managing medical, disability and life claims.</p></div>
        <div class="core-team__item"><h4>Clinical findings correlation</h4><p>Correlating data for accurate decisions.</p></div>
        <div class="core-team__item"><h4>Treatment plan analysis</h4><p>Reviewing plans for effectiveness and cost.</p></div>
        <div class="core-team__item"><h4>Global pharmacology</h4><p>Ensuring global medication compliance.</p></div>
        <div class="core-team__item"><h4>Occupational preventive health</h4><p>Designing preventive care programmes.</p></div>
        <div class="core-team__item"><h4>Medico-legal &amp; arbitration</h4><p>Resolving claims disputes fairly.</p></div>
        <div class="core-team__item"><h4>Pharmacologists</h4><p>Safe, compliant medication use across the fleet.</p></div>
        <div class="core-team__item"><h4>Case Management Specialists</h4><p>Coordinating every stakeholder, keeping operations on track.</p></div>
        <div class="core-team__item"><h4>Advisors</h4><p>Specialising in complex maritime claims and compliant resolutions.</p></div>
        <div class="core-team__item"><h4>IT team - 24/7/365</h4><p>Our tech enablement team keeps MedShield's digital infrastructure - dashboards, case records, telemedicine - running at every hour, every day of the year.</p></div>
      </div>
    </div>
  </section>

  <!-- Individual bios -->
  <section class="inner-section" aria-labelledby="team-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">The panel</p>
        <h2 class="section-title" id="team-h">Who reviews your case</h2>
        <p class="inner-section__lede">
          A sample of the specialists on our clinical and legal panel.
        </p>
      </header>
      <div class="team-grid">

        <article class="team-card">
          <div class="team-card__avatar">JR</div>
          <p class="team-card__name">Dr. M. Jaya Rajah</p>
          <p class="team-card__title">Senior Consultant &amp; Head of Cardiology</p>
          <p class="team-card__body">Over three decades in Internal Medicine and Cardiology. MD from Stanley Medical College, DM Cardiology from Madras Medical College. 17 years heading Cardiology at Sooriya Hospital; 12 years as Professor of Cardiology at Sri Ramachandra Medical College.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">PS</div>
          <p class="team-card__name">Dr. P. Satish</p>
          <p class="team-card__title">Senior Consultant Gastro Surgeon</p>
          <p class="team-card__body">Specialises in hepatobiliary, pancreatic, gastro-esophageal, colorectal and abdominal cancer surgeries. Published research in gastroenterology journals and a regular contributor to global conferences.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">SS</div>
          <p class="team-card__name">Dr. S.T. Sivaraman</p>
          <p class="team-card__title">Consultant Orthopedic Surgeon &amp; Emergency/Trauma Specialist</p>
          <p class="team-card__body">Over two decades of experience. Gold Medalist, AIIMS New Delhi. Fellowship in Traumatology and Reconstructive Surgery, Katharinen Hospital, Stuttgart. Currently at Sooriya Hospital, Chennai.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">SR</div>
          <p class="team-card__name">Dr. Srinivas Rajagopala</p>
          <p class="team-card__title">Director, Pulmonology &amp; Sleep Medicine</p>
          <p class="team-card__body">Over 20 years' experience. Trained at PGIMER Chandigarh and JIPMER Puducherry, with further training in Adelaide, McMaster and Toronto. Specialises in lung transplantation and advanced lung disease.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">SP</div>
          <p class="team-card__name">Dr. Sudheer Pargewar</p>
          <p class="team-card__title">Senior Consultant - Interventional Radiology</p>
          <p class="team-card__body">18 years' experience, trained at the Institute of Liver and Biliary Sciences (New Delhi) and Juntendo University (Tokyo). Specialises in minimally invasive hepatobiliary interventions.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">TG</div>
          <p class="team-card__name">Dr. Tarun Grover</p>
          <p class="team-card__title">Director - Peripheral Vascular &amp; Endovascular Sciences</p>
          <p class="team-card__body">Over 25 years' experience. Fellow of the American College of Surgeons. Trained at St. Mary's Hospital, London and the Regional Vascular Centre, Cologne.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">VG</div>
          <p class="team-card__name">Dr. Vijayaraghavan G.</p>
          <p class="team-card__title">Senior Consultant - Spine Surgery</p>
          <p class="team-card__body">Over a decade in minimally invasive spine surgery. Graduate of Madras Medical College and AIIMS New Delhi, with fellowships in Singapore, Korea/Japan/China and UCSF.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">VJ</div>
          <p class="team-card__name">Dr. Vinod S. Joshi</p>
          <p class="team-card__title">Section Head - Urology</p>
          <p class="team-card__body">Trained at Nair Hospital in endourology, urodynamics and andrology. Skilled in TURP, PCNL and URS - independently achieving a 65% total stone clearance rate in PCNL.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">PS</div>
          <p class="team-card__name">Dr. Princi Singh</p>
          <p class="team-card__title">Co-Founder &amp; COO</p>
          <p class="team-card__body">See founders above.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">VA</div>
          <p class="team-card__name">K. Vijay Anand</p>
          <p class="team-card__title">Legal &amp; Compliance Advisor</p>
          <p class="team-card__body">M.A., B.L., over 25 years in corporate legal, risk mitigation and compliance advisory - advising on legal frameworks, strategic risk mitigation and representation in disputes.</p>
        </article>

        <article class="team-card">
          <div class="team-card__avatar">SK</div>
          <p class="team-card__name">R.V. Senthil Kumar</p>
          <p class="team-card__title">Advocate - Arbitration &amp; Labour Law</p>
          <p class="team-card__body">B.A., B.L., registered advocate with over 24 years across civil, criminal, insurance and company law - particular depth in labour law, arbitration and MLC/ILO-aligned employee dispute resolution.</p>
        </article>

      </div>

      <!-- What we are not -->
      <div class="notus-block">
        <h3>What we are not</h3>
        <p>
          Not a hospital, a clinic, a pharmacy or an insurer. Not a cruise
          booking company, a medical tourism agency or a crew recruiter. We
          are the operations partner that manages the case between all of
          them - with no commercial interest in where your seafarer is
          treated.
        </p>
      </div>
    </div>
  </section>

  <!-- Offices -->
  <section class="inner-section inner-section--sunken" aria-labelledby="offices-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">Where we operate</p>
        <h2 class="section-title" id="offices-h">Offices</h2>
      </header>
      <div class="offices-grid">
        <div class="office-card">
          <p class="office-card__tag">Headquarters</p>
          <p class="office-card__city">Chennai, India</p>
          <p class="office-card__meta">
            Medshield Maritime Healthcare India Private Limited<br>
            Tel: <a href="tel:+914435949210">+91 44 3594 9210</a><br>
            Mobile: <a href="tel:+919840603936">+91 98406 03936</a><br>
            Email: <a href="mailto:info@medshield.in">info@medshield.in</a>
          </p>
        </div>
        <div class="office-card">
          <p class="office-card__tag">Regional office</p>
          <p class="office-card__city">Singapore</p>
          <p class="office-card__meta">Supporting maritime clients across Southeast Asia.</p>
        </div>
        <div class="office-card">
          <p class="office-card__tag">Regional office</p>
          <p class="office-card__city">Dubai, UAE</p>
          <p class="office-card__meta">Supporting maritime clients across the Middle East.</p>
        </div>
      </div>
      <p class="confirm-note">[CONFIRM] Contact details above are drawn from client-supplied collateral (Company Profile, Maritime Healthcare Solutions deck) - confirm these are the correct, monitored 24/7 routes before publishing.</p>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="simple-cta">
    <div class="shell">
      <h2>Let's take the next case</h2>
      <p>Send us your fleet profile and we'll come back with a proposal.</p>
      <a class="btn btn--onDeep" href="contact.html">Request a proposal</a>
    </div>
  </section>

</main>

