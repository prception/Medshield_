/* ==========================================================================
   INNER PAGES — About, Services, Case Studies, Contact
   ==========================================================================
   Additive stylesheet. Loaded AFTER style.css on every inner page, so it
   inherits the full token system (colour, type scale, spacing, .shell,
   .btn, .eyebrow, .section-title, header/footer/nav, form, confirm markers)
   without redeclaring any of it.

   Deliberately NOT GSAP-choreographed like the homepage sections — these are
   plain static layouts using the same tokens. No js/vendor dependency, no
   scroll-pinning. "Basic rich styling," not the homepage's bespoke motion
   system, which does not belong duplicated four more times. */

/* --- Page-level scaffolding ---------------------------------------------- */

.page-hero {
  padding-block: calc(5.25rem + var(--s-8)) var(--s-8);
  background: var(--surface-deep);
  color: var(--text-on-deep);
}
.page-hero .eyebrow { color: var(--accent-2-on-deep); }
.page-hero__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--t-hero);
  line-height: 1.05;
  letter-spacing: -0.01em;
  max-width: 18ch;
  margin-block: var(--s-4) var(--s-5);
}
.page-hero__lede {
  font-size: var(--t-lede);
  color: var(--text-on-deep-secondary);
  max-width: 62ch;
  line-height: 1.5;
}

.inner-section {
  padding-block: var(--s-9);
  border-bottom: 1px solid var(--border);
}
.inner-section:last-of-type { border-bottom: none; }
.inner-section--sunken { background: var(--surface-sunken); }
.inner-section--deep {
  background: var(--surface-deep);
  color: var(--text-on-deep);
  border-bottom: none;
}
.inner-section--deep .eyebrow { color: var(--accent-2-on-deep); }
.inner-section--deep .section-title { color: var(--text-on-deep); }

.inner-section__head { max-width: 60ch; margin-bottom: var(--s-7); }
.inner-section__head .section-title { margin-block: var(--s-3) var(--s-4); }
.inner-section__lede { font-size: var(--t-lede); color: var(--text-secondary); line-height: 1.55; }
.inner-section--deep .inner-section__lede { color: var(--text-on-deep-secondary); }

/* --- Confirm marker (matches homepage .confirm) --------------------------- */
.confirm-note {
  display: inline-block;
  margin-top: var(--s-3);
  padding: var(--s-2) var(--s-4);
  background: var(--warning-bg);
  color: var(--warning);
  border-radius: 6px;
  font-size: var(--t-small);
  line-height: 1.5;
}
.inner-section--deep .confirm-note { background: rgba(232, 163, 61, 0.14); color: var(--warning-on-deep); }

/* --- Vision / Mission ------------------------------------------------------ */
.vm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-7);
}
.vm-card { }
.vm-card__label {
  font-family: var(--font-editorial);
  font-size: var(--t-eyebrow);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-2-ink);
  margin-bottom: var(--s-3);
}
.vm-card p { font-size: var(--t-body); line-height: 1.65; color: var(--text-secondary); }

/* --- Two-layer model -------------------------------------------------------- */
.layers {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-6);
  margin-top: var(--s-6);
}
.layer-card {
  padding: var(--s-6);
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.layer-card__num {
  font-family: var(--font-editorial);
  font-size: var(--t-eyebrow);
  color: var(--accent-2-ink);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: var(--s-3);
}
.layer-card h3 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-3); }
.layer-card p { color: var(--text-secondary); line-height: 1.6; }

/* --- Founders --------------------------------------------------------------- */
.founders {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-7);
  margin-top: var(--s-6);
}
.founder-card { display: flex; flex-direction: column; gap: var(--s-4); }
.founder-card__portrait {
  width: 100%;
  aspect-ratio: 4 / 5;
  border-radius: 12px;
  overflow: hidden;
  background: var(--surface-sunken);
}
.founder-card__portrait img { width: 100%; height: 100%; object-fit: cover; }
.founder-card__name { font-family: var(--font-display); font-size: var(--t-h3); font-weight: 700; }
.founder-card__role { color: var(--accent-2-ink); font-size: var(--t-small); font-weight: 600; margin-block: var(--s-1) var(--s-3); }
.founder-card__body { color: var(--text-secondary); line-height: 1.65; }

/* --- Team grid (doctors / SMEs, no photography available) ------------------ */
.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.team-card {
  padding: var(--s-5);
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: 10px;
}
.team-card__avatar {
  width: 3rem; height: 3rem;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
  margin-bottom: var(--s-4);
}
.team-card__name { font-family: var(--font-display); font-weight: 700; font-size: var(--t-h3); line-height: 1.25; }
.team-card__title { color: var(--accent-2-ink); font-size: var(--t-small); font-weight: 600; margin-block: var(--s-1) var(--s-3); }
.team-card__body { color: var(--text-secondary); font-size: var(--t-small); line-height: 1.6; }

/* --- Core team category strip ---------------------------------------------- */
.core-team {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--s-4);
  margin-top: var(--s-6);
}
.core-team__item {
  padding: var(--s-4);
  border: 1px solid var(--border-on-deep);
  border-radius: 10px;
}
.core-team__item h4 { font-family: var(--font-display); font-size: var(--t-small); font-weight: 700; margin-bottom: var(--s-2); }
.core-team__item p { font-size: var(--t-micro); color: var(--text-on-deep-muted); line-height: 1.5; }

/* --- Not-us block ------------------------------------------------------------ */
.notus-block {
  margin-top: var(--s-7);
  padding: var(--s-6);
  border-left: 3px solid var(--accent-2);
  background: var(--surface-sunken);
  border-radius: 0 10px 10px 0;
}
.notus-block h3 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-3); }
.notus-block p { color: var(--text-secondary); line-height: 1.65; }

/* --- Offices ------------------------------------------------------------------ */
.offices-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.office-card { padding: var(--s-5); background: var(--surface-raised); border: 1px solid var(--border); border-radius: 10px; }
.office-card__tag { font-size: var(--t-eyebrow); color: var(--accent-2-ink); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--s-2); }
.office-card__city { font-family: var(--font-display); font-size: var(--t-h3); font-weight: 700; margin-bottom: var(--s-3); }
.office-card__meta { color: var(--text-secondary); font-size: var(--t-small); line-height: 1.7; }
.office-card__meta a { color: var(--link); }

/* --- Services (inner page detail) --------------------------------------------- */
.svc-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-8);
  align-items: start;
  padding-block: var(--s-7);
  border-top: 1px solid var(--border);
}
.svc-detail:first-of-type { border-top: none; }
.svc-detail__num { font-family: var(--font-editorial); font-size: var(--t-eyebrow); color: var(--accent-2-ink); letter-spacing: 0.06em; margin-bottom: var(--s-3); }
.svc-detail h3 { font-family: var(--font-display); font-size: var(--t-h2); line-height: 1.1; margin-bottom: var(--s-3); }
.svc-detail__get { font-size: var(--t-lede); color: var(--text-primary); font-weight: 600; margin-bottom: var(--s-4); }
.svc-detail__body { color: var(--text-secondary); line-height: 1.65; margin-bottom: var(--s-5); }
.svc-pillars { display: grid; gap: var(--s-4); }
.svc-pillar { padding: var(--s-4); background: var(--surface-sunken); border-radius: 8px; }
.svc-pillar h4 { font-family: var(--font-display); font-size: var(--t-small); font-weight: 700; margin-bottom: var(--s-1); }
.svc-pillar p { font-size: var(--t-small); color: var(--text-secondary); line-height: 1.55; }
.svc-detail__cta { display: inline-flex; align-items: center; gap: var(--s-2); margin-top: var(--s-5); font-weight: 600; color: var(--link); }

/* --- Fraud-prevention grid ------------------------------------------------------ */
.safeguards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.safeguard-card { padding: var(--s-5); background: var(--surface-raised); border: 1px solid var(--border); border-radius: 10px; }
.safeguard-card h4 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-3); }
.safeguard-card p { color: var(--text-secondary); font-size: var(--t-small); line-height: 1.6; }

/* --- Process steps (compact reuse for Services page) ---------------------------- */
.process-compact { counter-reset: step; margin-top: var(--s-6); display: grid; gap: var(--s-4); }
.process-compact__item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--s-5);
  align-items: baseline;
  padding-block: var(--s-4);
  border-top: 1px solid var(--border);
}
.process-compact__item:first-child { border-top: none; }
.process-compact__num {
  font-family: var(--font-editorial);
  font-size: var(--t-h3);
  color: var(--accent-2-ink);
  min-width: 2.5ch;
}
.process-compact__item h4 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-2); }
.process-compact__item p { color: var(--text-secondary); line-height: 1.6; }

/* --- Roadmap ------------------------------------------------------------------- */
.roadmap-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.roadmap-card { padding: var(--s-5); border: 1px dashed var(--border-strong); border-radius: 10px; }
.roadmap-card__tag {
  display: inline-block;
  font-size: var(--t-micro);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--warning);
  background: var(--warning-bg);
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  margin-bottom: var(--s-3);
  font-weight: 700;
}
.roadmap-card h4 { font-family: var(--font-display); font-size: var(--t-small); font-weight: 700; margin-bottom: var(--s-2); }
.roadmap-card p { font-size: var(--t-small); color: var(--text-secondary); line-height: 1.55; }

/* --- Case study (full page version) --------------------------------------------- */
.case-full {
  padding-block: var(--s-8);
  border-top: 1px solid var(--border);
}
.case-full:first-of-type { border-top: none; }
.case-full__eyebrow { color: var(--accent-2-ink); font-size: var(--t-eyebrow); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--s-3); }
.case-full h3 { font-family: var(--font-display); font-size: var(--t-h2); line-height: 1.1; max-width: 26ch; margin-bottom: var(--s-6); }
.case-full__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); }
.case-full__block dt { font-family: var(--font-display); font-weight: 700; font-size: var(--t-small); text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: var(--s-2); }
.case-full__block dd { color: var(--text-secondary); line-height: 1.65; margin-bottom: var(--s-5); }
.case-full__results { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-4); }
.case-full__stat { padding: var(--s-4); background: var(--surface-sunken); border-radius: 8px; }
.case-full__stat-num { font-family: "Fraunces", var(--font-display); font-size: var(--t-fig); color: var(--accent-2-ink); font-variant-numeric: tabular-nums; line-height: 1; }
.case-full__stat-label { font-size: var(--t-micro); color: var(--text-muted); margin-top: var(--s-2); text-transform: uppercase; letter-spacing: 0.04em; }

/* --- Impact stat strip ------------------------------------------------------------ */
.impact-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-6);
  margin-top: var(--s-7);
  padding-top: var(--s-7);
  border-top: 1px solid var(--border-on-deep);
}
.impact-strip__item { }
.impact-strip__num { font-family: "Fraunces", var(--font-display); font-size: var(--t-fig); color: var(--accent-2-on-deep); font-variant-numeric: tabular-nums; line-height: 1; }
.impact-strip__label { font-size: var(--t-small); color: var(--text-on-deep-secondary); margin-top: var(--s-2); line-height: 1.4; }

/* --- Contact page offices strip ---------------------------------------------------- */
.contact-offices {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-7);
}

/* --- Closing CTA (shared simple band) ------------------------------------------------ */
.simple-cta {
  padding-block: var(--s-8);
  background: var(--surface-deep);
  color: var(--text-on-deep);
  text-align: center;
}
.simple-cta h2 { font-family: var(--font-display); font-size: var(--t-h2); margin-bottom: var(--s-4); }
.simple-cta p { color: var(--text-on-deep-secondary); max-width: 50ch; margin-inline: auto; margin-bottom: var(--s-6); }

/* --- Responsive ------------------------------------------------------------------------ */
@media (max-width: 960px) {
  .vm-grid, .layers, .founders, .svc-detail, .case-full__grid { grid-template-columns: 1fr; }
  .team-grid { grid-template-columns: repeat(2, 1fr); }
  .core-team { grid-template-columns: repeat(3, 1fr); }
  .offices-grid, .safeguards-grid, .roadmap-grid, .impact-strip, .contact-offices { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 620px) {
  .team-grid, .core-team, .offices-grid, .safeguards-grid, .roadmap-grid, .impact-strip, .contact-offices,
  .case-full__results {
    grid-template-columns: 1fr;
  }
  .page-hero { padding-block: calc(5.25rem + var(--s-6)) var(--s-6); }
  .inner-section { padding-block: var(--s-7); }
}
