/* ==========================================================================
   INNER PAGES — About, Services, Case Studies, Contact
   ==========================================================================
   Additive stylesheet. Loaded AFTER style.css on every inner page, so it
   inherits the full token system (colour, type scale, spacing, .shell,
   .btn, .eyebrow, .section-title, header/footer/nav, form, confirm markers)
   without redeclaring any of it.

   Deliberately NOT GSAP-choreographed like the homepage sections — these are
   plain static layouts using the same tokens. No js/vendor dependency, no
   scroll-pinning. "Basic rich styling," not the homepage's bespoke motion
   system, which does not belong duplicated four more times. */

/* --- Page-level scaffolding ---------------------------------------------- */

.page-hero {
  padding-block: calc(5.25rem + var(--s-8)) var(--s-8);
  background: var(--surface-deep);
  color: var(--text-on-deep);
}
.page-hero .eyebrow { color: var(--accent-2-on-deep); }
.page-hero__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--t-hero);
  line-height: 1.05;
  letter-spacing: -0.01em;
  max-width: 18ch;
  margin-block: var(--s-4) var(--s-5);
}
.page-hero__lede {
  font-size: var(--t-lede);
  color: var(--text-on-deep-secondary);
  max-width: 62ch;
  line-height: 1.5;
}

.inner-section {
  padding-block: var(--s-9);
  border-bottom: 1px solid var(--border);
}
.inner-section:last-of-type { border-bottom: none; }
.inner-section--sunken { background: var(--surface-sunken); }
.inner-section--deep {
  background: var(--surface-deep);
  color: var(--text-on-deep);
  border-bottom: none;
}
.inner-section--deep .eyebrow { color: var(--accent-2-on-deep); }
.inner-section--deep .section-title { color: var(--text-on-deep); }

.inner-section__head { max-width: 60ch; margin-bottom: var(--s-7); }
.inner-section__head .section-title { margin-block: var(--s-3) var(--s-4); }
.inner-section__lede { font-size: var(--t-lede); color: var(--text-secondary); line-height: 1.55; }
.inner-section--deep .inner-section__lede { color: var(--text-on-deep-secondary); }

/* --- Confirm marker (matches homepage .confirm) --------------------------- */
.confirm-note {
  display: inline-block;
  margin-top: var(--s-3);
  padding: var(--s-2) var(--s-4);
  background: var(--warning-bg);
  color: var(--warning);
  border-radius: 6px;
  font-size: var(--t-small);
  line-height: 1.5;
}
.inner-section--deep .confirm-note { background: rgba(232, 163, 61, 0.14); color: var(--warning-on-deep); }

/* --- Vision / Mission ------------------------------------------------------ */
.vm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-7);
}
.vm-card { }
.vm-card__label {
  font-family: var(--font-editorial);
  font-size: var(--t-eyebrow);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-2-ink);
  margin-bottom: var(--s-3);
}
.vm-card p { font-size: var(--t-body); line-height: 1.65; color: var(--text-secondary); }

/* --- Two-layer model -------------------------------------------------------- */
.layers {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-6);
  margin-top: var(--s-6);
}
.layer-card {
  padding: var(--s-6);
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.layer-card__num {
  font-family: var(--font-editorial);
  font-size: var(--t-eyebrow);
  color: var(--accent-2-ink);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: var(--s-3);
}
.layer-card h3 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-3); }
.layer-card p { color: var(--text-secondary); line-height: 1.6; }

/* --- Founders --------------------------------------------------------------- */
.founders {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-7);
  margin-top: var(--s-6);
}
.founder-card { display: flex; flex-direction: column; gap: var(--s-4); }
.founder-card__portrait {
  width: 100%;
  aspect-ratio: 4 / 5;
  border-radius: 12px;
  overflow: hidden;
  background: var(--surface-sunken);
}
.founder-card__portrait img { width: 100%; height: 100%; object-fit: cover; }
.founder-card__name { font-family: var(--font-display); font-size: var(--t-h3); font-weight: 700; }
.founder-card__role { color: var(--accent-2-ink); font-size: var(--t-small); font-weight: 600; margin-block: var(--s-1) var(--s-3); }
.founder-card__body { color: var(--text-secondary); line-height: 1.65; }

/* --- Team grid (doctors / SMEs, no photography available) ------------------ */
.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.team-card {
  padding: var(--s-5);
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: 10px;
}
.team-card__avatar {
  width: 3rem; height: 3rem;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
  margin-bottom: var(--s-4);
}
.team-card__name { font-family: var(--font-display); font-weight: 700; font-size: var(--t-h3); line-height: 1.25; }
.team-card__title { color: var(--accent-2-ink); font-size: var(--t-small); font-weight: 600; margin-block: var(--s-1) var(--s-3); }
.team-card__body { color: var(--text-secondary); font-size: var(--t-small); line-height: 1.6; }

/* --- Core team category strip ---------------------------------------------- */
.core-team {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--s-4);
  margin-top: var(--s-6);
}
.core-team__item {
  padding: var(--s-4);
  border: 1px solid var(--border-on-deep);
  border-radius: 10px;
}
.core-team__item h4 { font-family: var(--font-display); font-size: var(--t-small); font-weight: 700; margin-bottom: var(--s-2); }
.core-team__item p { font-size: var(--t-micro); color: var(--text-on-deep-muted); line-height: 1.5; }

/* --- Not-us block ------------------------------------------------------------ */
.notus-block {
  margin-top: var(--s-7);
  padding: var(--s-6);
  border-left: 3px solid var(--accent-2);
  background: var(--surface-sunken);
  border-radius: 0 10px 10px 0;
}
.notus-block h3 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-3); }
.notus-block p { color: var(--text-secondary); line-height: 1.65; }

/* --- Offices ------------------------------------------------------------------ */
.offices-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.office-card { padding: var(--s-5); background: var(--surface-raised); border: 1px solid var(--border); border-radius: 10px; }
.office-card__tag { font-size: var(--t-eyebrow); color: var(--accent-2-ink); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--s-2); }
.office-card__city { font-family: var(--font-display); font-size: var(--t-h3); font-weight: 700; margin-bottom: var(--s-3); }
.office-card__meta { color: var(--text-secondary); font-size: var(--t-small); line-height: 1.7; }
.office-card__meta a { color: var(--link); }

/* --- Services (inner page detail) --------------------------------------------- */
.svc-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-8);
  align-items: start;
  padding-block: var(--s-7);
  border-top: 1px solid var(--border);
}
.svc-detail:first-of-type { border-top: none; }
.svc-detail__num { font-family: var(--font-editorial); font-size: var(--t-eyebrow); color: var(--accent-2-ink); letter-spacing: 0.06em; margin-bottom: var(--s-3); }
.svc-detail h3 { font-family: var(--font-display); font-size: var(--t-h2); line-height: 1.1; margin-bottom: var(--s-3); }
.svc-detail__get { font-size: var(--t-lede); color: var(--text-primary); font-weight: 600; margin-bottom: var(--s-4); }
.svc-detail__body { color: var(--text-secondary); line-height: 1.65; margin-bottom: var(--s-5); }
.svc-pillars { display: grid; gap: var(--s-4); }
.svc-pillar { padding: var(--s-4); background: var(--surface-sunken); border-radius: 8px; }
.svc-pillar h4 { font-family: var(--font-display); font-size: var(--t-small); font-weight: 700; margin-bottom: var(--s-1); }
.svc-pillar p { font-size: var(--t-small); color: var(--text-secondary); line-height: 1.55; }
.svc-detail__cta { display: inline-flex; align-items: center; gap: var(--s-2); margin-top: var(--s-5); font-weight: 600; color: var(--link); }

/* --- Fraud-prevention grid ------------------------------------------------------ */
.safeguards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.safeguard-card { padding: var(--s-5); background: var(--surface-raised); border: 1px solid var(--border); border-radius: 10px; }
.safeguard-card h4 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-3); }
.safeguard-card p { color: var(--text-secondary); font-size: var(--t-small); line-height: 1.6; }

/* --- Process steps (compact reuse for Services page) ---------------------------- */
.process-compact { counter-reset: step; margin-top: var(--s-6); display: grid; gap: var(--s-4); }
.process-compact__item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--s-5);
  align-items: baseline;
  padding-block: var(--s-4);
  border-top: 1px solid var(--border);
}
.process-compact__item:first-child { border-top: none; }
.process-compact__num {
  font-family: var(--font-editorial);
  font-size: var(--t-h3);
  color: var(--accent-2-ink);
  min-width: 2.5ch;
}
.process-compact__item h4 { font-family: var(--font-display); font-size: var(--t-h3); margin-bottom: var(--s-2); }
.process-compact__item p { color: var(--text-secondary); line-height: 1.6; }

/* --- Roadmap ------------------------------------------------------------------- */
.roadmap-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-6);
}
.roadmap-card { padding: var(--s-5); border: 1px dashed var(--border-strong); border-radius: 10px; }
.roadmap-card__tag {
  display: inline-block;
  font-size: var(--t-micro);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--warning);
  background: var(--warning-bg);
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  margin-bottom: var(--s-3);
  font-weight: 700;
}
.roadmap-card h4 { font-family: var(--font-display); font-size: var(--t-small); font-weight: 700; margin-bottom: var(--s-2); }
.roadmap-card p { font-size: var(--t-small); color: var(--text-secondary); line-height: 1.55; }

/* --- Case study (full page version) --------------------------------------------- */
.case-full {
  padding-block: var(--s-8);
  border-top: 1px solid var(--border);
}
.case-full:first-of-type { border-top: none; }
.case-full__eyebrow { color: var(--accent-2-ink); font-size: var(--t-eyebrow); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--s-3); }
.case-full h3 { font-family: var(--font-display); font-size: var(--t-h2); line-height: 1.1; max-width: 26ch; margin-bottom: var(--s-6); }
.case-full__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); }
.case-full__block dt { font-family: var(--font-display); font-weight: 700; font-size: var(--t-small); text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: var(--s-2); }
.case-full__block dd { color: var(--text-secondary); line-height: 1.65; margin-bottom: var(--s-5); }
.case-full__results { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-4); }
.case-full__stat { padding: var(--s-4); background: var(--surface-sunken); border-radius: 8px; }
.case-full__stat-num { font-family: "Fraunces", var(--font-display); font-size: var(--t-fig); color: var(--accent-2-ink); font-variant-numeric: tabular-nums; line-height: 1; }
.case-full__stat-label { font-size: var(--t-micro); color: var(--text-muted); margin-top: var(--s-2); text-transform: uppercase; letter-spacing: 0.04em; }

/* --- Impact stat strip ------------------------------------------------------------ */
.impact-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-6);
  margin-top: var(--s-7);
  padding-top: var(--s-7);
  border-top: 1px solid var(--border-on-deep);
}
.impact-strip__item { }
.impact-strip__num { font-family: "Fraunces", var(--font-display); font-size: var(--t-fig); color: var(--accent-2-on-deep); font-variant-numeric: tabular-nums; line-height: 1; }
.impact-strip__label { font-size: var(--t-small); color: var(--text-on-deep-secondary); margin-top: var(--s-2); line-height: 1.4; }

/* --- Contact page offices strip ---------------------------------------------------- */
.contact-offices {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-top: var(--s-7);
}

/* --- Closing CTA (shared simple band) ------------------------------------------------ */
.simple-cta {
  padding-block: var(--s-8);
  background: var(--surface-deep);
  color: var(--text-on-deep);
  text-align: center;
}
.simple-cta h2 { font-family: var(--font-display); font-size: var(--t-h2); margin-bottom: var(--s-4); }
.simple-cta p { color: var(--text-on-deep-secondary); max-width: 50ch; margin-inline: auto; margin-bottom: var(--s-6); }

/* --- Responsive ------------------------------------------------------------------------ */
@media (max-width: 960px) {
  .vm-grid, .layers, .founders, .svc-detail, .case-full__grid { grid-template-columns: 1fr; }
  .team-grid { grid-template-columns: repeat(2, 1fr); }
  .core-team { grid-template-columns: repeat(3, 1fr); }
  .offices-grid, .safeguards-grid, .roadmap-grid, .impact-strip, .contact-offices { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 620px) {
  .team-grid, .core-team, .offices-grid, .safeguards-grid, .roadmap-grid, .impact-strip, .contact-offices,
  .case-full__results {
    grid-template-columns: 1fr;
  }
  .page-hero { padding-block: calc(5.25rem + var(--s-6)) var(--s-6); }
  .inner-section { padding-block: var(--s-7); }
}

/* --- Contact page ---------------------------------------------------------------------
   Layout modelled on the Kortrijk Xpo contact page: a two-up intro (title left,
   supporting copy right), then filled "highlighted columns" capped top and bottom
   by a shallow curved SVG, then the form. Their red is replaced throughout by our
   own --surface-deep navy; nothing here introduces a new colour.

   Motion follows the reference too: no scroll-reveal, no pinning. The only movement
   is a 0.3s ease hover transition, which is what that page actually does. ------------ */

/* 1. Breadcrumb */
.crumb {
  padding-block: calc(5.25rem + var(--s-5)) 0;
  background: var(--surface-page);
}
.crumb__list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--s-2);
  list-style: none;
  /* The UA's default 40px list indent would set the breadcrumb in from the
     page margin; the title and every band below start at the .shell edge. */
  margin: 0;
  padding: 0;
  font-size: var(--t-micro);
  color: var(--text-muted);
}
.crumb__list li + li::before {
  content: "/";
  margin-right: var(--s-2);
  color: var(--border-strong);
}
.crumb__list a { color: var(--text-secondary); text-decoration: none; transition: color 0.3s ease; }
.crumb__list a:hover { color: var(--link); }
.crumb__list [aria-current="page"] { color: var(--text-primary); font-weight: 600; }

/* 2. Intro.
   The reference runs a 12-column flex grid and gives the title 5 columns with the
   supporting copy starting around column 8. Two columns of the same proportion
   reproduce that without importing a grid framework. */
.c-intro { padding-block: var(--s-6) var(--s-8); background: var(--surface-page); }
.c-intro__wrap {
  display: grid;
  grid-template-columns: 5fr 1fr 6fr;
  align-items: start;
}
.c-intro__main { grid-column: 1; }
.c-intro__aside { grid-column: 3; }
.c-intro__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--t-hero);
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--accent-2-ink);
  /* Both columns share a top line, but the two type sizes have different
     half-leading, so their boxes align while the text does not. This nudge
     is the difference between the two, pushing the cap-height onto the same
     baseline as the lede's first line. */
  margin-top: 0.026em;
}
.c-intro__lede {
  font-size: var(--t-body);
  color: var(--text-secondary);
  line-height: 1.6;
  /* No measure cap: the column itself is the measure, so the copy and the
     panel below it share one right edge. */
}
/* The reference's outlined pill under the intro copy. Uses our link navy rather
   than their red; the fill-on-hover is their interaction, at their 0.3s ease. */
.c-intro__cta {
  display: inline-block;
  margin-top: var(--s-5);
  padding: 0.7rem 1.4rem;
  font-size: var(--t-small);
  font-weight: 600;
  color: var(--link);
  text-decoration: none;
  border: 1px solid var(--link);
  border-radius: 999px;
  transition: color 0.3s ease, background-color 0.3s ease;
}
.c-intro__cta:hover { color: var(--text-on-deep); background: var(--link); }

/* 3. Get in touch.
   One band holding the form on the left and the contact channels on the right,
   as in the reference. Both sections below are height-capped to the viewport,
   so the inner column scrolls rather than the band growing past 100vh. */
.git {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-block: var(--s-7);
  background: var(--surface-page);
}
.git__inner { width: 100%; }
.git__title {
  font-family: var(--font-display);
  font-size: var(--t-h1, var(--t-h2));
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  margin-bottom: var(--s-6);
}
/* Form column, then a hairline, then the channels - the reference's proportions. */
.git__cols {
  display: grid;
  grid-template-columns: 1.35fr 1px 1fr;
  gap: var(--s-7);
  align-items: start;
}
.git__cols::before {
  content: "";
  grid-column: 2;
  align-self: stretch;
  background: var(--border);
}
.git__formcol { grid-column: 1; }
.git__infocol { grid-column: 3; }

.git__sub {
  font-family: var(--font-display);
  font-size: var(--t-small);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--s-2);
}
.git__lede {
  font-size: var(--t-micro);
  line-height: 1.6;
  color: var(--text-muted);
  max-width: 52ch;
  margin-bottom: var(--s-5);
}

/* --- Form ---------------------------------------------------------------
   Underline fields, as in the reference: no box, just a rule under each one,
   with the label floating up out of the way once the field has content. */
.cform__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--s-5) var(--s-6);
}
.cfield { position: relative; }
.cfield--full { grid-column: 1 / -1; }

.cfield input,
.cfield select,
.cfield textarea {
  width: 100%;
  font: inherit;
  font-size: var(--t-small);
  color: var(--text-primary);
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--border-strong);
  border-radius: 0;
  padding: 0.4rem 0 0.5rem;
  transition: border-color 0.3s ease;
}
.cfield textarea { min-height: 5.5rem; resize: vertical; }
.cfield select { appearance: none; cursor: pointer; }
/* The select carries its own caret, since appearance:none removes the native one. */
.cfield--select::after {
  content: "";
  position: absolute;
  right: 2px;
  top: 0.85rem;
  width: 0.4rem;
  height: 0.4rem;
  border-right: 1.5px solid var(--text-muted);
  border-bottom: 1.5px solid var(--text-muted);
  transform: rotate(45deg);
  pointer-events: none;
}
.cfield input:focus,
.cfield select:focus,
.cfield textarea:focus {
  outline: none;
  border-bottom-color: var(--accent-2-ink);
}

/* Floating label. The input carries placeholder=" " so :placeholder-shown is a
   reliable "is empty" test; the label rides above once it is not. */
.cfield label {
  position: absolute;
  left: 0;
  top: 0.4rem;
  font-size: var(--t-small);
  color: var(--text-muted);
  pointer-events: none;
  transition: transform 0.3s ease, font-size 0.3s ease, color 0.3s ease;
  transform-origin: 0 0;
}
.cfield input:focus + label,
.cfield input:not(:placeholder-shown) + label,
.cfield textarea:focus + label,
.cfield textarea:not(:placeholder-shown) + label {
  transform: translateY(-1.05rem) scale(0.8);
  color: var(--accent-2-ink);
}
/* A select has no placeholder state, so its first option is the label instead. */
.cfield--select select { color: var(--text-muted); }
.cfield--select select:valid { color: var(--text-primary); }

.cfield__error {
  margin-top: var(--s-2);
  font-size: var(--t-micro);
  color: var(--pnl-warning, #B3541E);
}
.cfield input[aria-invalid="true"],
.cfield select[aria-invalid="true"],
.cfield textarea[aria-invalid="true"] { border-bottom-color: var(--pnl-warning, #B3541E); }

.cbtn {
  display: block;
  margin-top: var(--s-5);
  margin-left: auto;
  width: auto;
  font: inherit;
  font-size: var(--t-micro);
  font-weight: 600;
  color: var(--text-on-deep);
  background: var(--surface-deep);
  border: 1px solid var(--surface-deep);
  border-radius: 0;
  padding: 0.7rem 1.2rem;
  cursor: pointer;
  transition: color 0.3s ease, background-color 0.3s ease;
}
.cbtn:hover { color: var(--surface-deep); background: transparent; }

/* --- Contact channels ---------------------------------------------------- */
.git-item + .git-item { margin-top: var(--s-6); }
.git-item__title {
  font-family: var(--font-display);
  font-size: var(--t-small);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--s-2);
}
.git-item__body {
  font-size: var(--t-micro);
  line-height: 1.6;
  color: var(--text-muted);
  margin-bottom: var(--s-3);
}
.git-item__link {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  margin-top: var(--s-2);
  font-size: var(--t-micro);
  font-weight: 600;
}
/* The channel icons sit in a soft teal disc, as in the reference. */
.git-item__ico {
  flex: none;
  display: grid;
  place-items: center;
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 50%;
  background: rgba(32, 176, 168, 0.14);
  color: var(--accent-2-ink);
}
.git-item__ico svg { width: 0.95rem; height: 0.95rem; }
.git-item__link a {
  color: var(--accent-2-ink);
  text-decoration: none;
  transition: color 0.3s ease;
}
.git-item__link a:hover { color: var(--link); }

/* 4. FAQ.
   Heading on the left, the questions on the right - the reference's split. */
.faq {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-block: var(--s-7);
  background: var(--surface-sunken);
}
.faq__inner {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: var(--s-7);
  align-items: start;
}
.faq__title {
  font-family: var(--font-display);
  font-size: var(--t-h1, var(--t-h2));
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  margin-top: var(--s-3);
  max-width: 9ch;
}
.faq__intro { margin-bottom: var(--s-6); }
.faq__introtitle {
  font-family: var(--font-display);
  font-size: var(--t-small);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--s-3);
}
.faq__introbody {
  font-size: var(--t-micro);
  line-height: 1.7;
  color: var(--text-secondary);
}

.faq__item { border-top: 1px solid var(--border); }
.faq__item:last-child { border-bottom: 1px solid var(--border); }
.faq__item summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-4);
  padding-block: var(--s-4);
  font-size: var(--t-small);
  font-weight: 600;
  color: var(--text-primary);
  cursor: pointer;
  list-style: none;
  transition: color 0.3s ease;
}
.faq__item summary::-webkit-details-marker { display: none; }
.faq__item summary:hover { color: var(--accent-2-ink); }
/* The +/- disc on the right, rotating open. */
.faq__item summary::after {
  content: "+";
  flex: none;
  display: grid;
  place-items: center;
  width: 1.4rem;
  height: 1.4rem;
  border: 1px solid var(--border-strong);
  border-radius: 50%;
  font-size: var(--t-small);
  font-weight: 400;
  line-height: 1;
  color: var(--text-secondary);
  transition: transform 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}
.faq__item[open] summary::after {
  content: "+";
  transform: rotate(45deg);
  border-color: var(--accent-2-ink);
  color: var(--accent-2-ink);
}
.faq__answer {
  padding-bottom: var(--s-4);
  font-size: var(--t-micro);
  line-height: 1.7;
  color: var(--text-secondary);
}

@media (max-width: 960px) {
  .c-intro__wrap { grid-template-columns: 1fr; gap: var(--s-5); }
  .c-intro__main, .c-intro__aside { grid-column: 1; }
  /* Below this width the 100vh cap is dropped: a stacked form plus channels
     cannot honestly fit one screen, and clipping them would be worse. */
  .git, .faq { min-height: 0; display: block; }
  .git__cols { grid-template-columns: 1fr; gap: var(--s-6); }
  .git__cols::before { display: none; }
  .git__formcol, .git__infocol { grid-column: 1; }
  .faq__inner { grid-template-columns: 1fr; gap: var(--s-5); }
  .faq__title { max-width: none; }
}
@media (max-width: 620px) {
  .crumb { padding-block: calc(5.25rem + var(--s-3)) 0; }
  .c-intro { padding-block: var(--s-5) var(--s-7); }
  .cform__grid { grid-template-columns: 1fr; gap: var(--s-5); }
}


/* ==========================================================================
   CASE STUDIES INDEX  (.csx)
   --------------------------------------------------------------------------
   The reference composition, rebuilt on MedShield's own tokens:

     - a CENTRED display masthead: one very large word-stack plus a narrow
       supporting line, both optically centred on the shell;
     - a STACK of full-width case rows. Each row is a two-column card - copy
       on the left, a single photograph filling the right half edge to edge -
       with a large diagonal arrow pinned to the row's bottom-left corner;
     - one row in the stack is INVERTED (solid brand blue, white ink). It is
       the emphasis beat the reference uses to stop the stack reading as a
       uniform list, and it is applied to the highest-value case;
     - a pill "Load more" control closing the stack.

   The image is a real <img> inside its own overflow box rather than a CSS
   background: it must be lazy-loaded, sized, and carry alt text.
   ========================================================================== */

.csx {
  padding-block: var(--s-8) var(--s-9);
  background: var(--surface-page);
}

/* --- Masthead ----------------------------------------------------------- */

.csx__head {
  text-align: center;
  margin-bottom: var(--s-8);
}

/* The display word-stack. Deliberately far larger than --t-display: in the
   reference this line is the page's single dominant object and everything
   below is small against it. Tight tracking and 0.92 leading keep the two
   words reading as one mass rather than two lines. */
.csx__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(2.75rem, 1.10rem + 7.2vw, 7.5rem);
  line-height: 0.92;
  letter-spacing: -0.03em;
  color: var(--accent);
  margin: 0;
}

.csx__lede {
  max-width: 52ch;
  margin: var(--s-5) auto 0;
  font-size: var(--t-body);
  line-height: 1.6;
  color: var(--text-secondary);
}

.csx__confirm { margin-top: var(--s-5); }

/* --- The stack ---------------------------------------------------------- */

.csx__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: var(--s-5);
}

/* --- One case row ------------------------------------------------------- */
/* GRID, not flex: the copy column and the media column must share one row
   height so the photograph fills the card's full height whatever the copy
   does. minmax(0,...) on both tracks stops a long unbroken figure from
   forcing the row wider than the shell. */
.csx-case {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
  gap: var(--s-6);
  padding: var(--s-6);
  border-radius: var(--radius-lg);
  background: var(--surface-sunken);
  overflow: hidden;
  transition: background 220ms ease;
}

/* The whole row is one target. The link is stretched over the card with a
   pseudo-element rather than wrapping the markup, so the heading stays a
   heading and the image stays outside the link text. */
.csx-case__link::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
}

.csx-case:hover { background: #EBEFF5; }
.csx-case:has(.csx-case__link:focus-visible) {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}

/* --- Copy column -------------------------------------------------------- */
/* Three rows: the copy block, a flexible spacer, then the arrow pinned to the
   bottom. 1fr on the middle row is what holds the arrow at the card's foot on
   short cards without absolute positioning. */
.csx-case__body {
  display: grid;
  grid-template-rows: auto 1fr auto;
  padding: var(--s-5) var(--s-4) var(--s-4) var(--s-5);
}

.csx-case__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.35rem, 1.05rem + 1.15vw, 2.05rem);
  line-height: 1.15;
  letter-spacing: -0.015em;
  color: var(--accent);
  margin: 0;
  max-width: 22ch;
}

/* The tag pill. Outlined, never filled: it is a category marker, not a
   status, and a filled chip at this size competes with the figure. */
.csx-case__tag {
  display: inline-block;
  margin-top: var(--s-4);
  padding: 0.3rem 0.75rem;
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  font-size: var(--t-micro);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--text-secondary);
  background: transparent;
}

.csx-case__text {
  margin: var(--s-4) 0 0;
  max-width: 44ch;
  font-size: var(--t-small);
  line-height: 1.6;
  color: var(--text-secondary);
}

/* The figure line - the one number each case is remembered by. */
.csx-case__figure {
  margin: var(--s-4) 0 0;
  font-size: var(--t-small);
  color: var(--text-muted);
}
.csx-case__figureNum {
  font-family: "Fraunces", var(--font-display);
  font-size: 1.6em;
  font-variant-numeric: tabular-nums;
  color: var(--accent-2-ink);
  margin-right: 0.35em;
}

/* The diagonal arrow at the row's bottom-left, as in the reference. */
.csx-case__arrow {
  grid-row: 3;
  align-self: end;
  width: 2.25rem;
  height: 2.25rem;
  color: var(--accent);
  transition: transform 220ms ease;
}
.csx-case__arrow svg { width: 100%; height: 100%; display: block; }
.csx-case:hover .csx-case__arrow { transform: translate(4px, -4px); }

/* --- Media column ------------------------------------------------------- */
.csx-case__media {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--surface-deep-alt);
  min-height: 17rem;
}
.csx-case__media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* --- The inverted row --------------------------------------------------- */
/* One row in the stack carries the brand blue. Every ink token flips with it;
   nothing else about the geometry changes. */
.csx-case--invert { background: var(--accent); }
.csx-case--invert:hover { background: var(--accent-hover); }
.csx-case--invert .csx-case__title,
.csx-case--invert .csx-case__arrow { color: var(--text-on-deep); }
.csx-case--invert .csx-case__text,
.csx-case--invert .csx-case__figure { color: var(--text-on-deep-secondary); }
.csx-case--invert .csx-case__tag {
  color: var(--text-on-deep);
  border-color: var(--hairline-on-deep-hi);
}
.csx-case--invert .csx-case__figureNum { color: var(--accent-2-on-deep); }

/* --- Load more ---------------------------------------------------------- */
.csx__more {
  display: flex;
  justify-content: center;
  margin-top: var(--s-6);
}
.csx__moreBtn {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-5);
  min-width: min(26rem, 100%);
  padding: 0.7rem 0.7rem 0.7rem var(--s-5);
  border: 0;
  border-radius: 999px;
  background: var(--accent);
  color: var(--text-on-deep);
  font-family: var(--font-body);
  font-size: var(--t-small);
  font-weight: 600;
  cursor: pointer;
  transition: background 200ms ease;
}
.csx__moreBtn:hover { background: var(--accent-hover); }
.csx__moreBtn:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
  box-shadow: 0 0 0 6px var(--focus-halo);
}
/* The circular arrow badge riding at the pill's right end. */
.csx__moreIcon {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background: var(--text-on-deep);
  color: var(--accent);
  flex: none;
}
.csx__moreIcon svg { width: 1rem; height: 1rem; }

/* Rows revealed by the Load more control. Inert (and out of the tab order,
   via the hidden attribute) until it is pressed. */
.csx-case[hidden] { display: none; }

/* --- Narrow ------------------------------------------------------------- */
/* The two columns stack, and the photograph moves ABOVE the copy: on a phone
   the reference leads each card with its image. */
@media (max-width: 820px) {
  .csx-case {
    grid-template-columns: 1fr;
    gap: var(--s-5);
    padding: var(--s-4);
  }
  .csx-case__media { order: -1; min-height: 12rem; }
  .csx-case__body { padding: var(--s-3) var(--s-2) var(--s-2) var(--s-3); }
  .csx-case__arrow { width: 1.85rem; height: 1.85rem; margin-top: var(--s-5); }
  .csx { padding-block: var(--s-7) var(--s-8); }
  .csx__head { margin-bottom: var(--s-7); }
}

@media (prefers-reduced-motion: reduce) {
  .csx-case, .csx-case__arrow { transition: none; }
  .csx-case:hover .csx-case__arrow { transform: none; }
}

/* ==========================================================================
   CASE STUDIES — scroll reveal
   ==========================================================================
   The index arrives in two movements, both driven by js/cases-reveal.js
   adding .is-in:

     [data-cx-reveal]  the masthead blocks, and the Load more control - they
                       rise and fade. --cx-d staggers siblings.
     .csx-case         a case row. The row itself rises and fades, and INSIDE
                       it the photograph un-zooms from a slight overscale
                       while the copy lifts a beat later - so the card reads
                       as one object settling, not four items appearing.

   Rows arrive one after another rather than all at once: cases-reveal.js
   sets --cx-d per row from its position in the stack, and because the stack
   is taller than the fold, that stagger is what makes scrolling the index
   feel like it is being dealt out.

   THE NO-JS / REDUCED-MOTION CONTRACT, identical to about.css:
   every hidden state below is scoped under .cx-anim, a class the script adds
   to <html> at parse time and only when motion is wanted. If the script
   never runs, or the reader asked for less motion, nothing is ever hidden and
   the page is simply the finished state.
   ========================================================================== */

/* --- Generic risers (masthead, Load more) -------------------------------- */

.cx-anim [data-cx-reveal] {
  opacity: 0;
  transform: translateY(1.4rem);
}
.cx-anim [data-cx-reveal].is-in {
  opacity: 1;
  transform: none;
  transition:
    opacity 700ms cubic-bezier(0.22, 0.61, 0.36, 1) var(--cx-d, 0ms),
    transform 860ms cubic-bezier(0.22, 0.61, 0.36, 1) var(--cx-d, 0ms);
}

/* --- A case row ---------------------------------------------------------- */
/* The row lifts further than the generic risers (2.2rem against 1.4rem):
   it is a much larger object, and a big card travelling a short distance
   reads as a jolt rather than an arrival. */

.cx-anim .csx-case {
  opacity: 0;
  transform: translateY(2.2rem);
}
.cx-anim .csx-case.is-in {
  opacity: 1;
  transform: none;
  transition:
    opacity 720ms cubic-bezier(0.22, 0.61, 0.36, 1) var(--cx-d, 0ms),
    transform 940ms cubic-bezier(0.22, 0.61, 0.36, 1) var(--cx-d, 0ms);
}

/* The photograph settles OUT of a slight overscale as the row lands. 1.08 is
   deliberately small - this is a settle, not a Ken Burns move - and it runs
   longer than the row so the picture is still easing after the card has
   stopped, which is what stops the two reading as one flat fade.

   The scale sits on the <img> inside .csx-case__media, which already has
   overflow:hidden, so nothing escapes the card's rounded corner. */
.cx-anim .csx-case__media img {
  transform: scale(1.08);
  transform-origin: center;
}
.cx-anim .csx-case.is-in .csx-case__media img {
  transform: none;
  transition: transform 1200ms cubic-bezier(0.22, 0.61, 0.36, 1) var(--cx-d, 0ms);
}

/* The copy lifts a beat AFTER the row it sits in, so the card arrives first
   and its contents settle into it. The extra 90ms is the whole effect. */
.cx-anim .csx-case__body > * {
  opacity: 0;
  transform: translateY(0.7rem);
}
.cx-anim .csx-case.is-in .csx-case__body > * {
  opacity: 1;
  transform: none;
  transition:
    opacity 620ms cubic-bezier(0.22, 0.61, 0.36, 1)
      calc(var(--cx-d, 0ms) + 90ms),
    transform 720ms cubic-bezier(0.22, 0.61, 0.36, 1)
      calc(var(--cx-d, 0ms) + 90ms);
}
/* The arrow is the last thing in, and it drifts in along its own diagonal -
   the same direction it points, and the same one it takes on hover. */
.cx-anim .csx-case__arrow {
  transform: translate(-0.4rem, 0.4rem);
}
.cx-anim .csx-case.is-in .csx-case__arrow {
  transform: none;
  transition:
    opacity 620ms cubic-bezier(0.22, 0.61, 0.36, 1)
      calc(var(--cx-d, 0ms) + 220ms),
    transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1)
      calc(var(--cx-d, 0ms) + 220ms);
}

/* Rows added by Load more arrive immediately rather than waiting to be
   scrolled to: the press IS the trigger, and re-observing them would leave a
   gap of blank cards under the reader's thumb. cases-more.js adds this class
   alongside unhiding them. */
.cx-anim .csx-case.is-in--now,
.cx-anim .csx-case.is-in--now .csx-case__body > *,
.cx-anim .csx-case.is-in--now .csx-case__media img {
  opacity: 1;
  transform: none;
}

/* --- Reduced motion ------------------------------------------------------ */
/* Belt and braces: the script already refuses to add .cx-anim when reduce is
   set, so these rules normally have nothing to act on. They exist for the
   reader who turns the preference on AFTER the page has loaded, when the
   class is already on <html>. */
@media (prefers-reduced-motion: reduce) {
  .cx-anim [data-cx-reveal],
  .cx-anim [data-cx-reveal].is-in,
  .cx-anim .csx-case,
  .cx-anim .csx-case.is-in,
  .cx-anim .csx-case__body > *,
  .cx-anim .csx-case__arrow,
  .cx-anim .csx-case__media img {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ==========================================================================
   WHY MEDSHIELD — alternating timeline  (.wtl)
   ==========================================================================
   The reference composition: a single vertical spine down the centre, with
   six steps alternating left and right of it. Each step is

     [ copy block ]  ---dashed leader---  (o)  icon medallion

   on one side, mirrored on the next. The medallion sits on the OUTER edge and
   the leader runs inward to a small node dotted onto the spine, so the eye is
   carried down the centre line while the reading alternates around it.

   GEOMETRY. One three-column grid per row: outer track, spine, outer track.
   The spine column is zero-width - the line itself is drawn by the section,
   not by a column - so the two copy tracks stay equal whatever the leader
   does. Odd rows put their content in column 1 and their medallion hard
   against the spine; even rows mirror to column 3 with direction reversed.

   The dashed leader and the spine node are pseudo-elements on the row, not
   markup: they carry no information the copy does not already state.
   ========================================================================== */

.wtl {
  position: relative;
  margin-top: var(--s-7);
  /* The medallion overhangs the copy track, so the section reserves room for
     it on both flanks rather than letting it collide with the shell edge. */
  padding-inline: var(--s-6);
}

/* --- The spine ----------------------------------------------------------- */
/* One continuous line down the centre. Drawn on the container rather than
   stitched from per-row segments, so there is no seam to drift between rows.
   It stops short at both ends (the inset) so it reads as a measured run
   rather than a rule that has been cut off by the section edge. */
.wtl__spine {
  position: absolute;
  left: 50%;
  top: 0.75rem;
  bottom: 0.75rem;
  width: 1px;
  background: var(--hairline-on-deep-hi);
  transform: translateX(-50%);
}

.wtl__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

/* --- One step ------------------------------------------------------------ */
.wtl-step {
  position: relative;
  display: grid;
  /* The centre track is the spine's own column: zero width, so the two copy
     tracks are exactly equal and the alternation is symmetrical. */
  grid-template-columns: minmax(0, 1fr) 0 minmax(0, 1fr);
  align-items: start;
  column-gap: 0;
}
/* Rows overlap deliberately. In the reference each step begins level with the
   PREVIOUS step's description rather than below it, which is what makes the
   column read as one continuous descent instead of six stacked cards. */
.wtl-step + .wtl-step { margin-top: calc(var(--s-6) * -1); }

/* --- Copy ---------------------------------------------------------------- */
/* Odd steps sit in the left track and are right-aligned, so the text runs UP
   to the spine. Even steps mirror. */
.wtl-step__body {
  grid-column: 1;
  text-align: right;
  padding-right: var(--s-6);
  max-width: 29ch;
  justify-self: end;
}
.wtl-step:nth-child(even) .wtl-step__body {
  grid-column: 3;
  text-align: left;
  padding-right: 0;
  padding-left: var(--s-6);
  justify-self: start;
}

.wtl-step__num {
  font-family: var(--font-display);
  font-size: var(--t-micro);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent-2-on-deep);
  margin: 0 0 var(--s-2);
}
.wtl-step__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.15rem, 0.98rem + 0.7vw, 1.6rem);
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--text-on-deep);
  margin: 0 0 var(--s-3);
}
.wtl-step__text {
  font-size: var(--t-small);
  line-height: 1.6;
  color: var(--text-on-deep-secondary);
  margin: 0;
}

/* --- Medallion ----------------------------------------------------------- */
/* The icon disc rides on the OUTER edge of the copy track, opposite the
   spine, exactly as in the reference. Absolute rather than a grid cell: it
   must be able to sit outside the copy's own box without widening the row. */
.wtl-step__icon {
  position: absolute;
  top: 0;
  /* Just outside the copy column rather than hard against the section edge:
     in the reference the leader is a short hop, not a rule across an empty
     half, and the whole composition sits nearer the centre line for it. */
  left: 15%;
  width: 3.25rem;
  height: 3.25rem;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: var(--text-on-deep);
  /* Lifts the disc off the dashed leader that runs underneath it. */
  box-shadow: 0 0 0 6px var(--surface-deep);
  z-index: 2;
}
.wtl-step:nth-child(even) .wtl-step__icon { left: auto; right: 15%; }
.wtl-step__icon svg {
  width: 1.5rem;
  height: 1.5rem;
  display: block;
}

/* --- Leader and node ----------------------------------------------------- */
/* The dashed run from the medallion across to the spine. Its vertical centre
   is the medallion's, so the two always agree however the copy sets. */
.wtl-step::before {
  content: "";
  position: absolute;
  top: 1.625rem;                        /* half the medallion */
  left: calc(15% + 3.25rem);            /* the medallion's inner edge */
  right: 50%;
  border-top: 1px dashed var(--hairline-on-deep-hi);
}
.wtl-step:nth-child(even)::before {
  left: 50%;
  right: calc(15% + 3.25rem);
}
/* The node dotted onto the spine where the leader meets it. */
.wtl-step::after {
  content: "";
  position: absolute;
  top: 1.625rem;
  left: 50%;
  width: 7px;
  height: 7px;
  margin: -3px 0 0 -3.5px;
  border-radius: 50%;
  background: var(--accent-2-on-deep);
  z-index: 1;
}

/* ==========================================================================
   Scroll reveal
   ==========================================================================
   Gated behind .cx-anim exactly like the case rows above: js/cases-reveal.js
   adds that class at parse time and only when motion is wanted, so the no-JS
   and reduced-motion states are the FINISHED state, never the hidden one.

   Each step arrives from its OWN side - left steps slide in from the left,
   right steps from the right - so the alternation is what the motion is
   about. The medallion pops a beat after the copy it belongs to. */

.cx-anim .wtl-step__body,
.cx-anim .wtl-step__icon {
  opacity: 0;
}
.cx-anim .wtl-step__body { transform: translateX(-1.5rem); }
.cx-anim .wtl-step:nth-child(even) .wtl-step__body { transform: translateX(1.5rem); }
.cx-anim .wtl-step__icon { transform: scale(0.6); }

/* The leader and node draw themselves in behind the copy. */
.cx-anim .wtl-step::before,
.cx-anim .wtl-step::after { opacity: 0; }

.cx-anim .wtl-step.is-in .wtl-step__body {
  opacity: 1;
  transform: none;
  transition:
    opacity 700ms cubic-bezier(0.22, 0.61, 0.36, 1),
    transform 820ms cubic-bezier(0.22, 0.61, 0.36, 1);
}
.cx-anim .wtl-step.is-in .wtl-step__icon {
  opacity: 1;
  transform: none;
  /* Slight overshoot: the disc lands with a little weight rather than easing
     to a stop, which is what makes it read as a marker being placed. */
  transition:
    opacity 420ms ease 140ms,
    transform 560ms cubic-bezier(0.34, 1.56, 0.64, 1) 140ms;
}
.cx-anim .wtl-step.is-in::before,
.cx-anim .wtl-step.is-in::after {
  opacity: 1;
  transition: opacity 500ms ease 260ms;
}

/* The spine draws downward as the section is reached. transform-origin top
   with a scaleY is one compositor-friendly property rather than animating
   height, which would relayout every row on every frame. */
.cx-anim .wtl__spine {
  transform: translateX(-50%) scaleY(0);
  transform-origin: top;
}
.cx-anim .wtl.is-in .wtl__spine {
  transform: translateX(-50%) scaleY(1);
  transition: transform 1100ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

@media (prefers-reduced-motion: reduce) {
  .cx-anim .wtl-step__body,
  .cx-anim .wtl-step__icon,
  .cx-anim .wtl-step::before,
  .cx-anim .wtl-step::after,
  .cx-anim .wtl__spine,
  .cx-anim .wtl.is-in .wtl__spine {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .cx-anim .wtl__spine { transform: translateX(-50%); }
}

/* --- Narrow -------------------------------------------------------------- */
/* The alternation collapses: the spine moves to the left margin, every step
   reads on one side of it, and the medallion sits ON the spine. Mirroring six
   steps around a centre line does not survive a phone width - the copy tracks
   become too narrow to set - so the timeline becomes a single rail. */
@media (max-width: 820px) {
  .wtl { padding-inline: 0; }
  .wtl__spine { left: 1.625rem; }

  .wtl-step {
    grid-template-columns: 1fr;
    padding-left: calc(3.25rem + var(--s-5));
    min-height: 3.25rem;
  }
  .wtl-step + .wtl-step { margin-top: var(--s-6); }

  .wtl-step__body,
  .wtl-step:nth-child(even) .wtl-step__body {
    grid-column: 1;
    text-align: left;
    padding-inline: 0;
    max-width: none;
    justify-self: stretch;
  }

  .wtl-step__icon,
  .wtl-step:nth-child(even) .wtl-step__icon { left: 0; right: auto; }

  /* No leader to draw on one rail, and the node would sit under the
     medallion that has taken its place. */
  .wtl-step::before,
  .wtl-step::after { display: none; }

  /* Every step now arrives from the same side. */
  .cx-anim .wtl-step__body,
  .cx-anim .wtl-step:nth-child(even) .wtl-step__body {
    transform: translateX(-1.2rem);
  }
}

/* --- CTA pill ------------------------------------------------------------
   The contact page's hero action (.c-intro__cta) reused for the closing CTA
   on the case studies page: an OUTLINED pill that fills on hover, rather than
   the solid .btn it replaced.

   Same geometry verbatim - the 999px radius, the 0.7rem/1.4rem padding, the
   600 weight and the colour/background transition. Only the palette differs,
   because .c-intro__cta prints on the page ground and this sits on
   --surface-deep, where --link measures far too dark to read. The on-deep
   text token carries the label and the border, and the hover inverts to the
   deep ground the same way the original inverts to white. */
.cta-pill {
  display: inline-block;
  margin-top: var(--s-5);
  padding: 0.7rem 1.4rem;
  font-size: var(--t-small);
  font-weight: 600;
  color: var(--text-on-deep);
  text-decoration: none;
  border: 1px solid var(--hairline-on-deep-hi);
  border-radius: 999px;
  transition: color 0.3s ease, background-color 0.3s ease,
              border-color 0.3s ease;
}
.cta-pill:hover {
  color: var(--surface-deep);
  background: var(--text-on-deep);
  border-color: var(--text-on-deep);
}
.cta-pill:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}
/* ==========================================================================
   LIGHT GROUND — Why MedShield timeline, impact strip, closing CTA
   ==========================================================================
   These three blocks were authored against --surface-deep and every ink token
   in them is an on-deep one. Moved onto the page ground they would be white
   type on white, so each token is swapped here for its light-ground pair.

   Scoped to .inner-section--light / .simple-cta--light rather than edited in
   place: about.html uses .inner-section--deep, .impact-strip and .simple-cta
   on the navy ground and must keep working exactly as it does.
   ========================================================================== */

.inner-section--light {
  background: var(--surface-page);
  color: var(--text-primary);
  border-bottom: none;
}
.inner-section--light .eyebrow { color: var(--accent-2-ink); }
.inner-section--light .section-title { color: var(--text-primary); }

/* --- Timeline on light --------------------------------------------------- */
/* The spine and the dashed leaders drop from the on-deep hairline to the
   page-ground border token; both are decorative separators, so they sit below
   3:1 by design exactly as their on-deep counterparts did. */
.inner-section--light .wtl__spine { background: var(--border-strong); }
.inner-section--light .wtl-step::before { border-top-color: var(--border-strong); }

/* The node keeps the teal accent but takes the variant tuned for the page
   ground - the on-deep teal is far too light to register on white. */
.inner-section--light .wtl-step::after { background: var(--accent-2-ink); }

.inner-section--light .wtl-step__num { color: var(--accent-2-ink); }
.inner-section--light .wtl-step__title { color: var(--text-primary); }
.inner-section--light .wtl-step__text { color: var(--text-secondary); }

/* The medallion keeps the brand blue fill and its white glyph - it is the one
   thing on the section that stays saturated, which is what makes the six
   markers read as a run down the page. Only the halo changes: it exists to
   lift the disc off the dashed leader running underneath, so it has to be the
   ground it now sits on. */
.inner-section--light .wtl-step__icon {
  background: var(--accent);
  color: var(--text-on-deep);
  box-shadow: 0 0 0 6px var(--surface-page);
}

/* --- Impact strip on light ----------------------------------------------- */
.inner-section--light .impact-strip { border-top-color: var(--border); }
.inner-section--light .impact-strip__num { color: var(--accent-2-ink); }
.inner-section--light .impact-strip__label { color: var(--text-muted); }

/* --- CTA band on light --------------------------------------------------- */
.simple-cta--light {
  background: var(--surface-page);
  color: var(--text-primary);
}
.simple-cta--light h2 { color: var(--text-primary); }
.simple-cta--light p { color: var(--text-secondary); }

/* The pill returns to the contact hero's own palette here: on the page ground
   --link is exactly the value .c-intro__cta was authored with, so on white
   this is that button verbatim rather than an on-deep adaptation of it. */
.simple-cta--light .cta-pill {
  color: var(--link);
  border-color: var(--link);
}
.simple-cta--light .cta-pill:hover {
  color: var(--text-on-deep);
  background: var(--link);
  border-color: var(--link);
}
