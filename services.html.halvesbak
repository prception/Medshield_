<!-- Services-hero FOUC gate. Must run BEFORE first paint, so it is inline and
     in the head — a defer'd script executes after the page has already
     painted, which would show the un-split headline for a frame before
     hiding it. Adds the class only when the hero will actually animate; the
     matching conditions are re-checked in js/services-hero.js, which removes
     the class again if it decides to bail out (e.g. GSAP failed to load).
     Kept deliberately tiny: it is the one thing standing between the reader
     and a flash of unstyled text. -->
<script>
  (function () {
    var m = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!m || !m.matches) document.documentElement.classList.add('svc-hero-anim');

    /* Take ownership of scroll restoration HERE, in the head, before the
       browser has had the chance to restore a previous position.

       This is not cosmetic. The hero's parallax measures its scroll range
       when it is built; if the page is already scrolled at that moment, the
       range is computed relative to that offset and comes out NEGATIVE
       (start -1500, end -540 for a 1500px restore). Scroll position 0 then
       sits past the end of that range, so the scrub pins itself at 100% and
       the image layer keeps a permanent 20% offset — the band of bare ground
       under the header. No later refresh() can undo it, because by then the
       damage is in the recorded start/end.

       Setting this in the deferred script is too late: the restore has
       already happened. It has to be here. */
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  })();
</script>
</head>
