<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>About MedShield - Maritime Healthcare &amp; Claims Management</title>
<meta name="description" content="MedShield: founders, the independent medical team, our leadership and clinical panel, and offices in Chennai, Singapore and Dubai. Maritime healthcare and claims management, built on an independent medical team above a verified provider network.">

<meta property="og:type" content="website">
<meta property="og:site_name" content="MedShield">
<meta property="og:title" content="About MedShield">
<meta property="og:description" content="Founders, the independent medical team, and offices across India, Singapore and the UAE.">
<meta property="og:image" content="assets/og-card.png">
<meta name="theme-color" content="#0A2A43">

<link rel="icon" href="assets/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
<link rel="stylesheet" href="css/style.css?v=5">
<link rel="stylesheet" href="css/inner.css?v=5">
<link rel="stylesheet" href="css/about.css?v=5">

<!-- NOT deferred, deliberately. This adds html.ab-anim synchronously so the
     reveal system's hidden states apply before first paint; deferring it
     would show every section, then hide it. See the contract comment at the
     top of the file. -->
<script src="js/about-reveal.js"></script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a class="brand" href="index.html" aria-label="MedShield - home">
      <img class="brand__mark" src="assets/M2.png" alt="" width="3682" height="930" decoding="async">
    </a>
    <button class="nav-toggle" id="nav-toggle" type="button"
            aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span class="nav-toggle__bars" aria-hidden="true">
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
      </span>
    </button>
  </div>
</header>

<nav class="site-menu" id="site-nav" aria-label="Primary" hidden>
  <div class="site-menu__inner">
    <ul class="site-menu__list">
      <li><a href="index.html">Home</a></li>
      <li><a href="services.html">Services</a></li>
      <li><a href="case-studies.html">Case Studies</a></li>
      <li><a href="about.html" aria-current="page">About</a></li>
      <li><a href="contact.html">Contact</a></li>
    </ul>
    <p class="site-menu__meta">
      <span>India</span>
      <span>Singapore</span>
      <span>UAE</span>
    </p>
  </div>
</nav>
<div class="nav-scrim" id="nav-scrim" hidden></div>

<main id="main">

  <!-- ======================================================================
       01 - HERO.  White Desert's .about-banner.
       A 100svh stage: the photograph absolutely fills it under a scrim, with
       the lockup centred on top - an italic display label over an uppercase
       display title, and nothing else. Full-bleed by sitting OUTSIDE .shell,
       with an inner .shell restoring the measure for the type.
       ====================================================================== -->
  <section class="wd-hero" aria-labelledby="about-h" data-bar-ink="light">
    <div class="wd-hero__bg">
      <img src="assets/about/hero.jpg"
           alt="Container terminal at dawn, gantry cranes working a berth."
           width="2000" height="1334" fetchpriority="high" decoding="async">
    </div>
    <div class="wd-hero__dim" aria-hidden="true"></div>
    <!-- Their .about-banner_fade: a black veil scrubbed 0 -> 0.8 as the
         hero scrolls out, so it darkens under the incoming section. -->
    <div class="wd-hero__fade" aria-hidden="true"></div>

    <div class="wd-hero__content">
      <div class="shell">
        <p class="wd-hero__label" data-wd-reveal="opacity">About</p>
        <h1 class="wd-hero__title" id="about-h" data-wd-reveal>Our story</h1>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       02 - HOW IT ALL STARTED.  Their "How it all started" block.
       Big uppercase title top-left, and a narrow copy column on the right
       dropped well below the heading.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="intro-h">
    <div class="shell">
      <div class="wd-intro" data-ab-stagger="140">
        <div class="wd-intro__head" data-wd-reveal>
          <h2 class="wd-intro__title" id="intro-h">How it all started</h2>
        </div>

        <div class="wd-intro__body" data-wd-reveal>
          <p class="wd-intro__eyebrow">Our story</p>
          <p class="wd-intro__copy">
            MedShield is India's first multidisciplinary maritime healthcare
            company. For nearly a decade we have been the trusted partner for
            cruise lines, shipping agencies, maritime employers and agents -
            championing seafarers' care and securing employers' trust by
            putting an independent specialist medical team above a verified
            treatment network, standardising clinical decisions, provider
            selection, treatment monitoring and cost control across India,
            Singapore and the UAE.
          </p>
          <p class="wd-intro__copy">
            Expert medical decision-making, a verified network and full case
            coordination in one service. Treatment facilities are chosen on
            expertise, infrastructure and efficiency, so every recommendation
            rests on clinical merit and your crew get the right care in the
            right place, first time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       03 - VISION & MISSION.  Sticky stage, swapping backgrounds.
       A 200svh rail over a 100svh sticky stage: the labels stack top-left
       with the inactive one dimmed, the copy swaps on the right, and the
       photograph behind cross-fades while easing out of a small zoom.
       Scroll position drives it via data-vm-step on the section — see
       js/vm-steps.js. Copy is unchanged.
       ====================================================================== -->
  <section class="wd-vm" id="vision-mission" data-vm-step="0" aria-labelledby="vm-h" data-bar-ink="light">
    <h2 class="visually-hidden" id="vm-h">Vision and mission</h2>

    <div class="wd-vm__sticky">
      <div class="wd-vm__bg" aria-hidden="true">
        <div class="wd-vm__layer wd-vm__layer--0">
          <img src="assets/about/story.jpg" alt=""
               width="2000" height="1333" loading="lazy" decoding="async">
        </div>
        <div class="wd-vm__layer wd-vm__layer--1">
          <img src="assets/about/mission.jpg" alt=""
               width="2000" height="1334" loading="lazy" decoding="async">
        </div>
      </div>
      <div class="wd-vm__scrim" aria-hidden="true"></div>

      <div class="shell wd-vm__inner">
        <ul class="wd-vm__labels" aria-hidden="true">
          <li class="wd-vm__label wd-vm__label--0">Vision</li>
          <li class="wd-vm__label wd-vm__label--1">Mission</li>
        </ul>

        <div class="wd-vm__panes">
          <div class="wd-vm__pane wd-vm__pane--0">
            <p class="wd-vm__eyebrow">Vision</p>
            <p class="wd-vm__copy">
              To raise the standard of maritime healthcare with seamless
              solutions that safeguard seafarers' well-being while addressing
              the operational priorities of maritime employers - empowering
              the global maritime community with specialised expertise and an
              unwavering commitment to care.
            </p>
          </div>

          <div class="wd-vm__pane wd-vm__pane--1">
            <p class="wd-vm__eyebrow">Mission</p>
            <p class="wd-vm__copy">
              To set a new benchmark for maritime healthcare by integrating
              technology with human-centred care - proactive health
              management, rapid claims resolution and effective cost control,
              so health risks are minimised and operational disruption is
              avoided.
            </p>
          </div>
        </div>
      </div>

      <div class="wd-vm__dots" aria-hidden="true">
        <span class="wd-vm__dot wd-vm__dot--0"></span>
        <span class="wd-vm__dot wd-vm__dot--1"></span>
      </div>
    </div>
  </section>


  <!-- ======================================================================
       04 - BY THE NUMBERS.  Statement + oversized figure stack.
       A large claim top-left with a photograph top-right, a narrow
       supporting paragraph bottom-left, and the five figures running down
       the centre at display scale with their labels alongside.

       Each figure reveals and counts up as it arrives - the count is the
       existing [data-ab-count] behaviour in js/about-reveal.js, the reveal
       the [data-wd-reveal] one, staggered so the stack arrives in sequence
       rather than all at once.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="nums-h">
    <div class="shell">
      <div class="wd-nums" data-ab-stagger="110">
        <div class="wd-nums__head" data-wd-reveal>
          <h2 class="wd-nums__title" id="nums-h">
            For nearly a decade, MedShield has been the trusted partner at the
            heart of <em>maritime healthcare</em>
          </h2>
        </div>

        <figure class="wd-nums__media" data-wd-reveal>
          <img src="assets/about/nums.jpg"
               alt="A carer holding a patient's hand at the bedside."
               width="2000" height="1333" loading="lazy" decoding="async">
        </figure>

        <p class="wd-nums__lede" data-wd-reveal>
          MedShield's independent medical team and verified provider network
          give owners a single, accountable route through a crew medical
          case - from the first call to the closed claim. These are the
          resources standing behind every treatment decision we make.
        </p>

        <div class="wd-nums__stats" data-ab-stagger="110">
          <div class="wd-nums__row" data-wd-reveal>
            <p class="wd-nums__figure" data-ab-count>130+</p>
            <p class="wd-nums__label">Subject matter experts &mdash; 80% medical, 20% cross-functional</p>
          </div>

          <div class="wd-nums__row" data-wd-reveal>
            <p class="wd-nums__figure" data-ab-count>1,800+</p>
            <p class="wd-nums__label">Partner hospitals, clinics, labs and pharmacies</p>
          </div>

          <div class="wd-nums__row" data-wd-reveal>
            <p class="wd-nums__figure" data-ab-count>45+</p>
            <p class="wd-nums__label">Locations across India</p>
          </div>

          <div class="wd-nums__row" data-wd-reveal>
            <p class="wd-nums__figure" data-ab-count>9</p>
            <p class="wd-nums__label">SME disciplines on the panel</p>
          </div>

          <div class="wd-nums__row" data-wd-reveal>
            <p class="wd-nums__figure" data-ab-count>3</p>
            <p class="wd-nums__label">Offices &mdash; India, Singapore and the UAE</p>
          </div>
        </div>
      </div>

      <!-- RESOLVED: "About Us - 16 Dec 24" gives these as two distinct
           figures, not one - 45+ LOCATIONS across India (geographical
           reach) and 1,800+ ENTITIES (hospitals, clinics, labs, pharmacies,
           prehab/rehab providers). They are now separate stats; do not
           collapse them back into a single number. -->
    </div>
  </section>


  <!-- ======================================================================
       05 — WHAT SETS US APART.  The client's "Unmatched Advantages" list.
       These are the differentiators named in About Us - 16 Dec 24. Two of
       them (ISO 45001 and the near-decade of trading) carried no mention on
       the page at all before this section existed, despite ISO 45001 being
       the hardest credential in the document to copy.

       LAYOUT: a full-bleed photographic bed. The oversized stacked headline
       sits hard into the TOP-LEFT, the standfirst paragraph into the
       BOTTOM-LEFT, and the six advantages run along the bottom as a
       hairline-ruled strip of numbered cells that starts beside the
       standfirst and continues off the right edge into a horizontal scroll
       on narrow beds. No content from the previous list is dropped: every
       key, title and note is carried over verbatim.
       ====================================================================== -->
  <section class="ab-apart" aria-labelledby="usp-h" data-bar-ink="light">
    <div class="ab-apart__inner">
      <div class="ab-apart__media" aria-hidden="true">
        <img src="assets/about/apart-bg.jpg"
             alt="" width="2400" height="1350"
             loading="eager" fetchpriority="low" decoding="async">
      </div>
      <header class="ab-apart__head">
        <p class="ab-apart__label" data-wd-reveal="opacity">What sets us apart</p>
        <h2 class="ab-apart__title" id="usp-h" data-wd-reveal>
          <span>Advantages</span>
          <span>that are</span>
          <span><em>hard to copy</em></span>
        </h2>
      </header>

      <div class="ab-apart__grid">
        <p class="ab-apart__lede" data-wd-reveal>
          Six things a competitor cannot simply decide to have: a certification
          no other Indian company holds, a discipline mix built over years, and
          a network and toolset we own rather than rent.
        </p>

        <ol class="ab-apart__cells" data-ab-stagger="90">
          <li class="ab-apart__cell" data-wd-reveal>
            <p class="ab-apart__num">01</p>
            <p class="ab-apart__key">ISO</p>
            <h3 class="ab-apart__cellTitle">ISO 45001 certified</h3>
            <p class="ab-apart__cellCopy">
              The first and only company in India to achieve this occupational
              health and safety standard.
            </p>
          </li>
          <li class="ab-apart__cell" data-wd-reveal>
            <p class="ab-apart__num">02</p>
            <p class="ab-apart__key">First</p>
            <h3 class="ab-apart__cellTitle">
              India's first multidisciplinary maritime healthcare company
            </h3>
            <p class="ab-apart__cellCopy">
              An integrated approach, unmatched in the country.
            </p>
          </li>
          <li class="ab-apart__cell" data-wd-reveal>
            <p class="ab-apart__num">03</p>
            <p class="ab-apart__key">10 yrs</p>
            <h3 class="ab-apart__cellTitle">Nearly a decade as a trusted partner</h3>
            <p class="ab-apart__cellCopy">
              To cruise lines, shipping agencies, maritime employers and agents.
            </p>
          </li>
          <li class="ab-apart__cell" data-wd-reveal>
            <p class="ab-apart__num">04</p>
            <p class="ab-apart__key">Team</p>
            <h3 class="ab-apart__cellTitle">130+ subject matter experts</h3>
            <p class="ab-apart__cellCopy">
              80% medical professionals &mdash; specialists and
              super-specialists &mdash; and 20% cross-functional experts.
            </p>
          </li>
          <li class="ab-apart__cell" data-wd-reveal>
            <p class="ab-apart__num">05</p>
            <p class="ab-apart__key">Reach</p>
            <h3 class="ab-apart__cellTitle">
              45+ locations across India, plus Singapore and the UAE
            </h3>
            <p class="ab-apart__cellCopy">
              Backed by 1,800+ partner hospitals, clinics, laboratories,
              pharmacies and prehab/rehab providers.
            </p>
          </li>
          <li class="ab-apart__cell" data-wd-reveal>
            <p class="ab-apart__num">06</p>
            <p class="ab-apart__key">Tech</p>
            <h3 class="ab-apart__cellTitle">Mobile and admin dashboard applications</h3>
            <p class="ab-apart__cellCopy">
              Built and maintained in-house, with 24 / 7 / 365 tech support.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       06 - THE TWO-LAYER MODEL.  Their "More about us" card row.
       The reference closes with a row of equal cards, each an image over a
       title and a short paragraph. Two cards here, in the order that carries
       the argument: the medical team FIRST, the network under it.
       ====================================================================== -->
  <section class="ab-section ab-section--sunken ab-layers" aria-labelledby="layers-h">
    <div class="shell">
      <p class="wd-split__label" data-wd-reveal="opacity">How we work</p>
      <h2 class="wd-split__title" id="layers-h" data-wd-reveal>
        An independent medical team <em>above</em> a verified network
      </h2>

      <div class="wd-cards" data-ab-stagger="140">
        <article class="wd-card" data-wd-reveal>
          <figure class="wd-card__media">
            <img src="assets/about/medical-team.jpg"
                 alt="Three doctors reviewing a case together, one holding an X-ray film."
                 width="1600" height="1000" loading="lazy" decoding="async">
          </figure>
          <p class="wd-split__label">Layer 02</p>
          <h3 class="wd-card__title">An independent central medical team</h3>
          <p class="wd-card__copy">
            A 130+ strong subject-matter panel &mdash; 80% of them medical
            specialists and super-specialists &mdash; who decide what should
            actually happen: assessing treatment proposals, selecting the
            provider, setting the protocol and monitoring the case &mdash; a
            single accountable view of the case from first call to closure.
          </p>
        </article>

        <article class="wd-card" data-wd-reveal>
          <figure class="wd-card__media">
            <img src="assets/about/network.jpg"
                 alt="A clinic corridor signed for consultation rooms, ECG, laboratory and procedure room."
                 width="1600" height="1000" loading="lazy" decoding="async">
          </figure>
          <p class="wd-split__label">Layer 01</p>
          <h3 class="wd-card__title">A verified treatment network across India</h3>
          <p class="wd-card__copy">
            Accredited providers on pre-negotiated rates, checked before they
            are used - hospitals, clinics, laboratories and pharmacies. The
            network is the floor the medical team stands on, not the product
            in itself.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       07 - FOUNDERS.  A scroll-scrubbed reel.
       A tall rail with a sticky stage: the portrait stands on the base line
       in the centre of the bed, the oversized name starts at the portrait's
       right edge, and the bio sits at the far right, top-aligned with the
       portrait. Scrolling scrubs one founder to the next - the portrait
       lifts out of its frame as the next rises in, the names run upward
       like a vertical countdown, and the bios cross-fade on the same clock.
       ====================================================================== -->
  <section class="wd-fnd" id="founders" aria-labelledby="founders-h"
           data-fnd-step="0" style="--fnd-p:0">
    <div class="wd-fnd__stage">
      <div class="shell wd-fnd__grid">
        <h2 class="visually-hidden" id="founders-h">Founders</h2>

        <p class="wd-fnd__rail">Meet the founders</p>

        <!-- Portrait column: both portraits stacked in one cell, standing on
             the section's base line. The scrub slides the outgoing one up
             and out of its own clip while the next rises into it. -->
        <div class="wd-fnd__media">
          <figure class="wd-fnd__shot wd-fnd__shot--0">
            <img src="assets/people/desikan.jpg"
                 alt="Dr. Desikan Setlur, Founder and CEO of MedShield."
                 width="560" height="700" loading="lazy" decoding="async">
          </figure>
          <figure class="wd-fnd__shot wd-fnd__shot--1">
            <img src="assets/people/princi.jpg"
                 alt="Dr. Princi Singh, Co-Founder and COO of MedShield."
                 width="560" height="700" loading="lazy" decoding="async">
          </figure>
        </div>

        <!-- Names: a vertical countdown reel. The whole reel is translated
             up by one slot per step, clipped by the column. -->
        <div class="wd-fnd__names">
          <div class="wd-fnd__reel">
            <div class="wd-fnd__slot">
              <p class="wd-fnd__idx">01</p>
              <h3 class="wd-fnd__name"><span>Desikan</span><span>Setlur</span></h3>
              <p class="wd-fnd__role">Founder &amp; CEO</p>
            </div>
            <div class="wd-fnd__slot">
              <p class="wd-fnd__idx">02</p>
              <h3 class="wd-fnd__name"><span>Princi</span><span>Singh</span></h3>
              <p class="wd-fnd__role">Co-Founder &amp; COO</p>
            </div>
          </div>
        </div>

        <!-- Bios: far right, top-aligned with the portrait. Cross-faded and
             lifted on the same scrub. -->
        <div class="wd-fnd__bios">
          <p class="wd-fnd__bio wd-fnd__bio--0">
            A Ph.D. in Maritime Occupational Health &amp; Safety from Swansea
            University, U.K., with over two decades in maritime healthcare. He
            has led medical evacuations and port operations across India and
            Asia, and built long-standing relationships with global insurers,
            TPAs and maritime agents. Under his leadership, MedShield bridges
            healthcare needs and operational efficiency with tech-driven,
            seafarer-first solutions.
          </p>
          <p class="wd-fnd__bio wd-fnd__bio--1">
            A dental surgeon (BDS) with specialised certification in Hospital
            Management and over a decade in healthcare operations. She
            oversees MedShield's day-to-day healthcare delivery - treatment
            plan coordination, hospital partnerships and the telemedicine
            programme - working alongside Dr. Setlur on strategic direction
            and MedShield's global expansion.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ======================================================================
       08 - THE DISCIPLINES.  Device 3: bordered wall, merged centre cell.
       Twelve capability tiles ringing a navy statement block, exactly the
       reference's brand wall - but the cells carry disciplines rather than
       logos, which is the honest version of that device for this company.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="disc-h">
    <div class="shell">
      <p class="wd-split__label" data-wd-reveal="opacity">The independent medical team</p>
      <h2 class="wd-split__title" id="disc-h" data-wd-reveal
          style="max-width: 24ch; margin-bottom: var(--s-7);">
        Every discipline a maritime case can turn on
      </h2>

      <div class="ab-wall" data-ab-stagger="55">
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Maritime medical</p>
          <p class="ab-tile__meta">Physical and mental health at sea</p>
        </div>
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Telemedicine</p>
          <p class="ab-tile__meta">Remote consultations, globally</p>
        </div>
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Healthcare &amp; claims</p>
          <p class="ab-tile__meta">Medical, disability and life</p>
        </div>
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Clinical correlation</p>
          <p class="ab-tile__meta">Findings read against each other</p>
        </div>
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Treatment analysis</p>
          <p class="ab-tile__meta">Plans reviewed on merit and cost</p>
        </div>
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Global pharmacology</p>
          <p class="ab-tile__meta">Medication compliance across ports</p>
        </div>

        <!-- Exactly ten tiles ring the statement: six across the top row,
             then two flanking pairs down the sides. The count is load-bearing
             - see the placement note on .ab-tile--statement. -->
        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Preventive health</p>
          <p class="ab-tile__meta">Occupational programmes</p>
        </div>

        <div class="ab-tile ab-tile--statement" data-wd-reveal>
          <p class="ab-wall__statement" data-ab-lines="whole">
            An independent<br><em>medical team</em>
          </p>
        </div>

        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Medico-legal</p>
          <p class="ab-tile__meta">Arbitration, advisory, complex claims</p>
        </div>

        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">Technology</p>
          <p class="ab-tile__meta">24 / 7 / 365</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       09 - THE PANEL.  Device 3, bio variant.
       Eleven named reviewers as a dense wall rather than eleven tall cards.
       Each biography is in the DOM for search and assistive tech, revealed
       on hover or keyboard focus so the wall keeps its density.
       ====================================================================== -->
  <section class="ab-section ab-section--deep" aria-labelledby="panel-h" data-bar-ink="light">
    <div class="shell">
      <p class="wd-split__label" data-wd-reveal="opacity">The panel</p>
      <h2 class="wd-split__title" id="panel-h" data-wd-reveal
          style="max-width: 22ch; margin-bottom: var(--s-4);">
        Who reviews your case
      </h2>
      <p class="ab-split__copy" data-wd-reveal style="margin-bottom: var(--s-7); max-width: 58ch;">
        A sample of the specialists on our clinical and legal panel. Before a
        treatment plan is approved, this team reviews it on clinical merit and
        on cost, so you know what is being proposed and why.
      </p>

      <div class="ab-wall" data-ab-stagger="55">
        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. M. Jaya Rajah</p>
          <p class="ab-tile__meta">Senior Consultant &amp; Head of Cardiology</p>
          <span class="ab-tile__bio"><span><span>Over three decades in Internal Medicine and Cardiology. MD from Stanley Medical College, DM Cardiology from Madras Medical College. 17 years heading Cardiology at Sooriya Hospital; 12 years as Professor of Cardiology at Sri Ramachandra Medical College.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. P. Satish</p>
          <p class="ab-tile__meta">Senior Consultant Gastro Surgeon</p>
          <span class="ab-tile__bio"><span><span>Specialises in hepatobiliary, pancreatic, gastro-esophageal, colorectal and abdominal cancer surgeries. Published research in gastroenterology journals and a regular contributor to global conferences.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. S.T. Sivaraman</p>
          <p class="ab-tile__meta">Consultant Orthopedic Surgeon, Emergency &amp; Trauma</p>
          <span class="ab-tile__bio"><span><span>Over two decades of experience. Gold Medalist, AIIMS New Delhi. Fellowship in Traumatology and Reconstructive Surgery, Katharinen Hospital, Stuttgart. Currently at Sooriya Hospital, Chennai.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Srinivas Rajagopala</p>
          <p class="ab-tile__meta">Director, Pulmonology &amp; Sleep Medicine</p>
          <span class="ab-tile__bio"><span><span>Over 20 years' experience. Trained at PGIMER Chandigarh and JIPMER Puducherry, with further training in Adelaide, McMaster and Toronto. Specialises in lung transplantation and advanced lung disease.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Sudheer Pargewar</p>
          <p class="ab-tile__meta">Senior Consultant, Interventional Radiology</p>
          <span class="ab-tile__bio"><span><span>18 years' experience, trained at the Institute of Liver and Biliary Sciences (New Delhi) and Juntendo University (Tokyo). Specialises in minimally invasive hepatobiliary interventions.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Tarun Grover</p>
          <p class="ab-tile__meta">Director, Peripheral Vascular &amp; Endovascular Sciences</p>
          <span class="ab-tile__bio"><span><span>Over 25 years' experience. Fellow of the American College of Surgeons. Trained at St. Mary's Hospital, London and the Regional Vascular Centre, Cologne.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Vijayaraghavan G.</p>
          <p class="ab-tile__meta">Senior Consultant, Spine Surgery</p>
          <span class="ab-tile__bio"><span><span>Over a decade in minimally invasive spine surgery. Graduate of Madras Medical College and AIIMS New Delhi, with fellowships in Singapore, Korea/Japan/China and UCSF.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Vinod S. Joshi</p>
          <p class="ab-tile__meta">Section Head, Urology</p>
          <span class="ab-tile__bio"><span><span>Trained at Nair Hospital in endourology, urodynamics and andrology. Skilled in TURP, PCNL and URS - independently achieving a 65% total stone clearance rate in PCNL.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Princi Singh</p>
          <p class="ab-tile__meta">Co-Founder &amp; COO</p>
          <span class="ab-tile__bio"><span><span>Dental surgeon (BDS) with certification in Hospital Management, overseeing treatment plan coordination, hospital partnerships and the telemedicine programme.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">K. Vijay Anand</p>
          <p class="ab-tile__meta">Legal &amp; Compliance Advisor</p>
          <span class="ab-tile__bio"><span><span>M.A., B.L., over 25 years in corporate legal, risk mitigation and compliance advisory - advising on legal frameworks, strategic risk mitigation and representation in disputes.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-wd-reveal tabindex="0">
          <p class="ab-tile__name">R.V. Senthil Kumar</p>
          <p class="ab-tile__meta">Advocate, Arbitration &amp; Labour Law</p>
          <span class="ab-tile__bio"><span><span>B.A., B.L., registered advocate with over 24 years across civil, criminal, insurance and company law - particular depth in labour law, arbitration and MLC/ILO-aligned employee dispute resolution.</span></span></span>
        </div>

        <div class="ab-tile" data-wd-reveal>
          <p class="ab-tile__name">And the wider panel</p>
          <p class="ab-tile__meta">Part of 130+ experts across nine disciplines</p>
        </div>
      </div>
    </div>
  </section>
