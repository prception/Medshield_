<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>MedShield - Maritime Medical Case Management for Crew Operators</title>
<meta name="description" content="MedShield manages the whole crew medical case - from the first call at sea to the closed claim. Telemedicine, hospital coordination, claims and compliance for cruise lines, shipping companies and offshore operators. India, Singapore, UAE.">

<meta property="og:type" content="website">
<meta property="og:site_name" content="MedShield">
<meta property="og:title" content="MedShield - Maritime Medical Case Management for Crew Operators">
<meta property="og:description" content="MedShield manages the whole crew medical case - from the first call at sea to the closed claim. Telemedicine, hospital coordination, claims and compliance for cruise lines, shipping companies and offshore operators. India, Singapore, UAE.">
<meta property="og:image" content="assets/og-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="MedShield - expanding the horizon of maritime care, from the first call at sea to the closed claim.">
<meta property="og:locale" content="en">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="MedShield - Maritime Medical Case Management for Crew Operators">
<meta name="twitter:description" content="MedShield manages the whole crew medical case - from the first call at sea to the closed claim. Telemedicine, hospital coordination, claims and compliance across India, Singapore and the UAE.">
<meta name="twitter:image" content="assets/og-card.png">
<meta name="theme-color" content="#0A2A43">

<!-- The hero runs with no poster: the video itself is the first paint, so the
     hero ground shows through until enough of the clip has buffered to play.
     Nothing is preloaded here — hero-poster.jpg still exists on disk, but only
     as the doubts section's photograph, not as hero first paint. -->

<!-- The hero headline is set in Archivo at ~5.4vw. A swap after first paint at
     that scale is a very visible reflow, so the face is preloaded alongside
     the poster rather than being discovered inside the stylesheet. -->
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/archivo-latin-var.woff2" crossorigin>

<!-- Fraunces was previously discovered inside the stylesheet, which was fine
     while it set only the small stat numerals. It now also sets the outlined
     "WHAT" in section 04 at ~21vh — by far the largest glyphs on the page —
     where a font-display:swap late swap is a very visible reflow. -->
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/fraunces-latin-var.woff2" crossorigin>

<link rel="icon" href="assets/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<!-- Transparent overlay bar sitting ON the hero video: brand left, a bare
     hamburger right, and NOTHING else at any breakpoint. The navigation links
     are not removed - they live in the overlay menu below, which is now the
     single route to them on desktop as well as mobile. Past 80px the
     .is-stuck class fades in a navy blur so the bar stays legible over the
     lighter sections beneath. -->
<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a class="brand" href="#top" aria-label="MedShield - home">
      <!-- The logo, shown at its own pixel colours in every header state.
           No filter, no variant swap: this file IS the brand, wordmark
           included, so no separate text node sits beside it. -->
      <img class="brand__mark" src="assets/M2.png" alt="" width="3682" height="930" decoding="async">
    </a>

    <!-- Two bare rules, no border, no pill, no background. The word "Menu"
         sits beside them on desktop only - it is the affordance that stops a
         naked icon from being ambiguous, and it disappears on mobile where
         the hamburger is a universally understood control. -->
    <button class="nav-toggle" id="nav-toggle" type="button"
            aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <!-- Three bare lines and nothing else — no text label, matching the
           reference exactly. The middle line slides OUT sideways when open
           (the reference's translate(-150%)) rather than fading, so each line
           needs its own node inside a clipping box. -->
      <span class="nav-toggle__bars" aria-hidden="true">
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
      </span>
    </button>
  </div>
</header>

<!-- Full-screen overlay menu. Holds every link that used to sit in the bar,
     so nothing became unreachable when the desktop nav was removed.
     [hidden] until opened: keeps it out of the tab order and the a11y tree
     entirely rather than relying on transform alone to hide it. -->
<nav class="site-menu" id="site-nav" aria-label="Primary" hidden>
  <div class="site-menu__inner">
    <ul class="site-menu__list">
      <!-- Nav now maps to PAGES, not in-page anchors: About, Services, Case
           Studies and Contact are their own documents (about.html,
           services.html, case-studies.html, contact.html), each built out
           with the fuller content that used to be compressed into a single
           homepage section. Every target is a real file. -->
      <li><a href="index.html" aria-current="page">Home</a></li>
      <li><a href="services.html">Services</a></li>
      <li><a href="case-studies.html">Case Studies</a></li>
      <li><a href="about.html">About</a></li>
      <li><a href="contact.html">Contact</a></li>
    </ul>

    <p class="site-menu__meta">
      <span>India</span>
      <span>Singapore</span>
      <span>UAE</span>
    </p>
  </div>
</nav>
<div class="nav-scrim" id="nav-scrim" hidden></div>

<main id="main">

  <!-- 01 - Hero ................................................. -->
  <!-- data-bar-ink="light" marks every section whose ground is dark enough
       that the transparent header needs WHITE ink over it. hero.js probes
       these rects on scroll (isDeepUnderBar) and adds .is-on-light to the
       bar only when none of them is under it. Add this attribute to any new
       dark section, or the wordmark and hamburger will go navy-on-navy. -->
  <section class="hero" id="top" data-bar-ink="light">

    <!-- Media layer.
         The video runs at every viewport width — phones fetch and play the
         same clip as desktop, so the <source> carries no media attribute.
         There is deliberately NO poster: the video is the only image the hero
         should ever show. Until it buffers, the hero ground shows through, so
         the weight of the encode is what governs how long that lasts.
         hero.js additionally withholds playback under prefers-reduced-motion. -->
    <!-- The media autoplays and loops continuously. It is NOT scrubbed by
         scroll any more: playback runs on its own clock so the ocean keeps
         moving whether or not the user scrolls.
         muted is required for autoplay to be allowed at all; the encode also
         carries no audio stream, so nothing is downloaded for a track that
         would never be heard. -->
    <div class="hero__media" aria-hidden="true">
      <!-- Two stacked copies of the same clip. Native loop cuts hard on
           whatever frame the source ends on; hero.js instead crossfades B in
           UNDER A a moment before A's loop point and hands playback off, so
           the restart is masked by a dissolve rather than seen as a cut.
           Both start with the source attached (see enableVideo in hero.js) —
           only one is ever visible at a time via .is-active. -->
      <video class="hero__video hero__video--a is-active" id="hero-video"
             muted playsinline autoplay preload="auto"
             tabindex="-1" disablepictureinpicture>
        <source data-src="assets/videos/hero-loop.mp4" type="video/mp4">
      </video>
      <!-- Copy B is only needed at the crossfade, ~9.4s in. preload="metadata"
           keeps it from racing copy A for bandwidth during first paint —
           with preload="auto" the page fetched the same clip twice up front,
           doubling the time before anything could play. hero.js calls load()
           on it once copy A is under way. -->
      <video class="hero__video hero__video--b" id="hero-video-b"
             muted playsinline preload="metadata"
             tabindex="-1" disablepictureinpicture>
        <source data-src="assets/videos/hero-loop.mp4" type="video/mp4">
      </video>
      <!-- No <noscript> poster fallback either: it would paint a still image
           in the hero, which is exactly what this hero must never show. With
           scripting off the sources are never promoted from data-src, so the
           hero simply stays on its own ground. -->
      <div class="hero__scrim"></div>
    </div>

    <!-- Editorial composition, bottom-anchored in one viewport.
         Deliberately NOT .shell: the reference runs its hero edge-to-edge on a
         full-bleed container with only a site margin, and a 1200px centred
         box would pull the headline off the frame edge and kill the layout.

         Two bands, both pushed to the floor by the layout's leading slack:
           1. .hero__annotations - small type, 12-col grid, wide empty gutter
           2. .hero__display     - the giant headline rows
         Everything above them is intentional empty space. -->
    <div class="hero__inner">

      <!-- Band 1. Two small blocks at opposite ends of a 12-column grid, as
           the reference sets its two hero paragraphs (span 3 left, span 5
           starting at column 8). The gap between them is the composition. -->
      <!-- Each annotation wraps its text in a mask span: the text slides in
           from the right inside the clip, as the reference reveals its two
           hero paragraphs, and slides back out horizontally on exit. -->
      <div class="hero__annotations">
        <!-- Stacked on its own lines, as the reference sets RETAIL /
             INDUSTRIAL / OFFICE. The <br>s are the composition, not wrapping:
             the reference breaks these deliberately rather than letting the
             column width decide. -->
        <p class="hero__label"><span class="hero__label-t">Maritime healthcare<br>&amp; claims<br>management</span></p>

        <p class="hero__note"><span class="hero__note-t">From the first call at sea<br>to the closed claim.</span></p>
      </div>

      <!-- Band 2. The display headline - THREE rows, each with its own
           alignment, so the block stretches across the viewport with real
           left/right tension instead of reading as a centred H1:

             WE MANAGE              (left)
             THE WHOLE              (left)
                       MEDICAL CASE (right)

           The H1 still contains the exact approved sentence, uncut and in
           order; the spans are line wrappers only. hero.js splits the text
           inside .hero__row-t into per-character spans at runtime for the
           scroll animation - it is NOT split in the markup, so the sentence
           a screen reader or a crawler sees stays whole. -->
      <h1 class="hero__display">
        <span class="hero__row hero__row--a"><span class="hero__row-t">Expanding</span></span>
        <!-- Row 2 carries TWO elements pushed to opposite edges, exactly as
             the reference sets "PROPERTY … KNOWS". That single split is what
             stretches the block across the full frame; a one-element row here
             collapses the composition back to a left-aligned stack. -->
        <span class="hero__row hero__row--b hero__row--split">
          <span class="hero__row-t">the horizon</span> <span class="hero__row-t hero__row-t--far">of</span>
        </span>
        <span class="hero__row hero__row--c hero__row--end"><span class="hero__row-t">maritime care</span></span>
      </h1>

      <!-- Band 2b. The SECOND display state.

           Same three-row skeleton, same alignment tension as the H1 above —
           it occupies the identical grid row and is laid out on top of it, so
           the swap is a crossfade-in-place, not a reflow.

           Row 3 is the only thing that changes after the swap: it cycles
           through the four positioning lines from the reference rail
           (01 SIMPLIFIED / 02 MANAGED END-TO-END / 03 OPTIMIZED /
           04 COMPLIANCE-READY). The phrases live in the markup, not in JS, so
           the copy is editable without touching script and a no-JS page still
           renders the first one.

           aria-hidden: the H1 above already carries the page's heading. This
           block is a decorative restatement, and announcing a headline that
           rewrites itself on a timer is exactly the kind of thing a screen
           reader should never be handed. -->
      <div class="hero__display hero__display--alt" id="hero-display-alt" aria-hidden="true">
        <span class="hero__row hero__row--a"><span class="hero__row-t">Crew</span></span>
        <span class="hero__row hero__row--b"><span class="hero__row-t">healthcare</span></span>
        <!-- The cycling row. Every phrase is stacked in the same cell; only
             one carries .is-current at a time. Absolute positioning on the
             non-current phrases is what keeps the row from growing to the
             height of four lines. -->
        <span class="hero__row hero__row--c hero__row--end hero__row--cycle">
          <span class="hero__cycle">
            <span class="hero__cycle-item is-current"><span class="hero__row-t">Simplified.</span></span>
            <span class="hero__cycle-item"><span class="hero__row-t">Managed end-to-end.</span></span>
            <span class="hero__cycle-item"><span class="hero__row-t">Optimized.</span></span>
            <span class="hero__cycle-item"><span class="hero__row-t">Compliance-ready.</span></span>
          </span>
        </span>
      </div>

      <!-- Band 3. The quiet footer rail: CTA at the left, metadata at the
           right. Secondary action is a text link, not a second button. -->
      <div class="hero__foot">
        <div class="hero__actions">
          <a class="btn btn--primary btn--onDeep hero__cta" href="#contact">Request a proposal</a>
          <a class="hero__cta-alt" href="services.html#process">See how a case runs <span aria-hidden="true">&rarr;</span></a>
        </div>

        <p class="hero__meta">
          <span>India</span>
          <span>Singapore</span>
          <span>UAE</span>
        </p>
      </div>
    </div>
  </section>

  <!-- 02 - The problem: six doubts .............................. -->
  <!-- Scroll-driven three-state composition. The section is the SCROLL TRACK
       (tall); .doubts__stage is the viewport-height frame that ScrollTrigger
       pins inside it. The theme-ground attributes stay on the outer section
       so the ground handoff still measures an unpinned, real layout box —
       pinning the section itself would hand the observer a box that no longer
       describes what is painted. See js/doubts.js for the choreography.

       Without JS the stage is not pinned and every state layer is visible and
       statically laid out, so the content reads as an ordinary section. -->
  <section class="doubts"
           data-theme-ground="--surface-page" data-theme-tier="light"
           aria-labelledby="doubts-h">
    <div class="doubts__stage">

      <!-- STATE 1 — split screen: the intro on the page ground at left, and a
           FILLED panel at right. On scroll the panel slides left and grows
           until it fills the section, and the whole composition is built on
           top of it.

           The panel is a sibling of .doubts__frame, not a child of the shell,
           because it must bleed to the viewport's edge while the intro beside
           it stays on the shell's measure — the same relationship the
           reference has. -->
      <!-- data-bar-ink="light" on the PANEL rather than on the section: the
           section's own ground is pale, but this gradient fill is deep navy
           and grows to cover the whole stage, so it — not the section — is
           what decides the header's ink here. isDeepUnderBar tests the
           panel's live left/right edges as it sweeps. -->
      <div class="doubts__panel" aria-hidden="true" data-bar-ink="light"></div>

      <!-- The statement is a sibling of the panel rather than a child of it,
           because it outlives state 1: it begins as the panel's headline and
           ends as a large faint watermark across the MIDDLE of the finished
           composition (the reference resolves its own statement to opacity
           0.1 behind the card grid). Parented to the stage, it keeps a fixed
           centre while the panel's own box animates underneath it. -->
      <p class="doubts__statement" aria-hidden="true">
        <span>Six</span><span>questions,</span><span>one</span><span>call.</span>
      </p>

      <div class="shell doubts__frame">

        <div class="doubts__split">
          <header class="section-head doubts__intro">
            <p class="eyebrow">The problem</p>
            <h2 class="section-title" id="doubts-h">
              The six questions that start every medical case at sea
            </h2>
            <p class="doubts__lede">
              Every crew medical case opens the same way: with doubt on the
              bridge and no one ashore who owns the answer. These six questions
              decide what the case costs – in hours, in money, and in outcome.
            </p>
          </header>
        </div>

        <!-- STATES 2 &amp; 3 — the six cards and the central image. The cards
             keep their list semantics; the grid places them in their FINAL
             (state 3) positions and GSAP transforms them back toward the
             centre for state 2, so the resting layout is the CSS one. -->
        <ol class="doubts__grid">
          <li class="doubt" data-doubt-slot="tl">
            <p class="doubt__num">01</p>
            <h3 class="doubt__title">Who do we call?</h3>
            <p class="doubt__body">
              It is 03:00 and the nearest coast station is out of VHF range. No one
              on board knows which number reaches a doctor.
            </p>
          </li>
          <li class="doubt" data-doubt-slot="tm">
            <p class="doubt__num">02</p>
            <h3 class="doubt__title">Is it serious?</h3>
            <p class="doubt__body">
              Chest pain, or indigestion after a long watch? Nobody aboard is
              qualified to tell the difference - and guessing wrong costs hours
              that matter.
            </p>
          </li>
          <li class="doubt" data-doubt-slot="tr">
            <p class="doubt__num">03</p>
            <h3 class="doubt__title">Do we divert?</h3>
            <p class="doubt__body">
              A diversion burns fuel, breaks the charter and costs days. Not
              diverting could cost a life. That call sits with the master, alone,
              at sea.
            </p>
          </li>
          <li class="doubt" data-doubt-slot="bl">
            <p class="doubt__num">04</p>
            <h3 class="doubt__title">Which port?</h3>
            <p class="doubt__body">
              The closest harbour is not always the one with a cardiac unit, a
              surgeon on duty, or clearance to take a foreign crew member ashore.
            </p>
          </li>
          <li class="doubt" data-doubt-slot="bm">
            <p class="doubt__num">05</p>
            <h3 class="doubt__title">Are we being overcharged?</h3>
            <p class="doubt__body">
              Once a hospital learns an employer is paying, prices move. We have
              seen consultation fees at three times the market rate and surgery
              quoted at nearly four.
            </p>
          </li>
          <li class="doubt" data-doubt-slot="br">
            <p class="doubt__num">06</p>
            <h3 class="doubt__title">Who chose this hospital?</h3>
            <p class="doubt__body">
              If the referral came from a vendor with a financial relationship
              rather than a clinical one, recovery takes longer and costs more -
              and nobody ashore finds out until the invoice arrives.
            </p>
          </li>
        </ol>

        <!-- The central image. Its FRAME is what animates (narrow strip ->
             dominant), never the <img> itself: the picture is sized to the
             frame's largest state and cropped by overflow, so widening the
             frame reveals more of the same undistorted photograph rather than
             stretching it. -->
        <figure class="doubts__media" aria-hidden="true">
          <img src="assets/problem.png" alt=""
               width="1280" height="720" loading="lazy" decoding="async">
        </figure>

      </div>

      <!-- THE PAYOFF LAYER — the About statement and the numbers, ON the
           revealed photograph.

           This is the reference hero's composition: a display statement
           held in the upper-left of the picture, and a row of figures
           ruled off along its floor. It lives INSIDE .doubts__media, not
           in a section of its own, because it is what the reveal is FOR:
           the picture opens and the claim is already standing on it.

           Not aria-hidden, unlike the figure it sits in — this is real
           content, and it is the only place it appears on the page (the
           old #about-intro section and the proof stat columns were folded
           in here). The <figure> therefore drops its aria-hidden and the
           decorative <img> carries alt="" as before.

           Nothing here is hidden in the markup: with JS off the frame is
           a normal static figure and this block renders under the
           picture as ordinary prose. js/doubts.js fades it up only once
           the frame has finished growing (see REVEAL_AT). -->
      <div class="doubts__reveal">
        <div class="doubts__revealInner">

          <!-- The statement group. A wrapper, not four loose flex
               children: .doubts__revealInner is space-between, so without
               it the eyebrow, title, lede and link would each be pushed to
               their own band down the frame instead of reading as one
               block held against the ceiling. -->
          <div class="doubts__revealTop">
          <p class="doubts__revealEyebrow">About MedShield</p>
          <!-- TWO LINES, not three. The statement stands on a photograph
               with a stats band beneath it, so every line it takes is a line
               of picture it covers - and the three-line version ran more than
               half the frame's height down the left side. The claim is the
               same one; what was the third line ("above a verified India-first
               network") is carried by the lede and by the figures below, which
               is where "1,800+ partner hospitals" and "45+ locations" already
               say it more concretely. -->
          <h2 class="doubts__revealTitle" id="about-intro-h">
            <span class="doubts__revealLine">One independent medical team</span>
            <span class="doubts__revealLine">decides your seafarer's care</span>
          </h2>

          <!-- Carries what the removed proof strip said in prose, plus the
               two figures from it that did not earn a slot in the band: ~10
               years serving the industry, and the three countries. -->
          <p class="doubts__revealLede">
            Ten years closing a gap the industry lived with: a certified,
            independent clinical team sitting above the provider network,
            with offices in India, Singapore and the UAE.
          </p>
          <a class="doubts__revealLink" href="about.html">Learn our story</a>
          </div>

          <!-- The stats band: the reference's floor row — big figure,
               small label beside it, ruled off from the picture above. -->
          <dl class="doubts__stats">
            <div class="doubts__stat">
              <dt class="doubts__statFigure">ISO&nbsp;45001</dt>
              <dd class="doubts__statLabel">Certified - first in India</dd>
            </div>
            <div class="doubts__stat">
              <dt class="doubts__statFigure">1,800<span class="doubts__statPlus">+</span></dt>
              <dd class="doubts__statLabel">Partner hospitals &amp; clinics</dd>
            </div>
            <div class="doubts__stat">
              <dt class="doubts__statFigure">130<span class="doubts__statPlus">+</span></dt>
              <dd class="doubts__statLabel">Subject matter experts</dd>
            </div>
            <div class="doubts__stat">
              <dt class="doubts__statFigure">45<span class="doubts__statPlus">+</span></dt>
              <dd class="doubts__statLabel">Locations across India</dd>
            </div>
            <div class="doubts__stat">
              <dt class="doubts__statFigure">24/7</dt>
              <dd class="doubts__statLabel">Medical desk</dd>
            </div>
          </dl>

        </div>
      </div>

    </div>
  </section>

  <!-- 03 - About .................................................. -->
  <!-- REMOVED as a section of its own. Its eyebrow and display statement now
       live INSIDE the problem section's revealed photograph
       (.doubts__reveal in section 02), together with the numbers that used to
       be the proof strip's two stat columns — the reference's composition,
       where the claim and the figures stand ON the image rather than in a
       band underneath it. #about-intro-h moved with the heading, so any
       in-page link to it still resolves. -->

  <!-- 04 - Proof strip ....................................... -->
  <!-- REMOVED, like the About section above it. Every figure it carried now
       stands on the problem section's revealed photograph (.doubts__stats),
       which is the whole point of that reveal: the numbers land ON the image
       rather than in a separate band of boxes underneath it. Its lede and
       "Learn our story" went the same way.

       The overlap still works with this section gone. .doubts-cover is a
       property of the COVER MECHANISM, not of whichever section follows -
       min-height: 100svh guarantees the next one (now Services) is at least
       as tall as the stage it slides over. -->

  <!-- 05 - Four services ........................................ -->
  <!-- Locked to exactly 100vh: the wordmark, the intro line and all four glass
       cards live inside one viewport. Everything below is sized in vh/vmin or
       clamp() against vh for that reason — a rem-based scale would overflow a
       short laptop viewport. No data-bar-ink: the ground is pure white. -->
  <section class="services" id="services" aria-labelledby="services-h">

    <!-- Two marks in the top-left corner, as in the reference. Decorative. -->
    <span class="services__dot" aria-hidden="true"></span>
    <span class="services__ring" aria-hidden="true"></span>

    <div class="services__inner">

      <!-- THE WORDMARK.
           Three words, deliberately overlapping, each its own positioned
           layer so they can interleave the way the reference does:
             WHAT  outline-only serif, hanging off the left edge
             WE    solid, heavy, sitting ON TOP of WHAT's right half
             DO    solid, heavy, dropped down and right, overlapping WE
           The h2 carries the accessible name; every word span is aria-hidden
           and the real string is in .u-visually-hidden, so a screen reader
           hears "What we do" once, not three fragmented words. -->
      <h2 class="services__wordmark" id="services-h">
        <span class="visually-hidden">What we do</span>

        <span class="services__w services__w--what" aria-hidden="true">
          <span class="services__wInner">WHAT</span>
        </span>
        <span class="services__w services__w--we" aria-hidden="true">
          <span class="services__wInner">WE</span>
        </span>
        <span class="services__w services__w--do" aria-hidden="true">
          <span class="services__wInner">DO</span>
        </span>
      </h2>

      <!-- Top-right block, in the same slot as the reference's paragraph.
           The WRAPPER is what holds the absolute position; the paragraph and
           the CTA below it stay in normal flow inside it, so the CTA sits
           directly under the last line of the sentence however that sentence
           wraps. -->
      <div class="services__aside">
        <p class="services__lede">
          We manage the whole crew medical case &ndash; from the first call at
          sea to the closed claim.
        </p>

        <!-- Deliberately a text link and not a .btn: a filled button up here
             would compete with the wordmark for first fixation, and the
             section's real conversion point is the closing band. This is the
             quiet "and if you want to talk now" exit. -->
        <a class="services__cta" href="#contact">
          Request a proposal
          <span class="services__ctaArrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- The reference's four ruled columns become our four glass cards, in
           the same slot and the same 4-across rhythm.

           Order is deliberate: claims first. Leading with telemedicine would
           confirm the visitor's assumption that this is a remote-doctor service.

           Copy is TRIMMED against the full section elsewhere on the page: at
           100vh a card can hold a promise and a scope line, not a paragraph.
           The long-form descriptions are not deleted from the site — they are
           what the detail sections carry. Cards must not scroll internally. -->
      <ol class="services__grid">
        <li class="service" id="claims">
          <span class="service__sheen" aria-hidden="true"></span>
          <p class="service__num">01</p>
          <h3 class="service__title">Claims management</h3>
          <p class="service__get">
            A claim documented from the first hour, so it settles instead of
            being disputed.
          </p>
          <ul class="service__list">
            <li>Incident documentation</li>
            <li>Evidence collection</li>
            <li>Employer negotiation</li>
            <li>Final settlement</li>
          </ul>
        </li>

        <li class="service" id="advisory">
          <span class="service__sheen" aria-hidden="true"></span>
          <p class="service__num">02</p>
          <h3 class="service__title">Claims advisory &amp; legal</h3>
          <p class="service__get">
            A defensible position before a case becomes a liability.
          </p>
          <ul class="service__list">
            <li>Medical &amp; disability review</li>
            <li>Obligation assessment</li>
            <li>MLC &amp; ILO alignment</li>
            <li>Medico-legal mediation</li>
          </ul>
        </li>

        <li class="service" id="budgeting">
          <span class="service__sheen" aria-hidden="true"></span>
          <p class="service__num">03</p>
          <h3 class="service__title">Medical welfare budgeting</h3>
          <p class="service__get">
            A crew medical spend you can forecast at budget time and defend at
            year end.
          </p>
          <ul class="service__list">
            <li>Fleet needs assessment</li>
            <li>Preventive care budgeting</li>
            <li>Evacuation contingency</li>
            <li>Data-driven forecasting</li>
          </ul>
        </li>

        <li class="service" id="telemedicine">
          <span class="service__sheen" aria-hidden="true"></span>
          <p class="service__num">04</p>
          <h3 class="service__title">Telemedicine</h3>
          <p class="service__get">
            A doctor on the line before the master has to make a diversion call
            alone.
          </p>
          <ul class="service__list">
            <li>24/7 licensed doctors</li>
            <li>Video consultation</li>
            <li>Wearable diagnostics</li>
            <li>Diversion avoidance</li>
          </ul>
        </li>
      </ol>
    </div>
  </section>

  <!-- 06 - How our case runs ..................................... -->
  <!-- THE MECHANIC, taken from the reference interaction and nothing else.

       The section is NOT scroll-jacked and NOT a carousel. Three parts:

       1. THE HEADER (.process__header) — eyebrow + section title, scrolls
          normally, stays put in the flow. It is the first thing the reader
          meets and it does not move or change.

       2. THE PINNED VISUAL (.process__camera, inside .process__pinWrap) —
          ONE frame that becomes position:fixed for the length of the stage
          list and holds absolutely still in the same spot while the reader
          scrolls the whole list past it. The scene INSIDE it transforms
          stage to stage; the frame itself never moves, slides or is
          replaced. It releases at the end of the list and resumes normal
          flow, which is what hands off cleanly into the morph that follows.

       3. THE STAGE LIST (.process__list) — all five stages exist in the DOM
          at once as an ordinary list and scroll past at normal speed. They
          are NOT swapped in and out of one slot. What changes is only their
          EMPHASIS: each stage's title is split into letters, and those
          letters brighten from dim to full progressively, left to right, as
          that stage crosses the reading line, then dim again once it has
          passed. That progressive per-letter read-through is the left-hand
          movement — see js/process-stages.js.

       .process__camera keeps its old contract for the hand-off into Case
       studies (process-to-cases.js turns it into a clipping camera at the
       very end) — only what is inside it is new. -->
  <section class="process" id="process" aria-labelledby="process-h">

    <!-- 1. THE HEADER. Ordinary flow, never pinned, never animated. -->
    <div class="shell process__header">
      <p class="eyebrow process__eyebrow">How our case runs</p>
      <h2 class="section-title process__title" id="process-h">
        One case, five stages, one point of contact
      </h2>
    </div>

    <!-- THE STAGE AREA. Position:relative so the pinned visual has a box to
         be measured and released against. -->
    <div class="process__body">
      <div class="shell process__bodyShell">

        <!-- 2. THE PINNED VISUAL.
             .process__pinWrap reserves the column; .process__camera is what
             JS pins. Only this element is ever fixed — the list beside it is
             untouched, ordinary, scrolling content. -->
        <div class="process__pinWrap">
          <div class="process__camera">
            <!-- THE CAPTION PREVIEW. Unchanged contract — see
                 process-to-cases.js and style.css. -->
            <div class="process__captionPreview" aria-hidden="true">
              <div class="process__captionPreview-inner">
              <span class="process__captionPreview-num">01</span>
              <span class="process__captionPreview-scope">Cost optimisation &ndash; India</span>
              <span class="process__captionPreview-title">Reversing a hospital's 3&times; pricing once it learned an employer was paying</span>
              <span class="process__captionPreview-figure"><span class="process__captionPreview-figureNum">66%</span> total claim reduced</span>
              </div>
            </div>

            <div class="process__frame">
              <div class="process__sceneWrap">

                <!-- THE FIVE STAGE PHOTOGRAPHS.

                     One photograph per stage, all five stacked in the same
                     box and cross-dissolved by opacity alone — the contract
                     js/process-stages.js writes to. They are in stage order:
                     1 case reported, 2 medical assessment, 3 care
                     coordination, 4 treatment & monitoring, 5 case closed.

                     The frame carries the pictures' own 16/9 ratio and they
                     are shown whole with object-fit:contain — nothing is
                     cropped out of any of the five. -->

                <!-- STAGE 01 - CASE REPORTED -->
                <div class="process__sceneStage" data-scene="0">
                  <img src="assets/how case runs/1.png"
                       alt="A ship's officer calling Medshield from the bridge the moment a medical case happens."
                       loading="eager" decoding="async">
                </div>

                <!-- STAGE 02 - MEDICAL ASSESSMENT -->
                <div class="process__sceneStage" data-scene="1">
                  <img src="assets/how case runs/2.png"
                       alt="A nurse examining a crew member with a stethoscope in the ship's medical room."
                       loading="lazy" decoding="async">
                </div>

                <!-- STAGE 03 - CARE COORDINATION -->
                <div class="process__sceneStage" data-scene="2">
                  <img src="assets/how case runs/3.png"
                       alt="A Medshield coordinator on a video call with a doctor, vessel and hospital linked on screen."
                       loading="lazy" decoding="async">
                </div>

                <!-- STAGE 04 - TREATMENT & MONITORING -->
                <div class="process__sceneStage" data-scene="3">
                  <img src="assets/how case runs/4.png"
                       alt="A nurse taking a crew member's blood pressure with vitals shown on the monitor beside them."
                       loading="lazy" decoding="async">
                </div>

                <!-- STAGE 05 - CASE CLOSED -->
                <div class="process__sceneStage" data-scene="4">
                  <img src="assets/how case runs/5.png"
                       alt="A recovered crew member and nurse talking beside a Case Closed notice."
                       loading="lazy" decoding="async">
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- 3. THE STAGE LIST. All five present at once, ordinary scrolling
             content. Each .process__stageTitle is split into per-letter spans
             by js/process-stages.js and lit progressively as the item crosses
             the reading line. The dashed rule and the eyebrow above each item
             match the reference's own item furniture. -->
        <ol class="process__list">
          <li class="process__item" data-stage="0">
            <p class="process__itemEyebrow">Stage 01</p>
            <h3 class="process__itemTitle" data-split>Case reported</h3>
            <p class="process__itemBody">
              An onboard medical case reaches Medshield the moment it happens
              &mdash; one call, answered at any hour, from anywhere the vessel is.
            </p>
          </li>
          <li class="process__item" data-stage="1">
            <p class="process__itemEyebrow">Stage 02</p>
            <h3 class="process__itemTitle" data-split>Medical assessment</h3>
            <p class="process__itemBody">
              A medical professional reviews the case with the crew member
              directly &mdash; symptoms, history and urgency, assessed before
              anything is decided.
            </p>
          </li>
          <li class="process__item" data-stage="2">
            <p class="process__itemEyebrow">Stage 03</p>
            <h3 class="process__itemTitle" data-split>Care coordination</h3>
            <p class="process__itemBody">
              Medshield coordinates the right medical support &mdash; connecting
              ship, provider and hospital so the right care is already arranged.
            </p>
          </li>
          <li class="process__item" data-stage="3">
            <p class="process__itemEyebrow">Stage 04</p>
            <h3 class="process__itemTitle" data-split>Treatment &amp; monitoring</h3>
            <p class="process__itemBody">
              Treatment proceeds under continuous oversight, with progress
              tracked and the employer kept informed throughout.
            </p>
          </li>
          <li class="process__item" data-stage="4">
            <p class="process__itemEyebrow">Stage 05</p>
            <h3 class="process__itemTitle" data-split>Case closed</h3>
            <p class="process__itemBody">
              Care completed. Documentation completed. The case closes with a
              full record, nothing left open.
            </p>
          </li>
        </ol>

      </div>
    </div>
  </section>

  <!-- 06b - The transition from "How a case runs" into "Case studies" ......
       A SPACER ONLY. It owns no content and no visuals whatsoever.

       The thing that travels is not in here: it is #process's own .shell —
       the actual, visible composition with its heading and all eight cards.
       #process is what gets pinned, and that real element is what shrinks and
       drops into the featured case card. Nothing is cloned, restated or
       stood in for, so what the reader watches land in the centre card is
       literally the same DOM they were just reading.

       This section exists only so the pin has somewhere to put its spacer:
       the extra scroll distance is claimed HERE, which is what keeps
       #process's own layout untouched and #case-studies a real, ordinarily
       scrollable section.

       Inert without JS: display:none until process-to-cases.js adds
       .p2c--live. -->
  <section class="p2c" aria-hidden="true"></section>

  <!-- 07 - Case studies ......................................... -->
  <!-- EDITORIAL INDEX, three zones on desktop:

         LEFT   the display heading and its supporting line, on the page grid
         CENTRE one tall featured case (01) - the destination the transition
                stage morphs the final process visual into
         RIGHT  three compact supporting cases (02-04), stacked

       The centre card and the transition morph are measured against each
       other at runtime, so at the end of the transition the morph is sitting
       exactly where the real card is and the handover is invisible.
       .cases__featured is the element process-to-cases.js measures - never
       restyle one of the two without checking the other. -->
  <section class="cases" id="case-studies" aria-labelledby="cases-h">
    <!-- NOT A RISING LAYER, despite the name (kept only so nothing has to be
         restructured for a naming change).

         There used to be a large translateY tween here that pulled the whole
         Case studies composition up from below the fold. It is gone: Case
         studies sits in its own ordinary document position, immediately under
         the pinned #process, from the moment the pin engages — see the
         removed riseDistance() note in process-to-cases.js. This wrapper now
         carries no transform at any point and is functionally a plain div.
         The reveal is done entirely by #process.is-morphing's clip opening
         above it (see .p2c--live / the mask relationship in style.css) plus a
         small opacity/15px settle on the heading and cards themselves. -->
    <div class="cases__rise">
    <div class="shell cases__layout">

      <!-- LEFT RAIL ------------------------------------------------------ -->
      <header class="section-head cases__head">
        <p class="eyebrow">How we can help</p>
        <h2 class="section-title cases__display" id="cases-h">Case<br>studies</h2>
        <p class="cases__lede">
          What happens when a case runs this way. Four findings from two
          investigations &ndash; every figure taken verbatim from the case files.
        </p>
        <!-- Both cases are anonymised (no vessel, company or individual named).
             Written sign-off is still required before publishing - see README. -->
        <p class="cases__confirm">
          <span class="confirm">[CONFIRM: client sign-off]</span>
          Both cases are anonymised, but written clearance and confirmation of the
          savings figures are required before this section goes live.
        </p>
      </header>

      <!-- CENTRE - the featured case -------------------------------------- -->
      <!-- THE DESTINATION SLOT.

           This card's BOX is what process-to-cases.js measures and flies the
           real process composition into. Its CONTENT (.case__reveal) is held
           back until that composition has actually landed here, so there is
           never a second featured card sitting underneath the incoming one to
           cross-fade with — the frame the reader ends up looking at is the
           one that travelled. See the .cases--awaiting rules in style.css. -->
      <article class="case case--featured cases__featured">
        <!-- NO MEDIA PLATE. The featured card carries text only.

             This card used to hold its own copy of assets/process/8.webp —
             the same photograph the final process view already contains — so
             throughout the morph there were two identical images on screen:
             the real one riding inside the shrinking camera, and this one
             sitting in the destination waiting for it. That is what made the
             transition read as two objects meeting rather than one becoming
             the other.

             The visual is supplied by .process__camera, which physically
             lands in this card's geometry. What lives here is only what the
             camera cannot bring with it: the case number, scope, title,
             figure and the disclosure. Those fade up once the camera has
             arrived, INSIDE the frame it is already occupying. -->
        <div class="case__reveal">
        <div class="case__inner">
          <p class="case__num">01</p>
          <p class="case__scope">Cost optimisation &ndash; India</p>
          <h3 class="case__title">Reversing a hospital's 3&times; pricing once it
            learned an employer was paying</h3>
          <p class="case__figure"><span class="case__figureNum">66%</span> total claim reduced</p>
          <details class="case__more">
            <summary class="case__toggle">Read the case <span class="case__arrow" aria-hidden="true">&rarr;</span></summary>
            <dl class="case__body">
              <dt>The problem</dt>
              <dd>Once the hospital learned an employer's plan was covering the
                seafarer, consultation fees were billed at 3&times; market rate,
                pre-habilitation therapy at 2.5&times;, and surgery quoted at
                3.8&times; &ndash; charges applied across every stage of care.</dd>
              <dt>What we found</dt>
              <dd>Charging 1.5&times; to 10&times; the market average is an
                unregulated practice across Indian and Asian healthcare. The
                pre-habilitation therapy was outsourced to a third party inside
                the hospital's premises, with the hospital's margin added on top.</dd>
              <dt>What we did</dt>
              <dd>Negotiated rates back to market using our provider network,
                referred the seafarer to independent pre-habilitation specialists
                outside the hospital's margin, and monitored every line against
                the negotiated rate through to settlement.</dd>
              <dt>Result</dt>
              <dd>Surgery reduced from <strong>INR 7.75 lakh to INR 2.55 lakh</strong>
                inclusive of food, supplements and additional services.
                Consultation fees down 65%, rehabilitation down 60%, and the total
                claim reduced by <strong>over 66%</strong>.</dd>
            </dl>
          </details>
        </div>
        <!-- Full-width bar pinned to the foot of the plate, as in the
             reference composition. Inside .case__reveal, so it is not on
             screen while the camera is still travelling. -->
        <a class="case__cta" href="#contact">
          <span>Read the full case</span>
          <span class="case__cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
        </div>
      </article>

      <!-- RIGHT - three supporting findings -------------------------------
           02-04 are discrete verified findings from inside the same two
           investigations, so they are static by design and carry no arrow. -->
      <ol class="cases__support">
        <li class="case case--support">
          <article class="case__inner">
            <p class="case__num"><span class="case__chip" aria-hidden="true"></span>02</p>
            <h3 class="case__title">Surgery re-quoted from INR&nbsp;7.75&nbsp;lakh down to INR&nbsp;2.55&nbsp;lakh</h3>
            <p class="case__result">Negotiated against market rate &mdash;
              <span class="case__figureNum">3.8&times;</span> inflation removed</p>
            <!-- Decorative line-art plate. aria-hidden and pointer-events:none:
                 it carries no information the copy does not already state. -->
            <span class="case__art" aria-hidden="true">
              <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M60 14 88 30v34L60 80 32 64V30Z" stroke-dasharray="3 4"/>
                <path d="M60 14v66M32 30l28 16 28-16"/>
                <circle cx="60" cy="46" r="9" stroke-dasharray="2 3"/>
                <path d="M26 92h68M34 102h52" stroke-dasharray="3 4"/>
              </svg>
            </span>
          </article>
        </li>

        <li class="case case--support">
          <article class="case__inner">
            <p class="case__num"><span class="case__chip" aria-hidden="true"></span>03</p>
            <h3 class="case__title">Rehabilitation moved to independent specialists</h3>
            <p class="case__result">Provider referral &mdash;
              <span class="case__figureNum">60%</span> therapy cost reduction</p>
            <span class="case__art" aria-hidden="true">
              <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M60 96V44" />
                <path d="M60 62c0-12 9-22 21-24-1 13-9 22-21 24Z" stroke-dasharray="3 4"/>
                <path d="M60 54c0-11-8-20-19-22 1 12 8 20 19 22Z" stroke-dasharray="3 4"/>
                <path d="M42 96h36l-5 12H47Z" stroke-dasharray="2 3"/>
                <path d="M30 108h60"/>
              </svg>
            </span>
          </article>
        </li>

        <li class="case case--support">
          <article class="case__inner">
            <p class="case__num"><span class="case__chip" aria-hidden="true"></span>04</p>
            <h3 class="case__title">Consultation fees brought back in line with market rates</h3>
            <p class="case__result">Cost negotiation &mdash;
              <span class="case__figureNum">65%</span> fees reduced</p>
            <span class="case__art" aria-hidden="true">
              <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <rect x="38" y="20" width="44" height="80" rx="5" stroke-dasharray="3 4"/>
                <path d="M48 38h24M48 52h24M48 66h14"/>
                <circle cx="60" cy="88" r="5" stroke-dasharray="2 3"/>
                <path d="M92 44l14 10-14 10" stroke-dasharray="2 3"/>
              </svg>
            </span>
          </article>
        </li>
      </ol>

    </div>
    </div>
  </section>

  <!-- 08 - Why MedShield ........................................ -->
  <!-- Editorial split: a fixed left rail (eyebrow, heading, the four support
       points, the "what we are not" answer), a fixed headline block top-right,
       and a three-up card carousel anchored to the LOWER-RIGHT quadrant. Only
       the carousel moves — the rail and headline never translate. Card content
       is unchanged from the previous five-across grid; only its layout,
       styling and motion are new. -->
  <section class="why" id="why" aria-labelledby="why-h">
    <div class="shell why__layout">

      <!-- LEFT RAIL — fixed. Never animates. -->
      <div class="why__rail">
        <p class="eyebrow">Why MedShield</p>
        <h2 class="why__rail-title" id="why-h">Why<br>us</h2>

        <ul class="why__points">
          <li>Lower medical &amp; operational spend</li>
          <li>Fewer disputed claims</li>
          <li>Faster return to work</li>
          <li>One secure record per seafarer</li>
          <li>Crew who feel looked after</li>
        </ul>

        <!-- Deliberately a distinct block: this paragraph tells a superintendent
             he does not have to displace an incumbent vendor to hire MedShield -
             the most common procurement objection in this category. -->
        <aside class="notus">
          <span class="notus__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 8 3.5v5c0 6-3.5 9.5-8 11.5-4.5-2-8-5.5-8-11.5v-5Z"/></svg>
          </span>
          <div>
            <h3 class="notus__title">What we are not.</h3>
            <p class="notus__body">
              Not a hospital, a clinic, a pharmacy or an insurer. Not a cruise booking
              company, a medical tourism agency or a crew recruiter. We are the
              independent case owner from incident to outcome.
            </p>
          </div>
        </aside>
      </div>

      <!-- TOP RIGHT — fixed headline. Never animates. -->
      <header class="why__head">
        <h2 class="why__display">What changes when you<br>bring MedShield onboard.</h2>
        <p class="why__lede">
          One accountable partner. One complete record. Outcomes that land on both
          sides &mdash; a lower cost of care for the owner, a better-handled
          recovery for the seafarer.
        </p>
      </header>

      <!-- BOTTOM RIGHT — the carousel. Three cards visible of nine, advancing
           left on a loop. Cards 01-05 are the operational case for MedShield;
           06-09 are the business outcomes that follow from it, each written so
           the owner's benefit and the seafarer's benefit sit in the same card.
           The viewport clips; why.js drives it and is card-count agnostic. -->
      <div class="why__carousel" data-why-carousel>
        <div class="why__viewport">
          <div class="why__track">
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6M9 11h3"/></svg>
            </span>
            <p class="why-card__num">01</p>
            <h3 class="why-card__title">Lower medical spend</h3>
            <p class="why-card__body">Treatment costed and approved against pre-negotiated rates before delivery.</p>
            <ul class="why-card__list">
              <li>Cost assurance</li>
              <li>Rate benchmarking</li>
              <li>Pre-approval validation</li>
              <li>Savings you can measure</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <p class="why-card__num">02</p>
            <h3 class="why-card__title">Fewer disputed claims</h3>
            <p class="why-card__body">The file is complete from hour one, not reconstructed at settlement.</p>
            <ul class="why-card__list">
              <li>Complete documentation</li>
              <li>Evidence integrity</li>
              <li>Clear liability position</li>
              <li>Stronger defensibility</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.25"/><path d="M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6"/><circle cx="18" cy="8.5" r="2.5"/><path d="M16 14.2c2.9.4 5 2.5 5 5.3"/></svg>
            </span>
            <p class="why-card__num">03</p>
            <h3 class="why-card__title">Faster decisions</h3>
            <p class="why-card__body">A doctor and a case manager on the same call.</p>
            <ul class="why-card__list">
              <li>Live case collaboration</li>
              <li>Medical &amp; legal alignment</li>
              <li>Faster approvals</li>
              <li>Quicker resolutions</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 8 3.5v5c0 6-3.5 9.5-8 11.5-4.5-2-8-5.5-8-11.5v-5Z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <p class="why-card__num">04</p>
            <h3 class="why-card__title">Regulatory confidence</h3>
            <p class="why-card__body">MLC and ILO obligations documented as the case runs.</p>
            <ul class="why-card__list">
              <li>MLC &amp; ILO compliance</li>
              <li>Audit-ready records</li>
              <li>Regulatory alignment</li>
              <li>Full traceability</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6Z"/></svg>
            </span>
            <p class="why-card__num">05</p>
            <h3 class="why-card__title">One record per seafarer</h3>
            <p class="why-card__body">Across vessels, ports and years.</p>
            <ul class="why-card__list">
              <li>Centralised record</li>
              <li>Portability across ships</li>
              <li>History that travels</li>
              <li>Continuity of care</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.4-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5C19 16.6 12 21 12 21Z"/><path d="M2 12h3l1.5-2.5L8 14l1.5-2H11"/></svg>
            </span>
            <p class="why-card__num">06</p>
            <h3 class="why-card__title">Enhanced crew satisfaction</h3>
            <p class="why-card__body">Crew see their care handled promptly. Owners get a retention argument that costs no wage rise.</p>
            <ul class="why-card__list">
              <li>Confidence in care</li>
              <li>One point of contact</li>
              <li>Stronger crew retention</li>
              <li>Employer of choice</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/><path d="M12 14.5v2.5"/></svg>
            </span>
            <p class="why-card__num">07</p>
            <h3 class="why-card__title">Data held securely</h3>
            <p class="why-card__body">Crew medical information handled to GDPR and HIPAA standards where applicable.</p>
            <ul class="why-card__list">
              <li>GDPR &amp; HIPAA aligned</li>
              <li>Controlled access</li>
              <li>Consent handled properly</li>
              <li>Lower breach exposure</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v4.5h-4.5"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <p class="why-card__num">08</p>
            <h3 class="why-card__title">Faster return to work</h3>
            <p class="why-card__body">Treatment monitored and fitness-to-work coordinated, closing the gap to sign-on.</p>
            <ul class="why-card__list">
              <li>Structured case management</li>
              <li>Fewer delays to repatriation</li>
              <li>Shorter time off-hire</li>
              <li>Earnings resume sooner</li>
            </ul>
          </article>
          <article class="why-card">
            <span class="why-card__sheen" aria-hidden="true"></span>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16"/><path d="M7 19V9"/><path d="M12 19V5"/><path d="M17 19v-6"/><path d="m15 9 3-3 3 3"/></svg>
            </span>
            <p class="why-card__num">09</p>
            <h3 class="why-card__title">Lower operational cost</h3>
            <p class="why-card__body">One case team replaces overseas coordinators kept on standby for crew healthcare.</p>
            <ul class="why-card__list">
              <li>No standby overseas teams</li>
              <li>Fixed, predictable cost</li>
              <li>Less admin per case</li>
              <li>Specialists without headcount</li>
            </ul>
          </article>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 09 - The people ........................................... -->
  <section class="people" id="about" aria-labelledby="people-h">
    <div class="shell people__layout">

      <!-- A headline and one line. The rail sits beside the faces, so it can
           only carry the single claim that matters; the detail belongs on an
           inner team page. -->
      <div class="people__rail">
        <p class="people__tier">The people</p>
        <p class="people__note">
          Medically qualified founders who run the case desk themselves.
        </p>
      </div>

      <div class="people__main">
        <h2 class="people__title" id="people-h">
          Get to know the people<br>who handle your case.
        </h2>

        <!-- Name and role only. A face plus a title is what establishes who is
             accountable; the full biog
             
             
             raphies belong on an inner team page,
             where they can run long without costing the homepage its scroll. -->
        <ul class="roster">
          <li class="roster__item">
            <div class="roster__portrait">
              <picture>
                <source type="image/webp"
                        srcset="assets/people/desikan.webp 560w, assets/people/desikan@2x.webp 1120w"
                        sizes="(min-width: 900px) 30vw, 45vw">
                <img src="assets/people/desikan.jpg"
                     srcset="assets/people/desikan.jpg 560w, assets/people/desikan@2x.jpg 1120w"
                     sizes="(min-width: 900px) 30vw, 45vw"
                     alt="Dr. Desikan Setlur, founder and chief executive of MedShield."
                     width="560" height="700" loading="lazy" decoding="async">
              </picture>
            </div>
            <p class="roster__name">Dr. Desikan Setlur</p>
            <p class="roster__role">Founder and CEO</p>
          </li>

          <li class="roster__item">
            <div class="roster__portrait">
              <picture>
                <source type="image/webp"
                        srcset="assets/people/princi.webp 560w, assets/people/princi@2x.webp 1120w"
                        sizes="(min-width: 900px) 30vw, 45vw">
                <img src="assets/people/princi.jpg"
                     srcset="assets/people/princi.jpg 560w, assets/people/princi@2x.jpg 1120w"
                     sizes="(min-width: 900px) 30vw, 45vw"
                     alt="Dr. Princi Singh, co-founder and chief operating officer of MedShield."
                     width="560" height="700" loading="lazy" decoding="async">
              </picture>
            </div>
            <p class="roster__name">Dr. Princi Singh</p>
            <p class="roster__role">Co-founder and COO</p>
          </li>
        </ul>

        <!-- Nine teams, not nine individuals. The ten individual doctor bios in
             the client folder belong on that same inner team page: on the
             homepage they cost scroll and date quickly as people move. -->
        <div class="panel">
          <div class="panel__head">
            <h3 class="panel__title">The SME panel</h3>
            <p class="panel__sub">130+ experts, nine disciplines</p>
          </div>
          <ul class="panel__list">
            <li>Maritime medical specialists and super-specialists</li>
            <li>Telemedicine</li>
            <li>Healthcare and claims</li>
            <li>Clinical findings correlation</li>
            <li>Treatment plan analysis</li>
            <li>Global pharmacology</li>
            <li>Occupational preventive health</li>
            <li>Medico-legal and arbitration</li>
            <li>Technology, 24/7</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- 10 - Closing CTA band ..................................... -->
  <section class="cta-band" aria-labelledby="cta-h">
    <div class="shell cta-band__inner">
      <!-- Three columns on desktop: the statement carries the band, the one
           line of copy sits in the middle, and the single action closes it on
           the right as an underlined arrow link rather than a button pair. -->
      <h2 class="cta-band__title" id="cta-h">Let's take<br>the next case.</h2>
      <p class="cta-band__sub">
        If this is how you want your crew cases handled &ndash; send us your
        fleet profile and we'll come back with a proposal.
      </p>
      <a class="cta-band__link" href="#contact">
        Reach out to us
        <span class="cta-band__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- 11 - Contact + form ....................................... -->
  <section class="contact" id="contact" aria-labelledby="contact-h">
    <!-- The tinted ground is this panel, not the section, so hero.js can scrub
         --cta-p as the section scrolls through and pull the side gutters open.

         Layout follows the reference's contact block: the statement sits in
         the left column and the form occupies the right. Everything else —
         colour, type, field copy — stays ours.

         No data-bar-ink here: the panel is a LIGHT ground, so the header keeps
         its dark ink over it. It carried the marker while the panel was navy. -->
    <div class="contact__panel">
      <div class="shell contact__inner">

        <div class="contact__intro">
          <p class="eyebrow">Request a proposal</p>
          <h2 class="contact__title" id="contact-h">Your next medical case is already at sea</h2>
          <p class="contact__lede">
            Send us your fleet profile and we will come back with a coverage proposal
            and an indicative annual medical welfare budget.
          </p>

          <aside class="emergency" aria-labelledby="emergency-h">
            <h3 class="emergency__title" id="emergency-h">Medical emergency at sea right now?</h3>
            <p class="emergency__body">
              Do not use this form. Call
              <strong class="confirm">[CONFIRM: 24/7 number]</strong>
              - answered by a coordinator, any hour.
            </p>
            <p class="emergency__note">
              This number is not yet published. It must ring a monitored line before launch.
            </p>
          </aside>
        </div>

        <div class="contact__formwrap">

          <!-- Underline fields, no boxes, matching the reference. The <label>
               is kept on every control rather than being replaced by a
               placeholder: the reference leans on placeholder-as-label, which
               leaves a screen reader with an unnamed input and wipes the field
               name the moment you type. Ours renders in the same position and
               at the same weight, then rises out of the way on focus/fill, so
               it reads identically and still names the field. -->
          <form class="form" id="proposal-form" novalidate>

            <div class="field">
              <input type="text" id="f-name" name="name" autocomplete="name" required
                     placeholder=" " aria-describedby="e-name">
              <label for="f-name">Name</label>
              <p class="field__error" id="e-name" hidden></p>
            </div>

            <div class="field">
              <input type="text" id="f-company" name="company" autocomplete="organization" required
                     placeholder=" " aria-describedby="e-company">
              <label for="f-company">Company</label>
              <p class="field__error" id="e-company" hidden></p>
            </div>

            <div class="field">
              <input type="email" id="f-email" name="email" autocomplete="email" required
                     placeholder=" " aria-describedby="e-email">
              <label for="f-email">Work email</label>
              <p class="field__error" id="e-email" hidden></p>
            </div>

            <!-- Selects carry a permanent label: there is no empty state to
                 float back down into once a value is chosen. -->
            <div class="field field--select">
              <label for="f-fleet">Fleet size</label>
              <select id="f-fleet" name="fleet" required aria-describedby="e-fleet">
                <option value="">Select…</option>
                <option>1–5</option>
                <option>6–20</option>
                <option>21–50</option>
                <option>50+</option>
              </select>
              <p class="field__error" id="e-fleet" hidden></p>
            </div>

            <div class="field field--select">
              <label for="f-vessel">Vessel type</label>
              <select id="f-vessel" name="vessel" required aria-describedby="e-vessel">
                <option value="">Select…</option>
                <option>Cruise</option>
                <option>Cargo</option>
                <option>Offshore</option>
                <option>Yacht</option>
                <option>Mixed</option>
              </select>
              <p class="field__error" id="e-vessel" hidden></p>
            </div>

            <!-- Field 6 of the seven CONTENT.md specifies. Optional on
                 purpose: it flags displacement (they already pay someone) vs.
                 first purchase, which changes how the proposal is written,
                 without making the visitor disclose a supplier to get a
                 quote. -->
            <div class="field field--select">
              <label for="f-current">Current arrangement <span class="field__opt">(optional)</span></label>
              <select id="f-current" name="current">
                <option value="">Select…</option>
                <option>In-house</option>
                <option>Another provider</option>
                <option>None yet</option>
              </select>
            </div>

            <!-- The reference's inline "select all that apply" row, carrying
                 our four actual revenue lines in the order section 05 uses.
                 Claims leads deliberately: CONTENT.md notes that leading with
                 telemedicine confirms the visitor's wrong assumption that
                 MedShield is another remote-doctor service. Optional – it
                 routes the enquiry, it does not qualify it. -->
            <fieldset class="checks">
              <legend class="checks__legend">Interested in (optional)</legend>
              <div class="checks__row">
                <!-- Visible labels are the short forms so the four sit on ONE
                     line; the submitted value keeps the full service name. -->
                <label class="check">
                  <input type="checkbox" name="interest" value="Claims management">
                  <span>Claims</span>
                </label>
                <label class="check">
                  <input type="checkbox" name="interest" value="Claims advisory &amp; legal">
                  <span>Advisory</span>
                </label>
                <label class="check">
                  <input type="checkbox" name="interest" value="Medical welfare budgeting">
                  <span>Budgeting</span>
                </label>
                <label class="check">
                  <input type="checkbox" name="interest" value="Telemedicine">
                  <span>Telemedicine</span>
                </label>
              </div>
            </fieldset>

            <div class="field">
              <textarea id="f-message" name="message" rows="3" placeholder=" "></textarea>
              <label for="f-message">Anything else to share? <span class="field__opt">(optional)</span></label>
            </div>

            <!-- Honeypot: not a CAPTCHA. Hidden from users and assistive tech. -->
            <div class="hp" aria-hidden="true">
              <label for="f-role">Do not fill this in</label>
              <input type="text" id="f-role" name="role" tabindex="-1" autocomplete="off">
            </div>

            <!-- The reference ends on a bare right-aligned "SEND ↗" rather than
                 a filled button. Kept as a real <button> so it stays keyboard
                 and screen-reader operable. -->
            <div class="form__send">
              <button class="send" type="submit">
                Send <span class="send__arrow" aria-hidden="true">&#8599;</span>
              </button>
            </div>

            <p class="form__foot">
              We use these details to prepare your proposal. No newsletter, no list.
            </p>
          </form>

          <!-- Success state replaces the form in place. No redirect. -->
          <div class="success" id="form-success" hidden tabindex="-1" role="status">
            <p class="success__mark" aria-hidden="true">✓</p>
            <h3 class="success__title">Received.</h3>
            <p class="success__body">A case manager will reply within one business day.</p>
          </div>

        </div>
      </div>
    </div>
  </section>

</main>

<!-- Footer. Structure follows the obscurastudio.webflow.io reference: one
     12-column grid, a tall gap between the link band and the bottom band, the
     statement/contact block anchored bottom-left of the top row and the link
     columns pushed hard right, then an oversized wordmark spanning all twelve
     columns as the closing gesture. Content, palette and type are ours; the
     reference contributed only the arrangement.

     The reference opens with a "let's build something" CTA band. We do not
     repeat that here — the contact form is the section directly above, so a
     second CTA would ask twice. The one-line invitation lives inside the
     statement block instead. -->
<!-- The pale-to-blue transition is no longer a separate element: the footer
     paints it itself, as a second background layer, so the shade runs
     continuously with no boundary that can show a seam.

     BAR INK. data-bar-ink="light" therefore CANNOT sit on <footer> any more.
     hero.js decides the header's ink from the bounding rect of each marked
     element, and the footer's rect now includes the near-white top of the
     lead-in — marking the whole footer "deep" would render the white wordmark
     on a near-white ground, the exact bug the old split avoided. The marker
     moves to an empty child positioned over the genuinely dark region only
     (everything below the lead-in), so the ink still flips at the right
     scroll position. Purely decorative: aria-hidden. -->
<footer class="site-footer">
  <div class="site-footer__deep-probe" data-bar-ink="light" aria-hidden="true"></div>
  <div class="shell">
    <div class="site-footer__main">

      <div class="site-footer__top">

        <!-- Bottom-left of the row, per the reference's footer_email_wrap:
             positioning statement, then a small caption, then the contact
             address set large as the block's real focal point. -->
        <div class="site-footer__statement">
          <p class="site-footer__claim">
            MedShield manages crew medical claims for owners who treat seafarer
            health as seriously as the vessel itself.
          </p>
          <p class="site-footer__cap site-footer__cap--left">Get in touch</p>
          <!-- Real email and phone are still [CONFIRM] in CONTENT.md, so this
               points at the form rather than guessing an address. -->
          <a class="site-footer__email" href="#contact">Request a proposal</a>
          <p class="site-footer__offices">
            <strong>Chennai, India</strong> – HQ
            <span aria-hidden="true">·</span> <strong>Singapore</strong>
            <span aria-hidden="true">·</span> <strong>Dubai, UAE</strong>
          </p>
        </div>

        <!-- Two link columns, right-aligned. Every target is a real id on this
             page. Careers has no page yet and stays omitted rather than
             linked to nothing. -->
        <nav class="site-footer__links" aria-label="Footer navigation">
          <p class="site-footer__cap" id="ft-nav">Navigation</p>
          <ul aria-labelledby="ft-nav">
            <li><a class="site-footer__link" href="#top">Home</a></li>
            <li><a class="site-footer__link" href="about.html">About</a></li>
            <li><a class="site-footer__link" href="services.html">Services</a></li>
            <li><a class="site-footer__link" href="case-studies.html">Case studies</a></li>
            <li><a class="site-footer__link" href="contact.html">Contact</a></li>
          </ul>
        </nav>

        <nav class="site-footer__links" aria-label="Footer services">
          <p class="site-footer__cap" id="ft-svc">Services</p>
          <ul aria-labelledby="ft-svc">
            <li><a class="site-footer__link" href="services.html#claims">Claims management</a></li>
            <li><a class="site-footer__link" href="services.html#advisory">Claims advisory</a></li>
            <li><a class="site-footer__link" href="services.html#budgeting">Welfare budgeting</a></li>
            <li><a class="site-footer__link" href="services.html#telemedicine">Telemedicine</a></li>
          </ul>
        </nav>
      </div>

      <!-- Bottom band. The reference closes on a full-width SVG wordmark; ours
           is live text so it stays selectable, searchable and scalable. -->
      <div class="site-footer__bottom">
        <p class="site-footer__wordmark" aria-hidden="true">MEDSHIELD<span>®</span></p>

        <div class="site-footer__legal">
          <p>© 2026 MedShield. All rights reserved.</p>
          <p class="site-footer__pending">
            Privacy Policy and Terms of Service pending – not linked until the
            pages exist.
          </p>
        </div>
      </div>

    </div>
  </div>
</footer>

<!-- Floating controls, bottom-right. The WhatsApp pill sits directly above the
     back-to-top square; both reveal together once the hero has scrolled past. -->
<a class="wa-float" id="wa-float"
   href="https://wa.me/00000000000?text=Hi%20MedShield%20-%20I%27d%20like%20to%20talk%20about%20crew%20medical%20cover."
   target="_blank" rel="noopener" aria-label="Chat with MedShield on WhatsApp">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
  </svg>
</a>

<button type="button" class="to-top-fill" id="to-top" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>
  </svg>
</button>

<script>
(function () {
  'use strict';

  var wa   = document.getElementById('wa-float');
  var top  = document.getElementById('to-top');
  var hero = document.querySelector('.hero');
  if (!wa && !top) return;

  function reveal(on) {
    if (wa)  wa.classList.toggle('show', on);
    if (top) top.classList.toggle('show', on);
  }

  // IntersectionObserver over a scroll listener: the browser does the work off
  // the main thread, so this never fights the GSAP ScrollTriggers in 03/04.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      reveal(!entries[0].isIntersecting);
    }, { threshold: 0 }).observe(hero);
  } else {
    // No hero on the page, or a browser without IO: fall back to scroll depth.
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        ticking = false;
        reveal(window.scrollY > window.innerHeight * 0.6);
      });
    }, { passive: true });
  }

  // Fill level. --p is a unitless number the stylesheet multiplies into a
  // percentage, so the gradient stop tracks how far down the page we are.
  if (top) {
    var pTicking = false;

    function paint() {
      pTicking = false;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      // A page shorter than the viewport has nothing to report — show it empty
      // rather than dividing by zero and filling the square outright.
      var p = max > 0 ? (window.scrollY / max) * 100 : 0;
      top.style.setProperty('--p', Math.max(0, Math.min(100, p)).toFixed(1));
    }

    window.addEventListener('scroll', function () {
      if (pTicking) return;
      pTicking = true;
      window.requestAnimationFrame(paint);
    }, { passive: true });

    // Sections 03/04 pin on scroll, so total height changes as they resolve.
    window.addEventListener('resize', paint, { passive: true });
    paint();

    top.addEventListener('click', function () {
      // hero.js runs a wheel-driven smooth-scroll engine on non-touch, non
      // reduced-motion setups. Where it is active it owns the scroll position:
      // a native smooth scrollTo fights its scroll listener and stalls partway,
      // so hand it the target and let its own loop drive.
      if (window.__medshieldScroll && window.__medshieldScroll.scrollTo) {
        window.__medshieldScroll.scrollTo(0);
        return;
      }
      // Engine absent (touch, or reduced motion): the browser handles it. The
      // stylesheet already drops smooth behaviour under reduced motion.
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }
})();
</script>

<script>
(function () {
  'use strict';

  var form    = document.getElementById('proposal-form');
  var success = document.getElementById('form-success');
  if (!form || !success) return;

  // Messages name the fix, never "invalid input".
  var MESSAGES = {
    name:    'Enter your name',
    company: 'Enter your company name',
    email:   'Enter a work email address',
    fleet:   'Choose a fleet size',
    vessel:  'Choose a vessel type'
  };

  function errorNode(field) {
    return document.getElementById('e-' + field);
  }

  function showError(input, message) {
    var node = errorNode(input.name);
    input.setAttribute('aria-invalid', 'true');
    if (node) {
      node.textContent = message;
      node.hidden = false;
    }
  }

  function clearError(input) {
    var node = errorNode(input.name);
    input.removeAttribute('aria-invalid');
    if (node) {
      node.textContent = '';
      node.hidden = true;
    }
  }

  function validate(input) {
    var value = (input.value || '').trim();
    if (!value) return MESSAGES[input.name] || 'This field is required';
    if (input.name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
      return MESSAGES.email;
    }
    return null;
  }

  var required = Array.prototype.slice.call(
    form.querySelectorAll('[required]')
  );

  // Re-validate on blur only once a field has been touched, so the form never
  // shouts at someone who is still typing.
  required.forEach(function (input) {
    input.addEventListener('blur', function () {
      var message = validate(input);
      if (message) { showError(input, message); } else { clearError(input); }
    });
    input.addEventListener('input',  function () { clearError(input); });
    input.addEventListener('change', function () { clearError(input); });
  });

  form.addEventListener('submit', function (event) {
    event.preventDefault();

    var firstBad = null;

    required.forEach(function (input) {
      var message = validate(input);
      if (message) {
        showError(input, message);
        if (!firstBad) firstBad = input;
      } else {
        clearError(input);
      }
    });

    if (firstBad) {
      firstBad.focus();
      return;
    }

    // Honeypot: silently accept, never submit. A bot gets the success state
    // and no signal that it was caught.
    var trap = form.querySelector('[name="role"]');
    var isBot = trap && trap.value !== '';

    if (!isBot) {
      // TODO: wire to endpoint - POST new FormData(form) to the MedShield
      // inbox / CRM. Until then nothing leaves the browser.
    }

    form.hidden = true;
    success.hidden = false;
    success.focus();
  });
})();
</script>

<script src="js/hero.js" defer></script>

<!-- Sections 03 and 04. Self-hosted like every other asset here — no CDN, in
     keeping with the no-build-step, no-CDN rule the stylesheet states. All are
     plain scripts, so `defer` keeps them in order ahead of the section files,
     each of which guards on window.gsap and bails out cleanly. -->
<script src="js/vendor/gsap.min.js" defer></script>
<script src="js/vendor/ScrollTrigger.min.js" defer></script>
<script src="js/doubts.js" defer></script>
<script src="js/services.js" defer></script>
<script src="js/why.js" defer></script>
<script src="js/process-stages.js" defer></script>
<script src="js/process-to-cases.js" defer></script>

</body>
</html>
