<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Case Studies - MedShield Maritime Healthcare &amp; Claims Management</title>
<meta name="description" content="Two anonymised case studies: how MedShield brought a hospital's inflated pricing back to market rate, and how proprietary provider selection cut recovery time and cost.">

<meta property="og:type" content="website">
<meta property="og:site_name" content="MedShield">
<meta property="og:title" content="Case Studies - MedShield">
<meta property="og:description" content="What it looks like in practice - two anonymised cases, every figure sourced.">
<meta property="og:image" content="assets/og-card.png">
<meta name="theme-color" content="#0A2A43">

<link rel="icon" href="assets/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
