  <div class="site-footer__deep-probe" aria-hidden="true"></div>
  <div class="shell">
    <div class="site-footer__main">
      <div class="site-footer__top">
        <div class="site-footer__statement">
          <p class="site-footer__claim">
            MedShield manages crew medical claims for owners who treat seafarer
            health as seriously as the vessel itself.
          </p>
          <p class="site-footer__cap site-footer__cap--left">Get in touch</p>
          <a class="site-footer__email" href="contact.html">Request a proposal</a>
          <p class="site-footer__offices">
            <strong>Chennai, India</strong> - HQ
            <span aria-hidden="true">&middot;</span> <strong>Singapore</strong>
            <span aria-hidden="true">&middot;</span> <strong>Dubai, UAE</strong>
          </p>
        </div>

        <nav class="site-footer__links" aria-label="Footer navigation">
          <p class="site-footer__cap" id="ft-nav">Navigation</p>
          <ul aria-labelledby="ft-nav">
            <li><a class="site-footer__link" href="index.html">Home</a></li>
            <li><a class="site-footer__link" href="about.html">About</a></li>
            <li><a class="site-footer__link" href="services.html">Services</a></li>
            <li><a class="site-footer__link" href="case-studies.html">Case studies</a></li>
            <li><a class="site-footer__link" href="contact.html">Contact</a></li>
          </ul>
        </nav>

        <nav class="site-footer__links" aria-label="Footer services">
          <p class="site-footer__cap" id="ft-svc">Services</p>
          <ul aria-labelledby="ft-svc">
            <li><a class="site-footer__link" href="services.html#claims">Claims management</a></li>
            <li><a class="site-footer__link" href="services.html#advisory">Claims advisory</a></li>
            <li><a class="site-footer__link" href="services.html#budgeting">Welfare budgeting</a></li>
            <li><a class="site-footer__link" href="services.html#telemedicine">Telemedicine</a></li>
          </ul>
        </nav>
      </div>

      <div class="site-footer__bottom">
        <p class="site-footer__wordmark" aria-hidden="true">MEDSHIELD<span>&reg;</span></p>
        <div class="site-footer__legal">
          <p>&copy; 2026 MedShield. All rights reserved.</p>
          <p class="site-footer__pending">
            Privacy Policy and Terms of Service pending - not linked until the
            pages exist.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script src="js/cases-reveal.js"></script>
