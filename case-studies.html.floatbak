<main id="main">

  <!-- CASE STUDIES INDEX ......................................
       A centred display masthead over a stack of full-width case rows, each
       row splitting copy (left) against one photograph (right) with a
       diagonal arrow at its foot. One row is inverted in brand blue as the
       emphasis beat. Styles live under .csx in css/inner.css.

       The last two rows ship with the hidden attribute and are revealed by
       the Load more control (js/cases-more.js). With JS off the control is
       removed by that same script's absence - see the <noscript> rule below,
       which unhides the rows so nothing is unreachable. -->
  <section class="csx" aria-labelledby="csx-h">
    <div class="shell">

      <header class="csx__head">
        <h1 class="csx__title" id="csx-h">Case studies</h1>
        <p class="csx__lede">
          How MedShield brings inflated medical costs back to market rate and
          gets crew care back on track &ndash; across cruise, shipping and
          offshore. Real cases, real figures, taken verbatim from the files.
        </p>
      </header>

      <ol class="csx__list">

        <!-- 01 ---------------------------------------------------------- -->
        <li class="csx-case">
          <div class="csx-case__body">
            <div>
              <h2 class="csx-case__title">
                A hospital tripled its prices. We brought them back.
              </h2>
              <p class="csx-case__tag">Cost optimisation &middot; India</p>
              <p class="csx-case__text">
                Once the hospital learned an employer was covering costs,
                consultation fees were billed at 3&times; market rate and
                surgery quoted at 3.8&times;. We negotiated every line back to
                market through our provider network and monitored the file
                through to settlement.
              </p>
              <p class="csx-case__figure">
                <span class="csx-case__figureNum">66%</span> total claim reduced
              </p>
            </div>
            <span class="csx-case__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </span>
          </div>
          <div class="csx-case__media">
            <img src="assets/cases/case-surgery.jpg"
                 alt="A surgical team at work under theatre lights."
                 width="960" height="640" loading="lazy" decoding="async">
          </div>
        </li>

        <!-- 02 - the inverted row --------------------------------------- -->
        <li class="csx-case csx-case--invert">
          <div class="csx-case__body">
            <div>
              <h2 class="csx-case__title">
                The wrong hospital cost 40% more recovery time.
              </h2>
              <p class="csx-case__tag">Provider selection &middot; India</p>
              <p class="csx-case__text">
                A PEME vendor referred a seafarer on a financial relationship
                rather than clinical fit. We re-shortlisted providers on our
                scored index, had specialists formally review the original
                treatment records, and secured an immediate appointment
                through a Case Management Specialist.
              </p>
              <p class="csx-case__figure">
                <span class="csx-case__figureNum">3.5L</span> INR saved, recovery back on track
              </p>
            </div>
            <span class="csx-case__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </span>
          </div>
          <div class="csx-case__media">
            <img src="assets/cases/case-review.jpg"
                 alt="Three clinicians reviewing a patient's X-ray together."
                 width="960" height="640" loading="lazy" decoding="async">
          </div>
        </li>

        <!-- 03 ---------------------------------------------------------- -->
        <li class="csx-case">
          <div class="csx-case__body">
            <div>
              <h2 class="csx-case__title">
                Rehabilitation moved outside the hospital's margin
              </h2>
              <p class="csx-case__tag">Strategic referral &middot; India</p>
              <p class="csx-case__text">
                Pre-habilitation therapy had been outsourced to a third party
                inside the hospital's own premises, with the hospital's margin
                added on top. We referred the seafarer to independent
                specialists and costed the programme against market rate.
              </p>
              <p class="csx-case__figure">
                <span class="csx-case__figureNum">60%</span> therapy cost reduction
              </p>
            </div>
            <span class="csx-case__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </span>
          </div>
          <div class="csx-case__media">
            <img src="assets/cases/case-consult.jpg"
                 alt="A doctor and a nurse in consultation with a patient in a clinic."
                 width="960" height="640" loading="lazy" decoding="async">
          </div>
        </li>

        <!-- 04 - revealed by Load more ---------------------------------- -->
        <li class="csx-case" hidden>
          <div class="csx-case__body">
            <div>
              <h2 class="csx-case__title">
                A crew case handled from the berth, not the invoice
              </h2>
              <p class="csx-case__tag">Cruise &middot; port coordination</p>
              <p class="csx-case__text">
                A crew member landed ashore mid-itinerary with the vessel due
                to sail. We took the case at the gangway &ndash; provider
                selected, treatment costed and approved before delivery, and
                repatriation documented against MLC obligations as the case
                ran.
              </p>
              <p class="csx-case__figure">
                <span class="csx-case__figureNum">30%</span> faster claim turnaround
              </p>
            </div>
            <span class="csx-case__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </span>
          </div>
          <div class="csx-case__media">
            <img src="assets/cases/case-cruise.jpg"
                 alt="A cruise ship berthed alongside a port pier at dusk."
                 width="960" height="640" loading="lazy" decoding="async">
          </div>
        </li>

        <!-- 05 - revealed by Load more ---------------------------------- -->
        <li class="csx-case" hidden>
          <div class="csx-case__body">
            <div>
              <h2 class="csx-case__title">
                Consultation fees brought back in line with market rates
              </h2>
              <p class="csx-case__tag">Cost negotiation &middot; India</p>
              <p class="csx-case__text">
                Charging 1.5&times; to 10&times; the market average is an
                unregulated practice across Indian and Asian healthcare. Every
                consultation on the file was re-costed against our
                pre-negotiated rates before it was approved.
              </p>
              <p class="csx-case__figure">
                <span class="csx-case__figureNum">65%</span> consultation fees reduced
              </p>
            </div>
            <span class="csx-case__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </span>
          </div>
          <div class="csx-case__media">
            <img src="assets/cases/case-waiting.jpg"
                 alt="A member of clinical staff waiting in a hospital corridor."
                 width="960" height="640" loading="lazy" decoding="async">
          </div>
        </li>

      </ol>

      <!-- Added by js/cases-more.js only, so the control never appears
           without the script that makes it work. -->
      <div class="csx__more" data-csx-more hidden></div>

      <noscript>
        <style>.csx-case[hidden] { display: grid; }</style>
      </noscript>

    </div>
  </section>

  <!-- Why MedShield / Impact -->
  <section class="inner-section--light" style="padding-block: var(--s-9);" aria-labelledby="why-h">
    <div class="shell">
      <header class="inner-section__head">
        <p class="eyebrow">Why MedShield</p>
        <h2 class="section-title" id="why-h">What changes when one partner owns the case</h2>
      </header>
      <!-- ALTERNATING TIMELINE. Six steps around a centre spine, each with an
           icon medallion on the outer edge and a dashed leader running in to
           a node on the line. Styles and the scroll reveal live under .wtl in
           css/inner.css; js/cases-reveal.js drives the .is-in class.

           The icons are inline SVG, drawn to the point each step makes, and
           aria-hidden: none of them carries information the copy does not
           already state. -->
      <div class="wtl" data-wtl>
        <span class="wtl__spine" aria-hidden="true"></span>

        <ol class="wtl__list">

          <!-- 01 - a price tag: treatment costed before it is delivered. -->
          <li class="wtl-step">
            <span class="wtl-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.6 13.4 12 22l-9-9V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/>
                <circle cx="8.5" cy="7.5" r="1.5"/>
                <path d="m11 15 4-4"/>
              </svg>
            </span>
            <div class="wtl-step__body">
              <p class="wtl-step__num">Point 1</p>
              <h3 class="wtl-step__title">Lower medical spend</h3>
              <p class="wtl-step__text">
                Treatment costed and approved against pre-negotiated rates
                before delivery, not queried after the invoice lands.
              </p>
            </div>
          </li>

          <!-- 02 - a completed file: the record is whole from hour one. -->
          <li class="wtl-step">
            <span class="wtl-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                <path d="M14 2v5h5"/>
                <path d="m9 14 2 2 4-4"/>
              </svg>
            </span>
            <div class="wtl-step__body">
              <p class="wtl-step__num">Point 2</p>
              <h3 class="wtl-step__title">Fewer disputed claims</h3>
              <p class="wtl-step__text">
                The file is complete from hour one, not reconstructed at
                settlement when the details have gone cold.
              </p>
            </div>
          </li>

          <!-- 03 - a stethoscope: the doctor is on the call, not referred to. -->
          <li class="wtl-step">
            <span class="wtl-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 3v6a5 5 0 0 0 10 0V3"/>
                <path d="M4 3H2m12 0h-2"/>
                <path d="M9 14v2a5 5 0 0 0 10 0v-1"/>
                <circle cx="19" cy="12" r="2.4"/>
              </svg>
            </span>
            <div class="wtl-step__body">
              <p class="wtl-step__num">Point 3</p>
              <h3 class="wtl-step__title">Faster decisions</h3>
              <p class="wtl-step__text">
                A doctor and a case manager on the same call, so the next step
                is agreed while the case is still moving.
              </p>
            </div>
          </li>

          <!-- 04 - a shield: MLC and ILO obligations, documented as they run. -->
          <li class="wtl-step">
            <span class="wtl-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 2 8 3.5v5c0 6-3.5 9.5-8 11.5-4.5-2-8-5.5-8-11.5v-5Z"/>
                <path d="m8.8 11.8 2.2 2.2 4.2-4.2"/>
              </svg>
            </span>
            <div class="wtl-step__body">
              <p class="wtl-step__num">Point 4</p>
              <h3 class="wtl-step__title">Regulatory confidence</h3>
              <p class="wtl-step__text">
                MLC and ILO obligations documented as the case runs, so the
                position is defensible before anyone asks for it.
              </p>
            </div>
          </li>

          <!-- 05 - one folder, many voyages: a single record per seafarer. -->
          <li class="wtl-step">
            <span class="wtl-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="3.2"/>
                <path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>
                <path d="M3 12h1.6M19.4 12H21"/>
              </svg>
            </span>
            <div class="wtl-step__body">
              <p class="wtl-step__num">Point 5</p>
              <h3 class="wtl-step__title">One record per seafarer</h3>
              <p class="wtl-step__text">
                Across vessels, ports and years &ndash; one history that
                travels with the crew member rather than with the voyage.
              </p>
            </div>
          </li>

          <!-- 06 - balanced scales: hospitals scored on merit, not referral. -->
          <li class="wtl-step">
            <span class="wtl-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v18M7 21h10"/>
                <path d="M5 7h14M12 5.5 5 7l7 1.5 7-1.5Z"/>
                <path d="M2.5 13 5 7l2.5 6a2.5 2.5 0 0 1-5 0Z"/>
                <path d="M16.5 13 19 7l2.5 6a2.5 2.5 0 0 1-5 0Z"/>
              </svg>
            </span>
            <div class="wtl-step__body">
              <p class="wtl-step__num">Point 6</p>
              <h3 class="wtl-step__title">Unbiased provider choice</h3>
              <p class="wtl-step__text">
                Hospitals scored on merit, never on referral relationships
                &ndash; we hold no financial interest in where you are treated.
              </p>
            </div>
          </li>

        </ol>
      </div>

      <div class="impact-strip">
        <div class="impact-strip__item">
          <p class="impact-strip__num">35,000+</p>
          <p class="impact-strip__label">Claims handled</p>
        </div>
        <div class="impact-strip__item">
          <p class="impact-strip__num">~$1M</p>
          <p class="impact-strip__label">Saved for clients by preventing inflated costs</p>
        </div>
        <div class="impact-strip__item">
          <p class="impact-strip__num">30%</p>
          <p class="impact-strip__label">Faster claim turnaround time</p>
        </div>
        <div class="impact-strip__item">
          <p class="impact-strip__num">25%</p>
          <p class="impact-strip__label">Improvement in overall efficiency</p>
        </div>
      </div>
    </div>
  </section>

  <section class="simple-cta simple-cta--light">
    <div class="shell">
      <h2>Let's take the next case</h2>
      <p>If this is how you want your crew cases handled, send us your fleet profile.</p>
      <a class="cta-pill" href="contact.html">Request a proposal</a>
    </div>
  </section>

</main>

