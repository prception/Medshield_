    </ul>
    <p class="site-menu__meta">
      <span>India</span>
      <span>Singapore</span>
      <span>UAE</span>
    </p>
  </div>
</nav>
<div class="nav-scrim" id="nav-scrim" hidden></div>

<main id="main">

  <!-- ======================================================================
       01 â€” ABOUT US.  Device 1: split wordmark.
       The reference's opening move, verbatim in structure: the word broken
       across two lines with one letter straddling them, a dense small
       paragraph column to the right, a photo tile beneath it, and a hairline
       outlined button. Header padding is carried by .page-hero's rhythm.
       ====================================================================== -->
  <section class="ab-section" style="padding-block: calc(5.25rem + var(--s-8)) var(--s-9);" aria-labelledby="about-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>About MedShield</p>

      <div class="ab-split" data-ab-stagger="120">
        <!-- The lockup, not a line stack: ABO and US on two rows with an
             oversized U spanning both and a small T tucked beside it, exactly
             as the reference sets it. aria-label carries the readable string,
             since the glyphs are split across grid cells. -->
        <h1 class="ab-split__mark" id="about-h" data-ab-reveal aria-label="About us">
          <span class="ab-lockup" aria-hidden="true">
            <span class="ab-lockup__abo">Abo</span><span class="ab-lockup__u">u</span><span class="ab-lockup__t">t</span><span class="ab-lockup__us">u<span class="ab-lockup__accent">s</span></span>
          </span>
        </h1>

        <div class="ab-split__body" data-ab-reveal>
          <p class="ab-split__copy">
            MedShield is India's first multidisciplinary maritime healthcare
            company. We champion seafarers' care and secure employers' trust
            by putting an independent specialist medical team above a
            verified treatment network - standardising clinical decisions,
            provider selection, treatment monitoring and cost control across
            India, Singapore and the UAE.
          </p>
          <p class="ab-split__copy">
            The pitch is expert medical decision-making plus an independent
            network plus coordination. Not simply a large network, which is a
            commodity on its own. We hold no commercial interest in where
            your seafarer is treated, which is precisely what makes the
            recommendation worth having.
          </p>
          <a class="ab-split__more" href="#founders">Read more</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       02 â€” VISION & MISSION.  Device 1, paired variant.
       Same split-wordmark rhythm, but the body column divides into two
       stacks so vision and mission read as a pair rather than a sequence.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="vm-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>Vision &amp; mission</p>

      <div class="ab-split ab-split--pair" data-ab-stagger="120">
        <h2 class="ab-split__mark" id="vm-h" data-ab-reveal data-ab-lines="whole">
          <span class="ab-split__line">Wha</span>
          <span class="ab-split__line ab-split__line--step"><span class="ab-split__lap">t</span> for</span>
        </h2>

        <div class="ab-split__body" data-ab-reveal>
          <div class="ab-split__stack">
            <p class="ab-split__sublabel">Vision</p>
            <p class="ab-split__copy">
              To raise the standard of maritime healthcare with seamless
              solutions that safeguard seafarers' well-being while addressing
              the operational priorities of maritime employers - empowering
              the global maritime community with specialised expertise and an
              unwavering commitment to care.
            </p>
          </div>
          <div class="ab-split__stack">
            <p class="ab-split__sublabel">Mission</p>
            <p class="ab-split__copy">
              To set a new benchmark for maritime healthcare by integrating
              technology with human-centred care - proactive health
              management, rapid claims resolution and effective cost control,
              so health risks are minimised and operational disruption is
              avoided.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       03 â€” BY THE NUMBERS.  Device 2: asymmetric stat mosaic.
       Four indexed stats on a 4-column bed with structural voids, one cell
       inverted to navy. The voids are not filler waiting for content - they
       are what stops the block reading as a dashboard.
       ====================================================================== -->
  <section class="ab-section ab-section--sunken" aria-labelledby="nums-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>By the numbers</p>
      <h2 class="ab-figure__title" id="nums-h" data-ab-reveal data-ab-lines
          style="max-width: 20ch; margin-bottom: var(--s-7);">
        The depth behind a single case review
      </h2>

      <div class="ab-mosaic" data-ab-stagger="90">
        <div class="ab-cell ab-cell--lead" data-ab-reveal>
          <span class="ab-idx">01</span>
          <p class="ab-cell__label">Specialists and super-specialists</p>
          <p class="ab-cell__figure" data-ab-count>130+</p>
        </div>

        <div class="ab-cell ab-cell--void" aria-hidden="true"></div>

        <div class="ab-cell" data-ab-reveal>
          <span class="ab-idx">02</span>
          <p class="ab-cell__label">Clinical disciplines</p>
          <p class="ab-cell__figure" data-ab-count>9</p>
        </div>

        <div class="ab-cell ab-cell--invert" data-ab-reveal>
          <span class="ab-idx">03</span>
          <p class="ab-cell__label">Verified network points across India</p>
          <p class="ab-cell__figure" data-ab-count>1,800+</p>
        </div>

        <div class="ab-cell" data-ab-reveal>
          <span class="ab-idx">04</span>
          <p class="ab-cell__label">Offices - India, Singapore, UAE</p>
          <p class="ab-cell__figure" data-ab-count>3</p>
        </div>
      </div>

      <p class="confirm-note" data-ab-reveal>[CONFIRM] Network scale: client sources give both "1,800+ partner hospitals" and, separately, "17-45+ locations across India" depending on document - figure to be reconciled with the client before publishing a single number.</p>
    </div>
  </section>

  <!-- ======================================================================
       04 â€” THE TWO-LAYER MODEL.  Device 2, layers variant.
       The composition carries the argument: Layer 02 (the medical team) is
       placed ABOVE Layer 01 (the network) on the grid, because that is
       literally the claim being made.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="layers-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>How we work</p>
      <h2 class="ab-figure__title" id="layers-h" data-ab-reveal data-ab-lines
          style="max-width: 22ch; margin-bottom: var(--s-7);">
        An independent medical team above a verified network
      </h2>

      <div class="ab-mosaic ab-mosaic--layers" data-ab-stagger="140">
        <div class="ab-cell ab-cell--void ab-cell--void-a" aria-hidden="true"></div>

        <div class="ab-cell ab-cell--lead ab-cell--upper" data-ab-reveal>
          <span class="ab-idx">Layer 02</span>
          <p class="ab-cell__title">An independent central medical team</p>
          <p class="ab-cell__body">
            130+ specialists and super-specialists who decide what should
            actually happen: assessing treatment proposals, selecting the
            provider, setting the protocol and monitoring the case. They are
            not attached to the hospital treating your seafarer.
          </p>
        </div>

        <div class="ab-cell ab-cell--void ab-cell--void-b" aria-hidden="true"></div>

        <div class="ab-cell ab-cell--lead ab-cell--lower" data-ab-reveal>
          <span class="ab-idx">Layer 01</span>
          <p class="ab-cell__title">A verified treatment network across India</p>
          <p class="ab-cell__body">
            Accredited providers on pre-negotiated rates, checked before they
            are used - hospitals, clinics, laboratories and pharmacies. The
            network is the floor the medical team stands on, not the product
            in itself.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       05 â€” FOUNDERS.  Device 1, at name scale, mirrored on the second.
       Each founder's surname becomes the wordmark; the bio is the tight
       column. Mirroring the second entry keeps two consecutive uses of the
       same device from reading as a template.
       ====================================================================== -->
  <section class="ab-section ab-section--sunken" id="founders" aria-labelledby="founders-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>Leadership</p>
      <h2 class="visually-hidden" id="founders-h">Founders</h2>

      <div class="ab-split ab-split--name" data-ab-stagger="120" style="margin-bottom: var(--s-9);">
        <!-- Names break on the WORD, not mid-word. The lap letter works on
             "ABO/UT US" because the reader reassembles a familiar phrase;
             on a person's name a mid-word break just reads as a typo. The
             stepped second line and the accent colour carry the device
             instead. -->
        <p class="ab-split__mark" data-ab-reveal data-ab-lines="whole">
          <span class="ab-split__line">Desikan</span>
          <span class="ab-split__line ab-split__line--step"><span class="ab-split__lap">Setlur</span></span>
        </p>

        <div class="ab-split__body" data-ab-reveal>
          <figure class="ab-split__media">
            <img src="assets/people/desikan.jpg" alt="Dr. Desikan Setlur, Founder and CEO of MedShield." width="560" height="700" loading="lazy" decoding="async">
          </figure>
          <p class="ab-split__copy">
            A Ph.D. in Maritime Occupational Health &amp; Safety from Swansea
            University, U.K., with over two decades in maritime healthcare. He
            has led medical evacuations and port operations across India and
            Asia, and built long-standing relationships with global insurers,
            TPAs and maritime agents. Under his leadership, MedShield bridges
            healthcare needs and operational efficiency with tech-driven,
            seafarer-first solutions.
          </p>
          <p class="ab-split__role">Founder &amp; CEO</p>
        </div>
      </div>

      <div class="ab-split ab-split--name ab-split--mirror" data-ab-stagger="120">
        <p class="ab-split__mark" data-ab-reveal data-ab-lines="whole">
          <span class="ab-split__line">Princi</span>
          <span class="ab-split__line ab-split__line--step"><span class="ab-split__lap">Singh</span></span>
        </p>

        <div class="ab-split__body" data-ab-reveal>
          <figure class="ab-split__media">
            <img src="assets/people/princi.jpg" alt="Dr. Princi Singh, Co-Founder and COO of MedShield." width="560" height="700" loading="lazy" decoding="async">
          </figure>
          <p class="ab-split__copy">
            A dental surgeon (BDS) with specialised certification in Hospital
            Management and over a decade in healthcare operations. She
            oversees MedShield's day-to-day healthcare delivery - treatment
            plan coordination, hospital partnerships and the telemedicine
            programme - working alongside Dr. Setlur on strategic direction
            and MedShield's global expansion.
          </p>
          <p class="ab-split__role">Co-Founder &amp; COO</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       06 â€” THE DISCIPLINES.  Device 3: bordered wall, merged centre cell.
       Twelve capability tiles ringing a navy statement block, exactly the
       reference's brand wall - but the cells carry disciplines rather than
       logos, which is the honest version of that device for this company.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="disc-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>The independent medical team</p>
      <h2 class="ab-figure__title" id="disc-h" data-ab-reveal data-ab-lines
          style="max-width: 24ch; margin-bottom: var(--s-7);">
        Every discipline a maritime case can turn on
      </h2>

      <div class="ab-wall" data-ab-stagger="55">
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Maritime medical</p>
          <p class="ab-tile__meta">Physical and mental health at sea</p>
        </div>
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Telemedicine</p>
          <p class="ab-tile__meta">Remote consultations, globally</p>
        </div>
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Healthcare &amp; claims</p>
          <p class="ab-tile__meta">Medical, disability and life</p>
        </div>
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Clinical correlation</p>
          <p class="ab-tile__meta">Findings read against each other</p>
        </div>
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Treatment analysis</p>
          <p class="ab-tile__meta">Plans reviewed on merit and cost</p>
        </div>
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Global pharmacology</p>
          <p class="ab-tile__meta">Medication compliance across ports</p>
        </div>

        <!-- Exactly ten tiles ring the statement: six across the top row,
             then two flanking pairs down the sides. The count is load-bearing
             â€” see the placement note on .ab-tile--statement. -->
        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Preventive health</p>
          <p class="ab-tile__meta">Occupational programmes</p>
        </div>

        <div class="ab-tile ab-tile--statement" data-ab-reveal>
          <p class="ab-wall__statement" data-ab-lines="whole">
            An independent<br><em>medical team</em>
          </p>
        </div>

        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Medico-legal</p>
          <p class="ab-tile__meta">Arbitration, advisory, complex claims</p>
        </div>

        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Case management</p>
          <p class="ab-tile__meta">Every stakeholder coordinated</p>
        </div>

        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">Technology</p>
          <p class="ab-tile__meta">24 / 7 / 365</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       07 â€” THE PANEL.  Device 3, bio variant.
       Eleven named reviewers as a dense wall rather than eleven tall cards.
       Each biography is in the DOM for search and assistive tech, revealed
       on hover or keyboard focus so the wall keeps its density.
       ====================================================================== -->
  <section class="ab-section ab-section--deep" aria-labelledby="panel-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>The panel</p>
      <h2 class="ab-figure__title" id="panel-h" data-ab-reveal data-ab-lines
          style="max-width: 22ch; margin-bottom: var(--s-4);">
        Who reviews your case
      </h2>
      <p class="ab-split__copy" data-ab-reveal style="margin-bottom: var(--s-7); max-width: 58ch;">
        A sample of the specialists on our clinical and legal panel. Before a
        treatment plan is approved, this team reviews it on clinical merit -
        with nothing to gain from the choice they make.
      </p>

      <div class="ab-wall" data-ab-stagger="55">
        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. M. Jaya Rajah</p>
          <p class="ab-tile__meta">Senior Consultant &amp; Head of Cardiology</p>
          <span class="ab-tile__bio"><span><span>Over three decades in Internal Medicine and Cardiology. MD from Stanley Medical College, DM Cardiology from Madras Medical College. 17 years heading Cardiology at Sooriya Hospital; 12 years as Professor of Cardiology at Sri Ramachandra Medical College.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. P. Satish</p>
          <p class="ab-tile__meta">Senior Consultant Gastro Surgeon</p>
          <span class="ab-tile__bio"><span><span>Specialises in hepatobiliary, pancreatic, gastro-esophageal, colorectal and abdominal cancer surgeries. Published research in gastroenterology journals and a regular contributor to global conferences.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. S.T. Sivaraman</p>
          <p class="ab-tile__meta">Consultant Orthopedic Surgeon, Emergency &amp; Trauma</p>
          <span class="ab-tile__bio"><span><span>Over two decades of experience. Gold Medalist, AIIMS New Delhi. Fellowship in Traumatology and Reconstructive Surgery, Katharinen Hospital, Stuttgart. Currently at Sooriya Hospital, Chennai.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Srinivas Rajagopala</p>
          <p class="ab-tile__meta">Director, Pulmonology &amp; Sleep Medicine</p>
          <span class="ab-tile__bio"><span><span>Over 20 years' experience. Trained at PGIMER Chandigarh and JIPMER Puducherry, with further training in Adelaide, McMaster and Toronto. Specialises in lung transplantation and advanced lung disease.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Sudheer Pargewar</p>
          <p class="ab-tile__meta">Senior Consultant, Interventional Radiology</p>
          <span class="ab-tile__bio"><span><span>18 years' experience, trained at the Institute of Liver and Biliary Sciences (New Delhi) and Juntendo University (Tokyo). Specialises in minimally invasive hepatobiliary interventions.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Tarun Grover</p>
          <p class="ab-tile__meta">Director, Peripheral Vascular &amp; Endovascular Sciences</p>
          <span class="ab-tile__bio"><span><span>Over 25 years' experience. Fellow of the American College of Surgeons. Trained at St. Mary's Hospital, London and the Regional Vascular Centre, Cologne.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Vijayaraghavan G.</p>
          <p class="ab-tile__meta">Senior Consultant, Spine Surgery</p>
          <span class="ab-tile__bio"><span><span>Over a decade in minimally invasive spine surgery. Graduate of Madras Medical College and AIIMS New Delhi, with fellowships in Singapore, Korea/Japan/China and UCSF.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Vinod S. Joshi</p>
          <p class="ab-tile__meta">Section Head, Urology</p>
          <span class="ab-tile__bio"><span><span>Trained at Nair Hospital in endourology, urodynamics and andrology. Skilled in TURP, PCNL and URS - independently achieving a 65% total stone clearance rate in PCNL.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">Dr. Princi Singh</p>
          <p class="ab-tile__meta">Co-Founder &amp; COO</p>
          <span class="ab-tile__bio"><span><span>Dental surgeon (BDS) with certification in Hospital Management, overseeing treatment plan coordination, hospital partnerships and the telemedicine programme.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">K. Vijay Anand</p>
          <p class="ab-tile__meta">Legal &amp; Compliance Advisor</p>
          <span class="ab-tile__bio"><span><span>M.A., B.L., over 25 years in corporate legal, risk mitigation and compliance advisory - advising on legal frameworks, strategic risk mitigation and representation in disputes.</span></span></span>
        </div>

        <div class="ab-tile ab-tile--bio" data-ab-reveal tabindex="0">
          <p class="ab-tile__name">R.V. Senthil Kumar</p>
          <p class="ab-tile__meta">Advocate, Arbitration &amp; Labour Law</p>
          <span class="ab-tile__bio"><span><span>B.A., B.L., registered advocate with over 24 years across civil, criminal, insurance and company law - particular depth in labour law, arbitration and MLC/ILO-aligned employee dispute resolution.</span></span></span>
        </div>

        <div class="ab-tile" data-ab-reveal>
          <p class="ab-tile__name">+ 119 more</p>
          <p class="ab-tile__meta">Across nine disciplines</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       08 â€” WHAT WE ARE NOT.  Device 4: giant numeral + ranked list.
       The numeral is a zero, and it means something: zero commercial
       interest in where the seafarer is treated. The list is what we are
       not, set as ranked hairline rows.
       ====================================================================== -->
  <section class="ab-section" aria-labelledby="not-h">
    <div class="shell">
      <p class="eyebrow" data-ab-reveal>Independence</p>

      <div class="ab-figure" data-ab-stagger="140">
        <p class="ab-figure__numeral" data-ab-reveal>0</p>

        <div data-ab-reveal>
          <h2 class="ab-figure__title" id="not-h" data-ab-lines="whole">
            <em>Commercial interest</em><br>in where you are treated
          </h2>
          <ul class="ab-rank">
            <li class="ab-rank__row">
              <span class="ab-rank__key">Not</span>
              <span class="ab-rank__val">A hospital, a clinic or a pharmacy</span>
            </li>
            <li class="ab-rank__row">
              <span class="ab-rank__key">Not</span>
              <span class="ab-rank__val">An insurer or a third-party administrator</span>
            </li>
            <li class="ab-rank__row">
              <span class="ab-rank__key">Not</span>
              <span class="ab-rank__val">A cruise booking company</span>
            </li>
            <li class="ab-rank__row">
              <span class="ab-rank__key">Not</span>
              <span class="ab-rank__val">A medical tourism agency</span>
            </li>
            <li class="ab-rank__row">
              <span class="ab-rank__key">Not</span>
              <span class="ab-rank__val">A crew recruiter</span>
            </li>
            <li class="ab-rank__row">
              <span class="ab-rank__key">We are</span>
              <span class="ab-rank__val">
                The operations partner that manages the case between all of them
                <small>Independent case owner from incident to outcome.</small>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       09 â€” OFFICES.  Device 4, second use.
       Giant 3, and the three offices as ranked hairline rows with their
       contact detail nested beneath each.
       ====================================================================== -->
  <section class="ab-section ab-section--sunken" aria-labelledby="offices-h">
