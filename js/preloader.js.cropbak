/* ===========================================================================
   preloader.js — wordmark-to-hero reveal
   ===========================================================================
   MED | video | SHIELD. A 16:9 gap opens between the two halves of the word,
   the hero clip plays inside it, then the gap and the clip grow until the clip
   sits exactly where .hero__media sits, and the loader lifts.

   WHY THE MEASUREMENT MATTERS
   The final move is not "scale up until it looks full-screen". The script
   measures the REAL .hero__media rectangle, and animates the small box width,
   height and translate onto that rect. That is what makes the hand-off
   invisible: at the last frame the loader's clip and the hero's clip occupy
   identical pixels, so removing one and showing the other is not a visible
   swap.

   ORDERING WITH hero.js
   hero.js reveals the headline on document.fonts.ready, with a hard 900ms
   floor. Left alone it would run its whole entrance UNDER the loader and be
   finished by the time the loader lifted. So this file sets a gate —
   window.__preloaderGate — that hero.js awaits before revealing. If this file
   is absent, that gate is undefined and hero.js reveals immediately, exactly
   as it does today.

   FAIL-VISIBLE, THREE WAYS
   The page must never be left stuck behind a splash:
     1. finish() runs onComplete
     2. every entry point is wrapped in try/catch, and the catch calls finish()
     3. a 7000ms setTimeout calls finish() regardless
   finish() is idempotent, so whichever fires first wins and the rest no-op.
   =========================================================================== */

(function () {
  'use strict';

  var root = document.documentElement;
  var pl = document.getElementById('preloader');

  /* --- The gate ------------------------------------------------------------
     Created BEFORE any early return, and always resolved. hero.js waits on
     this; if we bail out for any reason it must resolve immediately or the
     hero would never appear at all. */
  var releaseGate;
  var gateDone = false;
  window.__preloaderGate = new Promise(function (resolve) {
    releaseGate = function () {
      if (gateDone) return;
      gateDone = true;
      resolve();
    };
  });

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* The intro runs on EVERY page load, as the reference site does — there is
     deliberately no once-per-session check here. An earlier revision stored an
     'ms-preloader' flag in sessionStorage and skipped the intro when it was
     set; that is gone, and nothing writes that key any more. A stale value left
     in a browser from that revision is simply ignored. */

  /* Bail-out path. No loader element, reduced motion, or no GSAP: release the
     hero and leave the DOM untouched. */
  if (!pl || reduce || !window.gsap) {
    if (pl && pl.parentNode) pl.parentNode.removeChild(pl);
    releaseGate();
    return;
  }

  var gsap = window.gsap;
  var box = document.getElementById('preloader-box');

  /* The HERO's own media layer — the element that actually expands. There is no
     preloader-owned video any more: clipping the real one is what makes the
     hand-off seamless (no second download, no element swap, no restart). */
  var heroMedia = document.querySelector('.hero__media');
  var heroEl = document.querySelector('.hero');

  /* Without a hero to reveal there is nothing for this intro to do. */
  if (!heroMedia || !heroEl) {
    if (pl && pl.parentNode) pl.parentNode.removeChild(pl);
    releaseGate();
    return;
  }

  /* --- Scroll lock ---------------------------------------------------------
     Compensating padding for the scrollbar width, so locking does not shift
     the page sideways underneath the loader. */
  var locked = false;
  function lock() {
    if (locked) return;
    locked = true;
    var sw = window.innerWidth - root.clientWidth;
    if (sw > 0) root.style.paddingRight = sw + 'px';
    root.classList.add('pl-lock');
    window.scrollTo(0, 0);
  }

  function unlock() {
    if (!locked) return;
    locked = false;
    root.classList.remove('pl-lock');
    root.style.paddingRight = '';
  }

  /* --- Teardown ------------------------------------------------------------
     Idempotent: whichever of the three failure paths fires first wins. */
  var finished = false;
  function finish() {
    if (finished) return;
    finished = true;

    /* Stop driving the clip-path and hand the hero back its own media,
       unclipped. This MUST run on every exit path, including the failsafes —
       leaving the ticker attached would keep rewriting clip-path from a box
       that is about to be removed, and leaving the inset in place would crop
       the hero video permanently. */
    try { gsap.ticker.remove(applyHole); } catch (e) {}
    clearHole();

    unlock();
    releaseGate();          // hero.js may now run its entrance

    /* One frame of overlap before removal. The hero is revealed by the gate
       above; taking the loader out in the same frame can show a flash of the
       page ground between the two. */
    requestAnimationFrame(function () {
      if (pl && pl.parentNode) pl.parentNode.removeChild(pl);
      /* Nothing to tear down for the video: this file never owned one. The
         hero's own clip has been playing throughout and simply carries on. */
    });
  }

  window.setTimeout(finish, 7000);   // failsafe #3

  /* --- Letter split --------------------------------------------------------
     Each letter gets its own clip box so it can slide up from below its own
     baseline. Built from data-pl-word rather than written out in the markup,
     which keeps the decorative duplicate of the brand name out of the DOM for
     anything that ignores aria-hidden. */
  function buildWord(el) {
    var word = el.getAttribute('data-pl-word') || '';
    var frag = document.createDocumentFragment();
    for (var i = 0; i < word.length; i++) {
      var mask = document.createElement('span');
      mask.className = 'preloader__letter';
      var inner = document.createElement('span');
      inner.textContent = word[i];
      mask.appendChild(inner);
      frag.appendChild(mask);
    }
    el.appendChild(frag);
    return el.querySelectorAll('.preloader__letter > span');
  }

  var letters = [];
  Array.prototype.forEach.call(
    pl.querySelectorAll('[data-pl-word]'),
    function (el) {
      letters = letters.concat(Array.prototype.slice.call(buildWord(el)));
    }
  );

  /* --- Geometry ------------------------------------------------------------
     The gap's target width: 16:9 against the wordmark's own cap height, so the
     box is proportioned to the type rather than to an arbitrary vw figure.
     Clamped so the assembled row (MED + gap + SHIELD) can never exceed 92% of
     the frame — without this the word is pushed off-screen on a narrow phone. */
  function gapWidth() {
    var h = box.getBoundingClientRect().height;
    if (!h) return Math.round(window.innerWidth * 0.3);
    var want = h * 16 / 9;
    var row = pl.querySelector('.preloader__mark');
    if (row) {
      var rest = row.getBoundingClientRect().width - box.getBoundingClientRect().width;
      var max = window.innerWidth * 0.92 - rest;
      if (max > 0 && want > max) want = max;
    }
    return Math.round(want);
  }

  /* The MINI player: the second beat, after the gap has opened inside the word.

     The gap alone is only as tall as a capital letter, so what shows through it
     reads as a textured slot rather than as a video. This step grows it to a
     small but unmistakable 16:9 player — a quarter of the frame's width, held
     for a beat — so the clip is legible as footage before it scales up.

     Clamped against both axes: 16% of the width, but never more than 22% of the
     height once the 9/16 is applied, so it stays comfortably inside a short
     landscape phone as well as a tall portrait one. */
  function miniSize() {
    var w = window.innerWidth * 0.16;
    var maxH = window.innerHeight * 0.22;
    if (w * 9 / 16 > maxH) w = maxH * 16 / 9;
    /* Never smaller than the wordmark's own gap — on a narrow phone the
       cap-height slot can already be wider than a quarter of the screen, and
       shrinking back would read as a stutter. */
    var g = gapWidth();
    if (w < g) w = g;
    return { w: Math.round(w), h: Math.round(w * 9 / 16) };
  }

  /* --- The hole ------------------------------------------------------------
     The loader is an opaque navy sheet at z-index 200. The gap is a HOLE cut
     through it with clip-path, so the hero's own video — playing underneath,
     untouched, in its final position — is what shows through.

     Nothing moves and nothing is scaled: the video sits exactly where it will
     finally sit for the whole intro, and only the WINDOW onto it opens. That
     is why the hand-off has no seam — there is no travel to get wrong, and the
     last frame of the intro is already the hero's resting state.

     The hole is an even-odd polygon: the full viewport wound one way, then the
     gap's rect wound the other, which subtracts it. A plain inset() cannot do
     this — inset keeps what is INSIDE, and here everything outside the gap is
     what must stay painted. */
  /* Which layout the hero videos currently carry — 'small' (sized onto the
     hole) or 'full' (handed back to the stylesheet). Tracked so the reset is
     written once on the transition rather than on every ticker frame. */
  var lastFit = null;

  function applyHole() {
    var b = box.getBoundingClientRect();
    var w = window.innerWidth;
    var h = window.innerHeight;

    /* Clamp the hole to the viewport.

       The box is not centred on the frame — the row it sits in is shifted left
       by half the difference between SHIELD and MED so the WORD reads centred
       (see the centring block in run()). At full width that offset carries the
       box past the edges: measured at 1440, it spanned -64 to 1376, leaving a
       64px strip of cover un-punched down the right-hand side. The section
       below the hero showed through that strip during the expansion, which is
       exactly the leak this clamp closes.

       Clamping only ever makes the hole reach the frame edge sooner; it cannot
       shrink it, so the miniature and the expansion are untouched. */
    var x1 = Math.max(0, b.left);
    var x2 = Math.min(w, b.right);
    var y1 = Math.max(0, b.top);
    var y2 = Math.min(h, b.bottom);

    /* A fully collapsed hole would produce a degenerate polygon; keep it valid. */
    if (x2 < x1) x2 = x1;
    if (y2 < y1) y2 = y1;

    /* Outer ring clockwise, inner rect counter-clockwise. evenodd then treats
       the inner rect as a hole rather than as more filled area. */
    var poly =
      'polygon(evenodd, 0px 0px, ' + w + 'px 0px, ' + w + 'px ' + h + 'px, 0px ' + h + 'px, 0px 0px, ' +
      x1 + 'px ' + y1 + 'px, ' + x1 + 'px ' + y2 + 'px, ' + x2 + 'px ' + y2 + 'px, ' + x2 + 'px ' + y1 + 'px, ' + x1 + 'px ' + y1 + 'px)';

    pl.style.clipPath = poly;

    /* SHOW THE WHOLE FRAME WHILE THE BOX IS SMALL.

       The hole decides what is VISIBLE, but the <video> is laid out across the
       whole viewport — so a small hole reveals the middle patch of a 1440px
       frame rather than the shot itself.

       object-fit alone does not fix this: 'contain' fits the video to its
       ELEMENT, and the element is still full-viewport, so the hole goes on
       cropping whatever sits in the middle. The video element has to be sized
       and positioned to the HOLE. Then 'contain' letterboxes the entire frame
       into exactly the rectangle the viewer can see.

       Scaling .hero__media was also wrong (tried, reverted): it shrinks the
       hole along with the video, so the rectangle stays the same size on screen
       while the footage inside it gets smaller.

       Past the threshold everything is handed back to the stylesheet, so the
       video ends full-bleed at object-fit:cover — the hero's real resting state
       and the crop the rest of the design is built around. */
    var small = b.width < w * 0.72;
    var vids = document.querySelectorAll('.hero__video');
    var i, v;

    if (small) {
      var hm = heroMedia.getBoundingClientRect();
      for (i = 0; i < vids.length; i++) {
        v = vids[i];
        v.style.position = 'absolute';
        v.style.left   = (b.left - hm.left) + 'px';
        v.style.top    = (b.top  - hm.top)  + 'px';
        v.style.width  = b.width  + 'px';
        v.style.height = b.height + 'px';
        v.style.objectFit = 'contain';
      }
      lastFit = 'small';
    } else if (lastFit !== 'full') {
      lastFit = 'full';
      for (i = 0; i < vids.length; i++) {
        v = vids[i];
        v.style.position = '';
        v.style.left = '';
        v.style.top = '';
        v.style.width = '';
        v.style.height = '';
        v.style.objectFit = '';
      }
    }
  }

  function clearHole() {
    if (pl) pl.style.clipPath = '';
    /* Hand the videos back to the stylesheet. applyHole() sizes and positions
       them onto the hole while the box is small; if a failsafe tears the intro
       down mid-run, those inline styles would otherwise leave the hero video
       letterboxed in a small rectangle for good. */
    var vids = document.querySelectorAll('.hero__video');
    for (var i = 0; i < vids.length; i++) {
      var v = vids[i];
      v.style.position = '';
      v.style.left = '';
      v.style.top = '';
      v.style.width = '';
      v.style.height = '';
      v.style.objectFit = '';
    }
    lastFit = null;
  }

  /* The gap's target size at the end of the expansion: the viewport, so the
     hole opens until nothing of the cover is left. */
  function fullSize() {
    /* Big enough to cover the frame FROM WHERE THE BOX ACTUALLY SITS.

       The box is not centred on the viewport: its row is shifted left by half
       the difference between SHIELD and MED so the word reads centred. Growing
       it to exactly innerWidth therefore leaves a strip of cover un-punched on
       the far side — measured at 1440 the hole reached only 1376, and the
       section below the hero showed through that 64px strip while the intro
       expanded.

       Adding twice the box's own centre offset makes the hole overshoot
       symmetrically, so both edges clear the frame. The clamp in applyHole()
       trims the overshoot back to the viewport, so nothing is drawn outside it.
       Measured live rather than from the stored offset, because this must stay
       correct if the wordmark's metrics change with the font or the breakpoint. */
    var w = window.innerWidth;
    var h = window.innerHeight;

    var b = box.getBoundingClientRect();
    var boxCentre = b.left + b.width / 2;
    var slip = Math.abs(w / 2 - boxCentre);

    return { w: w + slip * 2, h: h + slip * 2 * (h / w) };
  }

  /* --- Waiting for actual playback -----------------------------------------
     The miniature is the beat where the clip is meant to be READ as video, so
     it must be moving by then — not parked on a first frame.

     Measured before this gate: at the mini stage the hero video reported
     readyState 1 (metadata only) and currentTime 0. The encode is ~6MB, and
     although hero.js promotes the source immediately, the intro reached the
     miniature well before enough had buffered to play. The small box showed a
     frozen frame, which is exactly what it should not show.

     So the timeline pauses before the mini beat and resumes on whichever comes
     first: the video genuinely playing (readyState >= 3 AND currentTime
     advancing), or a short ceiling. The ceiling matters — on a slow connection
     the intro must not hang waiting for a clip that is still downloading, and a
     still frame is a far better outcome than a stalled splash. */
  function whenPlaying(cb) {
    var done = false;
    function go() {
      if (done) return;
      done = true;
      window.clearInterval(iv);
      window.clearTimeout(ceiling);
      cb();
    }

    var v = document.getElementById('hero-video');
    if (!v) { cb(); return; }

    /* Poll rather than listen: 'playing' can fire before any frame is actually
       presented, and currentTime advancing is the honest signal that the
       decoder is running. */
    var last = -1;
    var iv = window.setInterval(function () {
      if (v.readyState >= 3 && v.currentTime > 0 && v.currentTime !== last) go();
      last = v.currentTime;
    }, 50);

    var ceiling = window.setTimeout(go, 1800);
  }

  /* --- Video ---------------------------------------------------------------
     The clip is NOT started here. hero.js owns both hero <video> elements —
     the source promotion, the muted-autoplay dance, and the A/B crossfade that
     masks the loop point. Starting a second playback path from this file would
     race it.

     All this needs is for the hero's video to be visible through the gap, which
     it is: hero.js promotes the source on its own schedule and the clip plays
     underneath the navy cover from the first frame. If it has not buffered yet
     the gap simply shows the hero's ground until it does, which is the same
     behaviour the hero has always had on a cold load. */

  /* --- Timeline ------------------------------------------------------------
     The sequence, in order:

       1. the wordmark rises, letter by letter
       2. the gap opens between MED and SHIELD to 16:9 — the hero video is
          already playing behind it and is revealed through the opening
       3. the gap expands outward to the full frame
       4. WHILE it is still expanding, the hero content is released: the
          headline, then the annotations, then the floor rail, each on the
          stagger the hero's own stylesheet already defines
       5. the navy cover and the wordmark fade, and the loader is removed

     Step 4 is the point: the hero does not wait for the intro to finish and
     then start. Its entrance overlaps the expansion, so the two read as one
     continuous move rather than two animations played back to back.

     expo.inOut throughout, as the reference uses — it holds the slow start and
     the long settle that make the expansion read as one continuous move. */
  /* The pause between beats. One constant so the three stages stay evenly
     spaced if it is tuned. */
  var HOLD = 0.25;

  function run() {
    lock();

    var g = gapWidth();

    /* The two halves. Faded out during the expansion; looked up here rather
       than at module scope because the letters are built into them first. */
    var medEl = pl.querySelector('.preloader__half--med');
    var shEl = pl.querySelector('.preloader__half--shield');

    /* Centre the WORD, not the gap.

       The halves hang off the box's edges, and the box is what the parent
       centres — so with MED at 3 glyphs and SHIELD at 6, the word as a whole
       sits right of centre (measured: its midpoint landed at 784 in a 1440
       frame, 64px off). Shifting the row by half the difference between the
       two halves puts the wordmark's own midpoint on the frame's midpoint.

       Translating the row is safe here in a way it was NOT in earlier
       revisions: the hole is re-measured from the box's live rect every frame,
       so it follows this offset automatically. There is no cached landing
       value left to invalidate. */
    var mark = pl.querySelector('.preloader__mark');
    if (mark && medEl && shEl) {
      var wDiff = shEl.getBoundingClientRect().width -
                  medEl.getBoundingClientRect().width;
      gsap.set(mark, { x: -wDiff / 2 });
    }

    /* The clip is re-applied every frame from the box's live rect. A GSAP
       ticker rather than an onUpdate per tween: several tweens move the box at
       once, and one subscriber keeps the clip in lockstep with all of them. */
    gsap.ticker.add(applyHole);
    applyHole();

    var tl = gsap.timeline({
      defaults: { ease: 'expo.inOut' },
      onComplete: finish
    });

    /* fromTo, not to: GSAP must own BOTH ends of this transform. With the start
       state written in CSS instead, GSAP reads yPercent as 0, tweens 0 -> 0, and
       the stylesheet holds every letter below its own clip box for the whole
       intro — the wordmark never appears. */
    tl.fromTo(letters, {
      yPercent: 110
    }, {
      yPercent: 0,
      stagger: 0.015,
      duration: 0.5,
      ease: 'expo.out'
    });

    /* THREE BEATS, NOT ONE MOVE.

       1. the word lands          — hold
       2. the rectangle forms     — hold
       3. it expands to the frame

       Each stage completes and SETTLES before the next begins. That is the
       point: the viewer should read "MEDSHIELD", then read the video sitting
       inside it, then watch it take the screen — three things in sequence, not
       one continuous swell.

       This is deliberately NOT the merged single tween that was here before.
       That version existed to kill a stall, and it did — but a stall and a beat
       are different things. A stall is motion decelerating to zero PART WAY
       THROUGH a move, which reads as a hitch. A beat is a move that has
       genuinely finished, held, and been followed by another. The eases below
       therefore DO settle (that is what makes each stage land), and the pauses
       between them are explicit rather than accidental.

       The thing to avoid is re-introducing the old fault: no *.inOut ease
       spanning a join, and no leg that eases out into another leg with no hold
       between them. Every stage here ends, waits, and the next starts fresh. */

    /* --- Beat 1 tail: the word has landed. Hold it. --- */
    tl.to({}, { duration: HOLD });

    /* Gate: do not open the gap until the clip is actually running, so the
       miniature shows moving footage rather than a frozen first frame. The
       wordmark simply holds a moment longer while it buffers. */
    tl.addPause(undefined, function () {
      whenPlaying(function () { tl.resume(); });
    });

    /* --- Beat 2: the gap parts the word and becomes the mini player. ------
       One tween, because the gap opening and the rectangle forming are the
       same gesture — the box growing from a slit to a 16:9 frame. It settles
       on expo.out so the rectangle arrives and stops cleanly. */
    tl.to(box, {
      width: function () { return miniSize().w; },
      height: function () { return miniSize().h; },
      duration: 0.7,
      ease: 'expo.out'
    });
    tl.addLabel('mini');

    /* --- Beat 2 tail: the miniature is readable. Hold it. --- */
    tl.to({}, { duration: HOLD });

    /* --- Beat 3: the expansion. -------------------------------------------
       Starts from rest, which is correct here — it is the beginning of a new
       move, not the middle of an interrupted one. power2.in so it builds from
       the held miniature and carries the eye out to the full frame. */
    tl.addLabel('expand');
    tl.to(box, {
      width: function () { return fullSize().w; },
      height: function () { return fullSize().h; },
      duration: 1.0,
      ease: 'power2.in'
    }, 'expand');



    /* The letters clear as the frame opens up — they would otherwise sit on
       top of the full-bleed video with nothing behind them. */
    tl.to(letters, {
      yPercent: -115,
      stagger: 0.02,
      duration: 0.7,
      ease: 'expo.in'
    }, 'expand');

    /* Collapse the two halves as the gap takes over. The letters ride up out of
       view on their own, but their CONTAINERS keep their intrinsic width, and
       as absolutely-positioned children they would go on nudging the layout. */
    /* The halves must be GONE before the hero's own text arrives, not merely
       fading: on the white cover they stay legible far longer than they did on
       navy, and a ghosted SHIELD sitting behind the headline reads as a
       rendering fault. Shortened and eased out early. */
    tl.to([medEl, shEl], {
      opacity: 0,
      duration: 0.5,
      ease: 'power2.in'
    }, 'expand');

    /* THE OVERLAP. The hero is released partway through the 1.7s expansion —
       while the video is still opening outward, not after it has stopped.
       hero.js adds .hero-ready, and the hero's own stylesheet takes it from
       there: headline characters first, annotations at +0.75s, the floor rail
       at +1.15s. Those offsets already existed; all this does is start them at
       the right moment relative to the expansion.

       0.62s into the 1.0s expansion. That is late enough for the video to be
       carrying most of the frame, but still inside the final leg — measured at
       1440x900 the hole is ~1150px wide when this fires, so the hero's
       entrance genuinely overlaps the expansion rather than following it.

       It cannot be much earlier. The hero's headline is WHITE, and the cover
       behind it
       is now white too — so any part of the headline that falls outside the
       expanding video is invisible until the video reaches it. Releasing early
       (which read fine against the old navy cover) left the words half-drawn
       across a white field. By 1.05s the video covers enough of the frame for
       white type to land on it. Re-check this if the cover colour changes
       again: it is tied to the contrast, not to the timing. */
    tl.add(function () { releaseGate(); }, 'expand+=0.62');

    /* The cover dissolves as the hole reaches the frame edges, so the last
       sliver of navy fades rather than being cut away. By this point the hole
       is almost the whole viewport, so there is very little left to fade — it
       exists to take the hard edge off the final frame. */
    /* The cover is REMOVED, not faded.

       A fade here was the leak: autoAlpha tweens the whole element's opacity,
       so for its entire duration the cover was semi-transparent EVERYWHERE —
       not just inside the hole. The page below the hero showed through the
       surround while the video was still expanding, which read as the second
       section expanding too.

       By the time the hole reaches the frame edges the cover has no visible
       area left, so there is nothing to dissolve: cutting it is invisible, and
       it cannot leak. Placed at the very end of the expansion rather than
       overlapping it. */
    tl.set(pl, { autoAlpha: 0 }, 'expand+=1.0');
  }

  /* --- Is the hero actually on screen? --------------------------------------
     The intro belongs to the hero and to a fresh arrival at the top of the
     page. It must NOT run when the page opens somewhere else, which happens in
     two ordinary ways:

       - a reload while scrolled down (browsers restore scroll position)
       - a deep link to a section, e.g. index.html#contact

     Measured before this guard: a reload at 6104px and a #contact link both
     played the whole intro, covering a section that is not the hero and
     hard-locking scroll there while it ran.

     Checked at DOMContentLoaded rather than at parse time, because neither
     scroll restoration nor hash scrolling has been applied yet when this file
     first executes. A small tolerance rather than an exact zero: some browsers
     restore a pixel or two off, and a hash that resolves to the hero itself
     should still count as the top. */
  function atHero() {
    var y = window.scrollY || window.pageYOffset || 0;
    if (y > 4) return false;

    /* A hash pointing anywhere other than the hero means the browser is about
       to jump there even if it has not yet — treat that as "not the hero". */
    var h = window.location.hash;
    if (h && h.length > 1 && h !== '#top') {
      var target = null;
      try { target = document.querySelector(h); } catch (e) {}
      if (target && !heroEl.contains(target) && target !== heroEl) return false;
    }
    return true;
  }

  function boot() {
    /* Not at the hero: leave the page exactly as it is. No cover, no scroll
       lock, and the hero released immediately so its own entrance still runs. */
    if (!atHero()) {
      if (pl && pl.parentNode) pl.parentNode.removeChild(pl);
      releaseGate();
      return;
    }

    try {
      root.classList.add('pl-on');
      run();
    } catch (e) {
      finish();          // failsafe #2
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
}());
