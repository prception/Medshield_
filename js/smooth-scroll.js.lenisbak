/* ==========================================================================
   SMOOTH SCROLL — Lenis
   ==========================================================================
   The reference site (white-desert.com) runs Lenis for its scroll feel. That
   is the whole reason a section "slides up" into view there rather than
   snapping: the wheel does not move the page directly, it moves a target,
   and the page eases toward that target every frame. The reveal animations
   are separate — they are ordinary IntersectionObserver work (see
   about-reveal.js) and just look better riding on an eased scroll.

   Their options, read off the shipped bundle:

       autoRaf: false            they drive raf themselves
       syncTouch: true
       syncTouchLerp: 0.075
       touchInertiaExponent: 1.7
       touchMultiplier: 1
       wheelMultiplier: 1
       lerp: (default 0.1)       never overridden in their config

   Reproduced verbatim below, with autoRaf left ON because we have no other
   raf loop to hang it off — that is an implementation detail of theirs, not
   a feel setting, and it changes nothing the user can perceive.

   PROGRESSIVE ENHANCEMENT
   Lenis is loaded from a CDN. If it fails, is blocked, or the visitor
   prefers reduced motion, this file does nothing at all and the page keeps
   the browser's native scrolling. Nothing else on the page depends on it.
   ========================================================================== */
(function () {
  'use strict';

  var reduced = window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Smooth scrolling is a motion effect; honour the same opt-out the reveal
     system honours. */
  if (reduced) return;

  function start() {
    if (typeof window.Lenis !== 'function') return;   /* CDN blocked — native scroll */

    var lenis = new window.Lenis({
      autoRaf: false,
      syncTouch: true,
      syncTouchLerp: 0.075,
      touchInertiaExponent: 1.7,
      touchMultiplier: 1,
      wheelMultiplier: 1
    });

    /* Lenis takes the page off native scrolling: it moves the content itself
       and announces movement on its OWN event bus (lenis.on('scroll')), never
       by dispatching a native scroll event. So window 'scroll' listeners go
       silent the moment Lenis starts, which is why the scroll-driven pieces
       on this page (hero-parallax.js, vm-steps.js) must be told directly.

       The instance is published for them to subscribe to, and a native-style
       event is re-emitted on window so anything else listening the ordinary
       way keeps working. */
    window.medshieldLenis = lenis;

    /* Lenis listens for native 'scroll' itself (onNativeScroll), so
       re-dispatching one from inside its own scroll callback feeds straight
       back into it: dispatch -> onNativeScroll -> emit -> this handler ->
       dispatch, until the stack blows. That threw thousands of
       RangeErrors per scroll and ate the frame budget, which is what made
       the page feel stuck.

       The re-entry flag breaks the cycle: the event Lenis hands back to us
       is ignored while we are still inside our own dispatch. */
    var reEmitting = false;

    lenis.on('scroll', function () {
      if (reEmitting) return;
      reEmitting = true;
      window.dispatchEvent(new Event('scroll'));
      reEmitting = false;
    });

    function raf(time) {
      lenis.raf(time);
      window.requestAnimationFrame(raf);
    }
    window.requestAnimationFrame(raf);

    /* In-page anchors (the "Read more" jump to #founders, the skip link)
       must go through Lenis, or they fight it and land in the wrong place. */
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="#"]');
      if (!a) return;
      var id = a.getAttribute('href');
      if (!id || id === '#') return;
      var target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      lenis.scrollTo(target);
    });

    /* The nav overlay locks the page behind it; Lenis has to be told, or it
       keeps easing the body underneath the open menu. */
    var toggle = document.getElementById('nav-toggle');
    if (toggle) {
      toggle.addEventListener('click', function () {
        window.setTimeout(function () {
          if (toggle.getAttribute('aria-expanded') === 'true') {
            lenis.stop();
          } else {
            lenis.start();
          }
        }, 0);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
