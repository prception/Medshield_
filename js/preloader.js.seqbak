/* ===========================================================================
   preloader.js — wordmark-to-hero reveal
   ===========================================================================
   MED | video | SHIELD. A 16:9 gap opens between the two halves of the word,
   the hero clip plays inside it, then the gap and the clip grow until the clip
   sits exactly where .hero__media sits, and the loader lifts.

   WHY THE MEASUREMENT MATTERS
   The final move is not "scale up until it looks full-screen". The script
   measures the REAL .hero__media rectangle, and animates the small box width,
   height and translate onto that rect. That is what makes the hand-off
   invisible: at the last frame the loader's clip and the hero's clip occupy
   identical pixels, so removing one and showing the other is not a visible
   swap.

   ORDERING WITH hero.js
   hero.js reveals the headline on document.fonts.ready, with a hard 900ms
   floor. Left alone it would run its whole entrance UNDER the loader and be
   finished by the time the loader lifted. So this file sets a gate —
   window.__preloaderGate — that hero.js awaits before revealing. If this file
   is absent, that gate is undefined and hero.js reveals immediately, exactly
   as it does today.

   FAIL-VISIBLE, THREE WAYS
   The page must never be left stuck behind a splash:
     1. finish() runs onComplete
     2. every entry point is wrapped in try/catch, and the catch calls finish()
     3. a 7000ms setTimeout calls finish() regardless
   finish() is idempotent, so whichever fires first wins and the rest no-op.
   =========================================================================== */

(function () {
  'use strict';

  var root = document.documentElement;
  var pl = document.getElementById('preloader');

  /* --- The gate ------------------------------------------------------------
     Created BEFORE any early return, and always resolved. hero.js waits on
     this; if we bail out for any reason it must resolve immediately or the
     hero would never appear at all. */
  var releaseGate;
  var gateDone = false;
  window.__preloaderGate = new Promise(function (resolve) {
    releaseGate = function () {
      if (gateDone) return;
      gateDone = true;
      resolve();
    };
  });

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* The intro runs on EVERY page load, as the reference site does — there is
     deliberately no once-per-session check here. An earlier revision stored an
     'ms-preloader' flag in sessionStorage and skipped the intro when it was
     set; that is gone, and nothing writes that key any more. A stale value left
     in a browser from that revision is simply ignored. */

  /* Bail-out path. No loader element, reduced motion, or no GSAP: release the
     hero and leave the DOM untouched. */
  if (!pl || reduce || !window.gsap) {
    if (pl && pl.parentNode) pl.parentNode.removeChild(pl);
    releaseGate();
    return;
  }

  var gsap = window.gsap;
  var box = document.getElementById('preloader-box');
  var media = document.getElementById('preloader-media');
  var video = document.getElementById('preloader-video');

  /* --- Scroll lock ---------------------------------------------------------
     Compensating padding for the scrollbar width, so locking does not shift
     the page sideways underneath the loader. */
  var locked = false;
  function lock() {
    if (locked) return;
    locked = true;
    var sw = window.innerWidth - root.clientWidth;
    if (sw > 0) root.style.paddingRight = sw + 'px';
    root.classList.add('pl-lock');
    window.scrollTo(0, 0);
  }

  function unlock() {
    if (!locked) return;
    locked = false;
    root.classList.remove('pl-lock');
    root.style.paddingRight = '';
  }

  /* --- Teardown ------------------------------------------------------------
     Idempotent: whichever of the three failure paths fires first wins. */
  var finished = false;
  function finish() {
    if (finished) return;
    finished = true;
    unlock();
    releaseGate();          // hero.js may now run its entrance
    /* One frame of overlap before removal. The hero is revealed by the gate
       above; taking the loader out in the same frame can show a flash of the
       page ground between the two. */
    requestAnimationFrame(function () {
      if (pl && pl.parentNode) pl.parentNode.removeChild(pl);
      try {
        if (video) {
          video.pause();
          video.removeAttribute('src');
          video.load();     // release the decoder; the hero has its own copy
        }
      } catch (e) {}
    });
  }

  window.setTimeout(finish, 7000);   // failsafe #3

  /* --- Letter split --------------------------------------------------------
     Each letter gets its own clip box so it can slide up from below its own
     baseline. Built from data-pl-word rather than written out in the markup,
     which keeps the decorative duplicate of the brand name out of the DOM for
     anything that ignores aria-hidden. */
  function buildWord(el) {
    var word = el.getAttribute('data-pl-word') || '';
    var frag = document.createDocumentFragment();
    for (var i = 0; i < word.length; i++) {
      var mask = document.createElement('span');
      mask.className = 'preloader__letter';
      var inner = document.createElement('span');
      inner.textContent = word[i];
      mask.appendChild(inner);
      frag.appendChild(mask);
    }
    el.appendChild(frag);
    return el.querySelectorAll('.preloader__letter > span');
  }

  var letters = [];
  Array.prototype.forEach.call(
    pl.querySelectorAll('[data-pl-word]'),
    function (el) {
      letters = letters.concat(Array.prototype.slice.call(buildWord(el)));
    }
  );

  /* --- Geometry ------------------------------------------------------------
     The gap's target width: 16:9 against the wordmark's own cap height, so the
     box is proportioned to the type rather than to an arbitrary vw figure.
     Clamped so the assembled row (MED + gap + SHIELD) can never exceed 92% of
     the frame — without this the word is pushed off-screen on a narrow phone. */
  function gapWidth() {
    var h = box.getBoundingClientRect().height;
    if (!h) return Math.round(window.innerWidth * 0.3);
    var want = h * 16 / 9;
    var row = pl.querySelector('.preloader__mark');
    if (row) {
      var rest = row.getBoundingClientRect().width - box.getBoundingClientRect().width;
      var max = window.innerWidth * 0.92 - rest;
      if (max > 0 && want > max) want = max;
    }
    return Math.round(want);
  }

  /* The hero's real rectangle. Measured, not assumed: .hero is 100vh and the
     media layer fills it, but reading the rect keeps this correct if that
     ever changes. */
  function heroRect() {
    var hm = document.querySelector('.hero__media') || document.querySelector('.hero');
    if (!hm) {
      return { w: window.innerWidth, h: window.innerHeight, x: 0, y: 0 };
    }
    var r = hm.getBoundingClientRect();
    return { w: r.width, h: r.height, x: r.left, y: r.top };
  }

  /* The media element is centred in the box via translate(-50%, -50%), so the
     translate needed to land on the hero rect is the delta between the two
     CENTRES — not the delta between their top-left corners.

     MEASURED ONCE, and cached. This must NOT be re-read on every tick: the box
     is itself widening during the same tween, which drags its centre leftward,
     so a live re-measure makes the target chase the thing aiming at it and the
     clip settles ~300px off-centre. The correct target is the delta as it
     stands at the MOMENT THE EXPANSION BEGINS, held fixed for the whole move. */
  var land = null;

  /* Read the cached target. The fallback is the viewport rather than null, so
     that if the measurement were ever skipped the expansion still plays to a
     sane size instead of throwing on every frame of the tween. */
  function L(k) {
    if (land) return land[k];
    var f = { w: window.innerWidth, h: window.innerHeight, x: 0, y: 0 };
    return f[k];
  }

  /* The travel needed to bring the clip's centre onto the hero's centre.

     Measured against the MEDIA element, not the box. The box's left edge slides
     as it widens (it is a flex item being pushed between MED and SHIELD), so a
     delta measured from the box is already stale by the next frame and the clip
     settles a few hundred px off. The media element is the thing being moved,
     and its current x is known — so the target is simply its existing x plus
     the remaining centre-to-centre delta, which stays true for the whole tween. */
  function measureLanding() {
    var t = heroRect();

    /* The box's centre at the END of the move, not at the start, and derived
       rather than read.

       The media sits at left:50%/top:50% of the box, so its resting centre IS
       the box's centre. But the box grows from 1em to the full hero rect during
       this very tween, so its CURRENT centre is not where it will be — reading
       it aims at a point that no longer exists by the last frame (earlier
       revisions settled 306px off horizontally, 54px vertically).

       The box is centred in the frame by .preloader (grid + place-items:center)
       and stays centred as it grows, so its end centre is the viewport's centre
       in both axes. The translate is then the delta from there to the HERO's
       centre. Note that delta is not zero: .hero is 100vh tall but its video
       layer is taller than the viewport at this aspect (1008px in a 900px
       frame), so the clip has to finish slightly low to cover it — a y of ~54
       here is correct, not drift. */
    var endCx = window.innerWidth / 2;
    var endCy = window.innerHeight / 2;

    land = {
      w: t.w,
      h: t.h,
      x: (t.x + t.w / 2) - endCx,
      y: (t.y + t.h / 2) - endCy
    };
    return land;
  }

  /* --- Video ---------------------------------------------------------------
     The source is promoted only now, once we know the intro is running. The
     clip is the same file the hero uses, so this is a warm cache hit for the
     hero rather than a second download. */
  function startVideo() {
    if (!video) return;
    var src = video.getAttribute('data-src');
    if (src && !video.src) {
      video.src = src;
      try { video.load(); } catch (e) {}
    }
    var p = video.play();
    /* Autoplay can still be refused. That is not fatal — the box then grows
       around a still first frame, and the composition survives. */
    if (p && p.catch) p.catch(function () {});
  }

  /* --- Timeline ------------------------------------------------------------
     Beat 1  letters rise, staggered
     Beat 2  the gap opens to 16:9, pushing MED and SHIELD apart
     Beat 3  gap and clip expand onto the measured hero rect
     Beat 4  the loader fades out over the hero already sitting beneath it

     expo.inOut throughout, as the reference uses — it holds the slow start and
     the long settle that make the expansion read as one continuous move. */
  function run() {
    lock();
    startVideo();

    /* Media starts filling its (zero-width) box; sized in px from here on so
       the growth to the hero rect is a single interpolation. */
    var g = gapWidth();
    var boxH = box.getBoundingClientRect().height;

    /* xPercent/yPercent carry the centring that the stylesheet deliberately
       does NOT apply (see .preloader__media). These stay fixed at -50 for the
       whole timeline; only x/y move, and GSAP composes the two. */
    gsap.set(media, {
      xPercent: -50,
      yPercent: -50,
      x: 0,
      y: 0,
      width: g,
      height: Math.round(g * 9 / 16) || boxH
    });

    /* No centring compensation is needed here any more.

       The stylesheet anchors MED and SHIELD absolutely to the box's own edges
       (see .preloader__half), so the gap is centred by its parent and the
       halves are pushed apart for free as it widens. Earlier revisions of this
       file translated the halves, the box, or the row to force the gap onto
       centre — every one of those moved the rect the landing translate is
       measured against, and the clip settled 60-300px off the hero. */
    var medEl = pl.querySelector('.preloader__half--med');
    var shEl = pl.querySelector('.preloader__half--shield');

    var tl = gsap.timeline({
      defaults: { ease: 'expo.inOut' },
      onComplete: finish
    });

    /* fromTo, not to: GSAP must own BOTH ends of this transform. With the start
       state written in CSS instead, GSAP reads yPercent as 0, tweens 0 → 0, and
       the stylesheet holds every letter below its own clip box for the whole
       intro — the wordmark never appears. */
    tl.fromTo(letters, {
      yPercent: 110
    }, {
      yPercent: 0,
      stagger: 0.03,
      duration: 1.1,
      ease: 'expo.out'
    });

    /* The gap opens. '-=0.35' overlaps it with the tail of the letter stagger
       so the word is still settling as the box starts to part it. */
    tl.to(box, {
      width: g,
      duration: 1.2
    }, '-=0.35');

    /* The expansion.

       measureLanding() is placed as its own timeline callback, NOT as an
       onStart on the tween below. GSAP resolves a tween's function-based
       values when that tween initialises, and with two tweens starting on the
       same tick the media tween can initialise BEFORE the box tween's onStart
       has run — leaving the cache null and throwing on every frame. A .call()
       occupies its own slot in the sequence, so the measurement is guaranteed
       to have happened before either tween reads it. */
    tl.call(measureLanding, null, '+=0.15');

    /* The box grows in BOTH axes. Width alone leaves its height at the
       wordmark's 1em cap height, so the opening sweeps out to full width while
       still only one line tall — the clip reads as a letterbox band across the
       middle of the frame rather than an image opening out. Growing the height
       on the same curve keeps the gap's 16:9 proportion as it scales. */
    tl.to(box, {
      width: function () { return L('w'); },
      height: function () { return L('h'); },
      duration: 1.6
    });

    tl.to(media, {
      width: function () { return L('w'); },
      height: function () { return L('h'); },
      x: function () { return L('x'); },
      y: function () { return L('y'); },
      duration: 1.6
    }, '<');

    /* The letters clear as the frame opens up — they would otherwise sit on
       top of the full-bleed video with nothing behind them. */
    tl.to(letters, {
      yPercent: -115,
      stagger: 0.02,
      duration: 0.8,
      ease: 'expo.in'
    }, '<');

    /* Collapse the two halves as the gap takes over.

       The letters ride up out of view on their own, but their CONTAINERS keep
       their intrinsic width, and as flex siblings they go on reserving space
       the box cannot have. Without this the gap stops short of the frame edges
       by exactly the wordmark's width — measured, it settled at x:243 on a
       1440px viewport instead of 0, so the clip never actually went full-bleed.
       Collapsing them to zero width lets the box reach the true hero rect. */
    tl.to([medEl, shEl], {
      width: 0,
      opacity: 0,
      duration: 1.2,
      ease: 'expo.inOut'
    }, '<');

    /* The hand-off. The hero is released one beat BEFORE the loader fades, so
       the headline entrance is already under way behind the dissolve rather
       than starting from nothing on an empty frame. */
    tl.add(function () { releaseGate(); });

    tl.to(pl, {
      autoAlpha: 0,
      duration: 0.5,
      ease: 'power2.out'
    }, '+=0.05');
  }

  function boot() {
    try {
      root.classList.add('pl-on');
      run();
    } catch (e) {
      finish();          // failsafe #2
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
}());
