  <!-- 10 - Contact + form ....................................... -->
  <section class="contact" id="contact" aria-labelledby="contact-h">
    <!-- The tinted ground is this panel, not the section, so hero.js can scrub
         --cta-p as the section scrolls through and pull the side gutters open.

         Layout follows the reference's contact block: the statement sits in
         the left column and the form occupies the right. Everything else —
         colour, type, field copy — stays ours.

         No data-bar-ink here: the panel is a LIGHT ground, so the header keeps
         its dark ink over it. It carried the marker while the panel was navy. -->
    <div class="contact__panel">
      <div class="shell contact__inner">

        <div class="contact__intro">
          <p class="eyebrow">Request a proposal</p>
          <h2 class="contact__title" id="contact-h">Your next medical case is already at sea</h2>
          <p class="contact__lede">
            Send us your fleet profile and we will come back with a coverage proposal
            and an indicative annual medical welfare budget.
          </p>

          <aside class="emergency" aria-labelledby="emergency-h">
            <h3 class="emergency__title" id="emergency-h">Medical emergency at sea right now?</h3>
            <p class="emergency__body">
              Do not use this form. Call
              <strong class="confirm">[CONFIRM: 24/7 number]</strong>
              - answered by a coordinator, any hour.
            </p>
            <p class="emergency__note">
              This number is not yet published. It must ring a monitored line before launch.
            </p>
          </aside>
        </div>

        <div class="contact__formwrap">

          <!-- Underline fields, no boxes, matching the reference. The <label>
               is kept on every control rather than being replaced by a
               placeholder: the reference leans on placeholder-as-label, which
               leaves a screen reader with an unnamed input and wipes the field
               name the moment you type. Ours renders in the same position and
               at the same weight, then rises out of the way on focus/fill, so
               it reads identically and still names the field. -->
          <form class="form" id="proposal-form" novalidate>

            <div class="field">
              <input type="text" id="f-name" name="name" autocomplete="name" required
                     placeholder=" " aria-describedby="e-name">
              <label for="f-name">Name</label>
              <p class="field__error" id="e-name" hidden></p>
            </div>

            <div class="field">
              <input type="text" id="f-company" name="company" autocomplete="organization" required
                     placeholder=" " aria-describedby="e-company">
              <label for="f-company">Company</label>
              <p class="field__error" id="e-company" hidden></p>
            </div>

            <div class="field">
              <input type="email" id="f-email" name="email" autocomplete="email" required
                     placeholder=" " aria-describedby="e-email">
              <label for="f-email">Work email</label>
              <p class="field__error" id="e-email" hidden></p>
            </div>

            <!-- Selects carry a permanent label: there is no empty state to
                 float back down into once a value is chosen. -->
            <div class="field field--select">
              <label for="f-fleet">Fleet size</label>
              <select id="f-fleet" name="fleet" required aria-describedby="e-fleet">
                <option value="">Select…</option>
                <option>1–5</option>
                <option>6–20</option>
                <option>21–50</option>
                <option>50+</option>
              </select>
              <p class="field__error" id="e-fleet" hidden></p>
            </div>

            <div class="field field--select">
              <label for="f-vessel">Vessel type</label>
              <select id="f-vessel" name="vessel" required aria-describedby="e-vessel">
                <option value="">Select…</option>
                <option>Cruise</option>
                <option>Cargo</option>
                <option>Offshore</option>
                <option>Yacht</option>
                <option>Mixed</option>
              </select>
              <p class="field__error" id="e-vessel" hidden></p>
            </div>

            <!-- Field 6 of the seven CONTENT.md specifies. Optional on
                 purpose: it flags displacement (they already pay someone) vs.
                 first purchase, which changes how the proposal is written,
                 without making the visitor disclose a supplier to get a
                 quote. -->
            <div class="field field--select">
              <label for="f-current">Current arrangement <span class="field__opt">(optional)</span></label>
              <select id="f-current" name="current">
                <option value="">Select…</option>
                <option>In-house</option>
                <option>Another provider</option>
                <option>None yet</option>
              </select>
            </div>

            <!-- The reference's inline "select all that apply" row, carrying
                 our four actual revenue lines in the order section 05 uses.
                 Claims leads deliberately: CONTENT.md notes that leading with
                 telemedicine confirms the visitor's wrong assumption that
                 MedShield is another remote-doctor service. Optional — it
                 routes the enquiry, it does not qualify it. -->
            <fieldset class="checks">
              <legend class="checks__legend">Interested in (optional)</legend>
              <div class="checks__row">
                <!-- Visible labels are the short forms so the four sit on ONE
                     line; the submitted value keeps the full service name. -->
                <label class="check">
                  <input type="checkbox" name="interest" value="Claims management">
                  <span>Claims</span>
                </label>
                <label class="check">
                  <input type="checkbox" name="interest" value="Claims advisory &amp; legal">
                  <span>Advisory</span>
                </label>
                <label class="check">
                  <input type="checkbox" name="interest" value="Medical welfare budgeting">
                  <span>Budgeting</span>
                </label>
                <label class="check">
                  <input type="checkbox" name="interest" value="Telemedicine">
                  <span>Telemedicine</span>
                </label>
              </div>
            </fieldset>

            <div class="field">
              <textarea id="f-message" name="message" rows="3" placeholder=" "></textarea>
              <label for="f-message">Anything else to share? <span class="field__opt">(optional)</span></label>
            </div>

            <!-- Honeypot: not a CAPTCHA. Hidden from users and assistive tech. -->
            <div class="hp" aria-hidden="true">
              <label for="f-role">Do not fill this in</label>
              <input type="text" id="f-role" name="role" tabindex="-1" autocomplete="off">
            </div>

            <!-- The reference ends on a bare right-aligned "SEND ↗" rather than
                 a filled button. Kept as a real <button> so it stays keyboard
                 and screen-reader operable. -->
            <div class="form__send">
              <button class="send" type="submit">
                Send <span class="send__arrow" aria-hidden="true">&#8599;</span>
              </button>
            </div>

            <p class="form__foot">
              We use these details to prepare your proposal. No newsletter, no list.
            </p>
          </form>

          <!-- Success state replaces the form in place. No redirect. -->
          <div class="success" id="form-success" hidden tabindex="-1" role="status">
            <p class="success__mark" aria-hidden="true">✓</p>
            <h3 class="success__title">Received.</h3>
            <p class="success__body">A case manager will reply within one business day.</p>
          </div>

        </div>
      </div>
    </div>
  </section>

</main>

<!-- Footer. Structure follows the obscurastudio.webflow.io reference: one
     12-column grid, a tall gap between the link band and the bottom band, the
     statement/contact block anchored bottom-left of the top row and the link
     columns pushed hard right, then an oversized wordmark spanning all twelve
     columns as the closing gesture. Content, palette and type are ours; the
     reference contributed only the arrangement.

     The reference opens with a "let's build something" CTA band. We do not
     repeat that here — the contact form is the section directly above, so a
     second CTA would ask twice. The one-line invitation lives inside the
     statement block instead. -->
<!-- The pale-to-blue transition is no longer a separate element: the footer
     paints it itself, as a second background layer, so the shade runs
     continuously with no boundary that can show a seam.

     BAR INK. data-bar-ink="light" therefore CANNOT sit on <footer> any more.
     hero.js decides the header's ink from the bounding rect of each marked
     element, and the footer's rect now includes the near-white top of the
     lead-in — marking the whole footer "deep" would render the white wordmark
     on a near-white ground, the exact bug the old split avoided. The marker
     moves to an empty child positioned over the genuinely dark region only
     (everything below the lead-in), so the ink still flips at the right
     scroll position. Purely decorative: aria-hidden. -->
<footer class="site-footer">
  <div class="site-footer__deep-probe" data-bar-ink="light" aria-hidden="true"></div>
  <div class="shell">
    <div class="site-footer__main">

      <div class="site-footer__top">

        <!-- Bottom-left of the row, per the reference's footer_email_wrap:
             positioning statement, then a small caption, then the contact
             address set large as the block's real focal point. -->
        <div class="site-footer__statement">
          <p class="site-footer__claim">
            MedShield manages crew medical claims for owners who treat seafarer
            health as seriously as the vessel itself.
          </p>
          <p class="site-footer__cap site-footer__cap--left">Get in touch</p>
          <!-- Real email and phone are still [CONFIRM] in CONTENT.md, so this
               points at the form rather than guessing an address. -->
          <a class="site-footer__email" href="#contact">Request a proposal</a>
          <p class="site-footer__offices">
            <strong>Chennai, India</strong> — HQ
            <span aria-hidden="true">·</span> <strong>Singapore</strong>
            <span aria-hidden="true">·</span> <strong>Dubai, UAE</strong>
          </p>
        </div>

        <!-- Two link columns, right-aligned. Every target is a real id on this
             page. Careers has no page yet and stays omitted rather than
             linked to nothing. -->
        <nav class="site-footer__links" aria-label="Footer navigation">
          <p class="site-footer__cap" id="ft-nav">Navigation</p>
          <ul aria-labelledby="ft-nav">
            <li><a class="site-footer__link" href="#top">Home</a></li>
            <li><a class="site-footer__link" href="#about">About</a></li>
            <li><a class="site-footer__link" href="#services">Services</a></li>
            <li><a class="site-footer__link" href="#case-studies">Case studies</a></li>
            <li><a class="site-footer__link" href="#process">How it works</a></li>
          </ul>
        </nav>

        <nav class="site-footer__links" aria-label="Footer services">
          <p class="site-footer__cap" id="ft-svc">Services</p>
          <ul aria-labelledby="ft-svc">
            <li><a class="site-footer__link" href="#claims">Claims management</a></li>
            <li><a class="site-footer__link" href="#advisory">Claims advisory</a></li>
            <li><a class="site-footer__link" href="#budgeting">Welfare budgeting</a></li>
            <li><a class="site-footer__link" href="#telemedicine">Telemedicine</a></li>
          </ul>
        </nav>
      </div>

      <!-- Bottom band. The reference closes on a full-width SVG wordmark; ours
           is live text so it stays selectable, searchable and scalable. -->
      <div class="site-footer__bottom">
        <p class="site-footer__wordmark" aria-hidden="true">MEDSHIELD<span>®</span></p>

        <div class="site-footer__legal">
          <p>© 2026 MedShield. All rights reserved.</p>
          <p class="site-footer__pending">
            Privacy Policy and Terms of Service pending — not linked until the
            pages exist.
          </p>
        </div>
      </div>

    </div>
  </div>
</footer>

<!-- Floating controls, bottom-right. The WhatsApp pill sits directly above the
     back-to-top square; both reveal together once the hero has scrolled past. -->
<a class="wa-float" id="wa-float"
   href="https://wa.me/00000000000?text=Hi%20MedShield%20-%20I%27d%20like%20to%20talk%20about%20crew%20medical%20cover."
   target="_blank" rel="noopener" aria-label="Chat with MedShield on WhatsApp">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
  </svg>
</a>

<button type="button" class="to-top-fill" id="to-top" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>
  </svg>
</button>

<script>
(function () {
  'use strict';

  var wa   = document.getElementById('wa-float');
  var top  = document.getElementById('to-top');
  var hero = document.querySelector('.hero');
  if (!wa && !top) return;

  function reveal(on) {
    if (wa)  wa.classList.toggle('show', on);
    if (top) top.classList.toggle('show', on);
  }

  // IntersectionObserver over a scroll listener: the browser does the work off
  // the main thread, so this never fights the GSAP ScrollTriggers in 03/04.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      reveal(!entries[0].isIntersecting);
    }, { threshold: 0 }).observe(hero);
  } else {
    // No hero on the page, or a browser without IO: fall back to scroll depth.
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        ticking = false;
        reveal(window.scrollY > window.innerHeight * 0.6);
      });
    }, { passive: true });
  }

  // Fill level. --p is a unitless number the stylesheet multiplies into a
  // percentage, so the gradient stop tracks how far down the page we are.
  if (top) {
    var pTicking = false;

    function paint() {
      pTicking = false;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      // A page shorter than the viewport has nothing to report — show it empty
      // rather than dividing by zero and filling the square outright.
      var p = max > 0 ? (window.scrollY / max) * 100 : 0;
      top.style.setProperty('--p', Math.max(0, Math.min(100, p)).toFixed(1));
    }

    window.addEventListener('scroll', function () {
      if (pTicking) return;
      pTicking = true;
      window.requestAnimationFrame(paint);
    }, { passive: true });

    // Sections 03/04 pin on scroll, so total height changes as they resolve.
    window.addEventListener('resize', paint, { passive: true });
    paint();

    top.addEventListener('click', function () {
      // hero.js runs a wheel-driven smooth-scroll engine on non-touch, non
      // reduced-motion setups. Where it is active it owns the scroll position:
      // a native smooth scrollTo fights its scroll listener and stalls partway,
      // so hand it the target and let its own loop drive.
      if (window.__medshieldScroll && window.__medshieldScroll.scrollTo) {
        window.__medshieldScroll.scrollTo(0);
        return;
      }
      // Engine absent (touch, or reduced motion): the browser handles it. The
      // stylesheet already drops smooth behaviour under reduced motion.
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }
})();
</script>

<script>
(function () {
  'use strict';

  var form    = document.getElementById('proposal-form');
  var success = document.getElementById('form-success');
  if (!form || !success) return;

  // Messages name the fix, never "invalid input".
  var MESSAGES = {
    name:    'Enter your name',
    company: 'Enter your company name',
    email:   'Enter a work email address',
    fleet:   'Choose a fleet size',
    vessel:  'Choose a vessel type'
  };

  function errorNode(field) {
    return document.getElementById('e-' + field);
  }

  function showError(input, message) {
    var node = errorNode(input.name);
    input.setAttribute('aria-invalid', 'true');
    if (node) {
      node.textContent = message;
      node.hidden = false;
    }
  }

  function clearError(input) {
    var node = errorNode(input.name);
    input.removeAttribute('aria-invalid');
    if (node) {
      node.textContent = '';
      node.hidden = true;
    }
  }

  function validate(input) {
    var value = (input.value || '').trim();
    if (!value) return MESSAGES[input.name] || 'This field is required';
    if (input.name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
      return MESSAGES.email;
    }
    return null;
  }

  var required = Array.prototype.slice.call(
    form.querySelectorAll('[required]')
  );

  // Re-validate on blur only once a field has been touched, so the form never
  // shouts at someone who is still typing.
  required.forEach(function (input) {
    input.addEventListener('blur', function () {
      var message = validate(input);
      if (message) { showError(input, message); } else { clearError(input); }
    });
    input.addEventListener('input',  function () { clearError(input); });
    input.addEventListener('change', function () { clearError(input); });
  });

  form.addEventListener('submit', function (event) {
    event.preventDefault();

    var firstBad = null;

    required.forEach(function (input) {
      var message = validate(input);
      if (message) {
        showError(input, message);
        if (!firstBad) firstBad = input;
      } else {
        clearError(input);
      }
    });

    if (firstBad) {
      firstBad.focus();
      return;
    }

    // Honeypot: silently accept, never submit. A bot gets the success state
    // and no signal that it was caught.
    var trap = form.querySelector('[name="role"]');
    var isBot = trap && trap.value !== '';

    if (!isBot) {
      // TODO: wire to endpoint - POST new FormData(form) to the MedShield
      // inbox / CRM. Until then nothing leaves the browser.
    }

    form.hidden = true;
    success.hidden = false;
    success.focus();
  });
})();
</script>

<script src="js/hero.js" defer></script>

<!-- Sections 03 and 04. Self-hosted like every other asset here — no CDN, in
     keeping with the no-build-step, no-CDN rule the stylesheet states. All are
     plain scripts, so `defer` keeps them in order ahead of the section files,
     each of which guards on window.gsap and bails out cleanly. -->
<script src="js/vendor/gsap.min.js" defer></script>
<script src="js/vendor/ScrollTrigger.min.js" defer></script>
<script src="js/doubts.js" defer></script>
<script src="js/services.js" defer></script>
<script src="js/why.js" defer></script>

</body>
</html>
