<div class="nav-scrim" id="nav-scrim" hidden></div>

<main id="main">
  <!-- 1-2. Hero: breadcrumb, title and lede, vertically centred in the band -->
  <section class="c-hero" aria-labelledby="contact-h">
    <div class="shell c-hero__inner">

      <nav class="crumb" aria-label="Breadcrumb">
        <ol class="crumb__list">
          <li><a href="index.html">Home</a></li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>

      <div class="c-intro__wrap">
        <div class="c-intro__main">
          <h1 class="c-intro__title" id="contact-h">Contact us</h1>
        </div>
        <div class="c-intro__aside">
          <p class="c-intro__lede">
            Do you have a question, or would you like a coverage proposal for your
            fleet? Our case managers are ready to help. Send us your fleet profile
            and we will come back with an indicative annual medical welfare budget.
          </p>
          <a class="c-intro__cta" href="#contact-form">Fill in our contact form</a>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Get in touch - form left, contact channels right -->
  <section class="git" id="contact-form" aria-labelledby="git-h">
    <div class="shell git__inner">
      <h2 class="git__title" id="git-h">Get in touch</h2>

      <div class="git__cols">

        <div class="git__formcol">
          <h3 class="git__sub">Send a message</h3>
          <p class="git__lede">
            Send us your fleet profile and we will come back with a coverage
            proposal and an indicative annual medical welfare budget.
          </p>

          <form class="cform" id="proposal-form" novalidate>
            <div class="cform__grid">

              <div class="cfield">
                <input type="text" id="f-name" name="name" autocomplete="name" required
                       placeholder=" " aria-describedby="e-name">
                <label for="f-name">Name</label>
                <p class="cfield__error" id="e-name" hidden></p>
              </div>

              <div class="cfield">
                <input type="email" id="f-email" name="email" autocomplete="email" required
                       placeholder=" " aria-describedby="e-email">
                <label for="f-email">Work e-mail</label>
                <p class="cfield__error" id="e-email" hidden></p>
              </div>

              <div class="cfield">
                <input type="text" id="f-company" name="company" autocomplete="organization" required
                       placeholder=" " aria-describedby="e-company">
                <label for="f-company">Company</label>
                <p class="cfield__error" id="e-company" hidden></p>
              </div>

              <div class="cfield">
                <input type="tel" id="f-phone" name="phone" autocomplete="tel" placeholder=" ">
                <label for="f-phone">Phone number</label>
              </div>

              <div class="cfield cfield--select">
                <select id="f-topic" name="topic" required aria-describedby="e-topic">
                  <option value="">Interested in</option>
                  <option>Claims management</option>
                  <option>Claims advisory &amp; legal</option>
                  <option>Medical welfare budgeting</option>
                  <option>Telemedicine</option>
                  <option>General enquiry</option>
                </select>
                <p class="cfield__error" id="e-topic" hidden></p>
              </div>

              <div class="cfield cfield--select">
                <select id="f-fleet" name="fleet" required aria-describedby="e-fleet">
                  <option value="">Fleet size</option>
                  <option>1&ndash;5</option>
                  <option>6&ndash;20</option>
                  <option>21&ndash;50</option>
                  <option>50+</option>
                </select>
                <p class="cfield__error" id="e-fleet" hidden></p>
              </div>

              <div class="cfield cfield--full">
                <textarea id="f-message" name="message" rows="3" placeholder=" "></textarea>
                <label for="f-message">Message</label>
              </div>

            </div>

            <div class="hp" aria-hidden="true">
              <label for="f-role">Do not fill this in</label>
              <input type="text" id="f-role" name="role" tabindex="-1" autocomplete="off">
            </div>

            <button class="cbtn" type="submit">
              <span aria-hidden="true">&#8594;</span> Submit
            </button>
          </form>

          <div class="success" id="form-success" hidden tabindex="-1" role="status">
            <p class="success__mark" aria-hidden="true">&#10003;</p>
            <h3 class="success__title">Received.</h3>
            <p class="success__body">A case manager will reply within one business day.</p>
          </div>
        </div>

        <div class="git__infocol">

          <div class="git-item">
            <h3 class="git-item__title">Call us</h3>
            <p class="git-item__body">
              Our case managers in Chennai answer during Indian business hours.
            </p>
            <p class="git-item__link">
              <span class="git-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.5 3h3l2 5-2.5 1.5a12 12 0 0 0 5.5 5.5L16 12.5l5 2v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.2 2 2 0 0 1 6 4z"/></svg>
              </span>
              <a href="tel:+914435949210">+91 44 3594 9210</a>
            </p>
            <p class="git-item__link">
              <span class="git-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/></svg>
              </span>
              <a href="tel:+919840603936">+91 98406 03936</a>
            </p>
          </div>

          <div class="git-item">
            <h3 class="git-item__title">E-mail us</h3>
            <p class="git-item__body">
              For proposals, claims and anything about your fleet.
            </p>
            <p class="git-item__link">
              <span class="git-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 6 9-6"/></svg>
              </span>
              <a href="mailto:info@medshield.in">info@medshield.in</a>
            </p>
            <p class="git-item__link">
              <span class="git-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 6 9-6"/></svg>
              </span>
              <a href="mailto:ds@medshield.in">ds@medshield.in</a>
            </p>
          </div>

          <div class="git-item">
            <h3 class="git-item__title">Visit us</h3>
            <p class="git-item__body">
              Headquarters in Chennai, with regional offices in Singapore and the UAE.
            </p>
            <p class="git-item__link">
              <span class="git-item__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              </span>
              <span class="confirm">[CONFIRM: street address]</span>
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- 4. FAQ -->
  <section class="faq" aria-labelledby="faq-h">
    <div class="shell faq__inner">
      <div class="faq__head">
        <p class="eyebrow">FAQ</p>
        <h2 class="faq__title" id="faq-h">Frequently asked questions.</h2>
      </div>

      <div class="faq__list">
        <div class="faq__intro">
          <h3 class="faq__introtitle">How fast do you respond?</h3>
          <p class="faq__introbody">
            A case manager replies to every proposal request within one business
            day. For a medical emergency at sea, do not use the form -
            call <span class="confirm">[CONFIRM: 24/7 number]</span>, answered
            by a coordinator at any hour.
          </p>
        </div>

        <details class="faq__item">
          <summary>Do you cover vessels outside India, Singapore and the UAE?</summary>
          <div class="faq__answer"><p><span class="confirm">[CONFIRM: answer]</span></p></div>
        </details>

        <details class="faq__item">
          <summary>Can you take over claims that are already in progress?</summary>
          <div class="faq__answer"><p><span class="confirm">[CONFIRM: answer]</span></p></div>
        </details>

        <details class="faq__item">
          <summary>What does an annual medical welfare budget include?</summary>
          <div class="faq__answer"><p><span class="confirm">[CONFIRM: answer]</span></p></div>
        </details>

        <details class="faq__item">
          <summary>How is telemedicine delivered to a vessel at sea?</summary>
          <div class="faq__answer"><p><span class="confirm">[CONFIRM: answer]</span></p></div>
        </details>
      </div>
    </div>
  </section>

</main>

