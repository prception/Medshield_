          <p class="site-footer__pending">
            Privacy Policy and Terms of Service pending - not linked until the
            pages exist.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script src="js/nav.js" defer></script>
<script>
(function () {
  'use strict';
  var form    = document.getElementById('proposal-form');
  var success = document.getElementById('form-success');
  if (!form || !success) return;

  var MESSAGES = {
    name:    'Enter your name',
    company: 'Enter your company name',
    email:   'Enter a work email address',
    topic:   'Choose what you are interested in',
    fleet:   'Choose a fleet size'
  };

  function errorNode(field) { return document.getElementById('e-' + field); }

  function showError(input, message) {
    var node = errorNode(input.name);
    input.setAttribute('aria-invalid', 'true');
    if (node) { node.textContent = message; node.hidden = false; }
  }

  function clearError(input) {
    var node = errorNode(input.name);
    input.removeAttribute('aria-invalid');
    if (node) { node.textContent = ''; node.hidden = true; }
  }

  function validate(input) {
    var value = (input.value || '').trim();
    if (!value) return MESSAGES[input.name] || 'This field is required';
    if (input.name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
      return MESSAGES.email;
    }
    return null;
  }

  var required = Array.prototype.slice.call(form.querySelectorAll('[required]'));

  required.forEach(function (input) {
    input.addEventListener('blur', function () {
      var message = validate(input);
      if (message) { showError(input, message); } else { clearError(input); }
    });
    input.addEventListener('input',  function () { clearError(input); });
    input.addEventListener('change', function () { clearError(input); });
  });

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var firstBad = null;

    required.forEach(function (input) {
      var message = validate(input);
      if (message) {
        showError(input, message);
        if (!firstBad) firstBad = input;
      } else {
        clearError(input);
      }
    });

    if (firstBad) { firstBad.focus(); return; }

    var trap = form.querySelector('[name="role"]');
    var isBot = trap && trap.value !== '';

    if (!isBot) {
      // TODO: wire to endpoint - POST new FormData(form) to the MedShield inbox / CRM.
    }

    form.hidden = true;
    success.hidden = false;
    success.focus();
  });
})();
</script>
</body>
</html>
